---
import Layout from '../layouts/Layout.astro'
import EventExplorer from '../components/EventExplorer.astro'
import { getPublishedEvents } from '../lib/events'

const events = await getPublishedEvents()

---

<Layout
  hideNavOnMobile
  title="Seekigo（シーキゴ）- 今日は、どこ行く？"
  description="東京のイベント・お祭り・展示・グルメ・お出かけ情報を今日・今週末・無料・家族で楽しむなど状況から探せるサービスです。"
>
  <main>

    <!-- ─── Hero ─── -->
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <picture>
          <source
            media="(min-width: 720px)"
            srcset="/images/top/hero_seekigo_pc.webp"
            type="image/webp"
          />
          <img
            class="hero__img"
            src="/images/top/hero_seekigo_sp.webp"
            alt=""
            width="1080"
            height="1350"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__inner inner">
        <div class="hero__copy">
          <p class="hero__eyebrow">
            <span class="hero__dot" aria-hidden="true"></span>
            東京のイベント・おでかけ情報
          </p>
          <h1 class="hero__headline">
            今日は、<br class="br-sp" />どこ行く？
          </h1>
          <p class="hero__sub">
            お祭り・展示・マルシェ・体験イベントを、<br />
            いまの気分から探せます。
          </p>
          <div class="hero-cta">
            <a class="hero-cta__primary" href="/?mood=today#events" data-mood-link="today">
              今日のイベントを見る
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v9.586l3.293-3.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-5-5a1 1 0 111.414-1.414L9 13.586V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
            </a>
            <p class="hero__stat">
              いま掲載中 <strong>{events.length}</strong> 件
            </p>
          </div>
        </div>
      </div>
    </section>

    <EventExplorer events={events} overlapHero />
  </main>
</Layout>

<style>
  /* ─── Hero ─── */
  .hero {
    position: relative;
    isolation: isolate;
    background: #EAF6FF;
    overflow: hidden;
    min-height: clamp(420px, 58vh, 560px);
    display: flex;
    align-items: center;
    padding: 56px 0 88px;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__media picture,
  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__img {
    object-fit: cover;
    object-position: 70% center;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(248, 250, 252, 0.96) 0%,
      rgba(248, 250, 252, 0.86) 36%,
      rgba(248, 250, 252, 0.2) 62%,
      rgba(248, 250, 252, 0) 100%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .hero__copy {
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .br-sp { display: none; }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 119, 200, 0.18);
    font-size: 13px;
    font-weight: 700;
    color: var(--c-primary);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-lime);
    box-shadow: 0 0 0 3px rgba(163, 230, 53, 0.3);
  }
  .hero__headline {
    font-size: clamp(36px, 5.6vw, 60px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--c-navy);
  }
  .hero__sub {
    font-size: clamp(15px, 1.6vw, 17px);
    color: #3B4A5C;
    line-height: 1.85;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 4px;
  }
  .hero-cta__primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 52px;
    padding: 0 26px;
    border-radius: 999px;
    background: var(--c-primary);
    color: #fff !important;
    font-size: 16px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(0, 119, 200, 0.28);
    transition: background 0.15s, transform 0.15s;
  }
  .hero-cta__primary svg { width: 18px; height: 18px; }
  .hero-cta__primary:hover {
    background: var(--c-primary-dk);
    transform: translateY(-1px);
  }
  .hero__stat {
    font-size: 14px;
    color: var(--c-muted);
  }
  .hero__stat strong {
    font-size: 18px;
    color: var(--c-navy);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 719px) {
    .hero {
      min-height: 0;
      align-items: flex-start;
      padding: 32px 0 76px;
    }
    .hero__img { object-position: center 80%; }
    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(248, 250, 252, 0.97) 0%,
        rgba(248, 250, 252, 0.9) 55%,
        rgba(248, 250, 252, 0.55) 100%
      );
    }
    .hero__copy { gap: 14px; }
    .br-sp { display: inline; }
    .br-pc { display: none; }
    .hero-cta__primary {
      width: 100%;
      justify-content: center;
      height: 50px;
      font-size: 15px;
    }
  }
</style>
