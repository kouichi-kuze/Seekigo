---
import Layout from '../layouts/Layout.astro'
import { getPublishedEvents } from '../lib/events'

const events = await getPublishedEvents()
---

<Layout title="Seekigo">
  <main>
    <h1>Seekigo</h1>
    <p>東京のイベント・お出かけ情報</p>

    <h2>Events</h2>

    {events?.map((event) => (
      <article>
        <h3>{event.title}</h3>
        <p>{event.start_date}</p>
        <p>{event.venue}</p>
        <p>{event.summary}</p>
      </article>
    ))}
  </main>
</Layout>
