---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getAreaEvents } from '../../../lib/events'

const events = await getAreaEvents('shinjuku')
---

<Layout
  title="新宿のイベント | Seekigo"
  description="新宿エリアで開催されるイベント・お祭り・展示・グルメ・お出かけ情報を紹介します。"
>
  <EventListPage
    breadcrumbCurrent="新宿"
    eyebrow="Shinjuku"
    headline="新宿のイベント"
    description="新宿エリアで開催されるイベントをまとめています。"
    countLabel="新宿のイベント"
    events={events}
    emptyMessage="現在掲載中の新宿エリアのイベントはありません。"
  />
</Layout>
