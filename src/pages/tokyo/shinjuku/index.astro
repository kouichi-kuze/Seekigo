---
import Layout from '../../../layouts/Layout.astro'
import { getAreaEvents } from '../../../lib/events'
import EventCard from '../../../components/EventCard.astro'

const events = await getAreaEvents('shinjuku')
---

<Layout
  title="新宿のイベント | Seekigo"
  description="新宿エリアで開催されるイベント・お祭り・展示・グルメ・お出かけ情報を紹介します。"
>
  <main>
    <p>
      <a href="/tokyo/">東京イベントTOP</a>
    </p>

    <header>
      <h1>新宿のイベント</h1>
    </header>

    <section>
      <h2>新宿エリアのイベント</h2>

      {events.length > 0 ? (
        <div>
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <p>現在掲載中の新宿エリアのイベントはありません。</p>
      )}
    </section>
  </main>
</Layout>
