---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getAreaEvents } from '../../../lib/events'

const events = await getAreaEvents('shibuya')
---

<Layout
  title="渋谷のイベント | Seekigo"
  description="渋谷エリアで開催されるイベント・お祭り・展示・グルメ・お出かけ情報を紹介します。"
>
  <EventListPage
    breadcrumbCurrent="渋谷"
    eyebrow="Shibuya"
    headline="渋谷のイベント"
    description="渋谷エリアで開催されるイベントをまとめています。"
    countLabel="渋谷のイベント"
    events={events}
    emptyMessage="現在掲載中の渋谷エリアのイベントはありません。"
  />
</Layout>
