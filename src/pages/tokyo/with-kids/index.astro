---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getKidsEvents } from '../../../lib/events'

const events = await getKidsEvents()
---

<Layout
  title="家族で楽しむ東京イベント | Seekigo"
  description="東京で開催される、家族で楽しむイベント・お祭り・展示・お出かけ情報を紹介します。"
>
  <EventListPage
    breadcrumbCurrent="家族で"
    eyebrow="With family"
    headline="家族で楽しむ東京イベント"
    description="家族で楽しめる、東京のイベントをまとめています。"
    countLabel="家族で楽しむイベント"
    events={events}
    emptyMessage="現在掲載中の、家族で楽しむイベントはありません。"
  />
</Layout>
