---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getKidsEvents } from '../../../lib/events'

const events = await getKidsEvents()
---

<Layout
  title="子どもと楽しめる東京イベント | Seekigo"
  description="東京で開催される子ども向けのイベント・お祭り・展示・お出かけ情報を紹介します。"
>
  <EventListPage
    breadcrumbCurrent="子どもと"
    eyebrow="With kids"
    headline="子どもと楽しめる東京イベント"
    description="家族や子どもと一緒に楽しめる、東京のイベントをまとめています。"
    countLabel="子ども向けイベント"
    events={events}
    emptyMessage="現在掲載中の子ども向けイベントはありません。"
  />
</Layout>
