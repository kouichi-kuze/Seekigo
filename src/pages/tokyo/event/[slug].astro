---
import Layout from '../../../layouts/Layout.astro'
import { supabase } from '../../../lib/supabase'
import { formatEventPlaceLine, isEventEnded } from '../../../lib/display'
import {
  buildEventDetailChips,
  fetchEventOccurrences,
  formatEventTimeRangeJa,
  formatScheduleDates,
  formatTimedOccurrenceSchedule,
  mergeOccurrenceSpans,
  resolveDisplaySpans,
  resolveScheduleStatus,
  useParentTimeFallback,
} from '../../../lib/event-schedule'
import { selectRelatedEvents } from '../../../lib/event-related'
import { loadScheduledPublishedEvents } from '../../../lib/events'
import RelatedEvents from '../../../components/RelatedEvents.astro'
import { resolveEventDisplayImage } from '../../../lib/event-image-usage'
import EventReactionSummary from '../../../components/EventReactionSummary.astro'
import EventVisitChecklist from '../../../components/EventVisitChecklist.astro'
import EventAccess from '../../../components/EventAccess.astro'
import { fetchPublishedReactionSummary } from '../../../lib/event-reaction-summary'
import {
  formatAdmissionLabel,
  formatAdmissionNote,
  formatAgeNote,
  formatDurationLabel,
  formatReservationLabel,
} from '../../../lib/event-visit-display'
import { getLocalizedEventPath } from '../../../lib/i18n/locale'
import {
  absoluteSiteUrl,
  buildEventJsonLd,
  buildJaEventDescription,
} from '../../../lib/event-page-seo'

export async function getStaticPaths() {
  const { data: events } = await supabase
    .from('events')
    .select('slug')
    .eq('status', 'published')
    .not('slug', 'is', null)

  return (events ?? []).map((event) => ({
    params: { slug: event.slug as string },
  }))
}

const { slug } = Astro.params

const { data: event } = await supabase
  .from('events')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .single()

const occurrenceRows = event?.id
  ? await fetchEventOccurrences(supabase, Number(event.id))
  : null
const occurrenceSpans =
  occurrenceRows && occurrenceRows.length > 0
    ? mergeOccurrenceSpans(occurrenceRows)
    : []
const timedSchedule =
  occurrenceRows && occurrenceRows.length > 0
    ? formatTimedOccurrenceSchedule(occurrenceRows, 'ja')
    : null
const dateLabel =
  timedSchedule ??
  formatScheduleDates(occurrenceSpans, {
    start_date: event?.start_date,
    end_date: event?.end_date,
  }, 'ja')
const scheduleStatus = resolveScheduleStatus(occurrenceSpans, {
  start_date: event?.start_date,
  end_date: event?.end_date,
})
const placeLabel = formatEventPlaceLine(event?.municipality, event?.area)
const headerChips = buildEventDetailChips({
  locale: 'ja',
  status: scheduleStatus,
  priceType: event?.price_type,
  isKids: event?.is_kids,
  isIndoor: event?.is_indoor,
  isNight: event?.is_night,
})
const displayImage = event ? resolveEventDisplayImage(event) : null
const imageCredit =
  displayImage?.kind === 'external' && event?.image_credit
    ? String(event.image_credit).trim() || null
    : null
const isEnded = event ? isEventEnded(event.start_date, event.end_date) : false

const timeLabel =
  event && useParentTimeFallback(occurrenceRows)
    ? formatEventTimeRangeJa(event.start_time, event.end_time)
    : null

const admissionLabel = event ? formatAdmissionLabel(event) : null
const admissionNote = event ? formatAdmissionNote(event) : null
const reservationLabel = event
  ? formatReservationLabel(event.reservation_status)
  : null
const reservationUrl = event?.reservation_url?.trim() || null
const ageNote = event ? formatAgeNote(event.age_note) : null
const durationLabel = event
  ? formatDurationLabel(
      event.duration_minutes_min,
      event.duration_minutes_max,
    )
  : null

const hasBasicInfo = Boolean(
  event &&
    (dateLabel ||
      timeLabel ||
      event.venue ||
      event.address ||
      admissionLabel ||
      admissionNote ||
      reservationLabel ||
      reservationUrl ||
      ageNote ||
      durationLabel),
)

const sourceSpans = resolveDisplaySpans(occurrenceSpans, {
  start_date: event?.start_date,
  end_date: event?.end_date,
})
const relatedEvents = event
  ? selectRelatedEvents(
      {
        id: event.id,
        area: event.area,
        municipality: event.municipality,
        category: event.category,
        schedule_spans: sourceSpans,
      },
      await loadScheduledPublishedEvents(),
    )
  : []
const relatedHeading =
  scheduleStatus === 'ended'
    ? 'こちらのイベントもチェック'
    : 'このイベントとあわせてチェック'

const reactionSummary = event
  ? await fetchPublishedReactionSummary(supabase, Number(event.id))
  : null

const jaPath = event?.slug
  ? getLocalizedEventPath(String(event.slug), 'ja')
  : null
const enPath = event?.slug
  ? getLocalizedEventPath(String(event.slug), 'en')
  : null
const hreflangAlternates =
  jaPath && enPath
    ? [
        { lang: 'ja', path: jaPath },
        { lang: 'en', path: enPath },
        { lang: 'x-default', path: jaPath },
      ]
    : []

const pageUrl = jaPath ? absoluteSiteUrl(jaPath, Astro.site) : null
const shareImage = displayImage?.src
  ? absoluteSiteUrl(displayImage.src, Astro.site)
  : null
const metaDescription = event
  ? buildJaEventDescription({
      title: event.title,
      summary: event.summary,
      place: placeLabel,
      dateLabel,
    })
  : '東京のイベント・お出かけ情報はSeekigo。'
const jsonLd =
  event && pageUrl
    ? buildEventJsonLd({
        name: event.title,
        description: metaDescription,
        url: pageUrl,
        image: shareImage,
        venue: event.venue,
        address: event.address,
        occurrenceSpans,
        parent: { start_date: event.start_date, end_date: event.end_date },
        parentStartTime: event.start_time,
        parentEndTime: event.end_time,
        occurrences: occurrenceRows,
        priceType: event.price_type,
        priceMin: event.price_min,
        priceMax: event.price_max,
        officialUrl: event.official_url,
      })
    : null
---

<Layout
  title={event ? `${event.title} | Seekigo` : 'Seekigo'}
  description={metaDescription}
  ogImage={shareImage ?? undefined}
  ogImageAlt={event?.title}
  jsonLd={jsonLd ?? undefined}
  locale="ja"
  hreflangAlternates={hreflangAlternates}
  eventLanguageSwitcher={
    event?.slug
      ? { slug: String(event.slug), enPageAvailable: true }
      : undefined
  }
>
  {event ? (
    <main class="event-page">
      <article class="event-article">
        <nav class="breadcrumb" aria-label="パンくず">
          <a href="/tokyo/">東京のイベント</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <span class="breadcrumb__current" aria-current="page">{event.title}</span>
        </nav>

        <header class="event-header">
          {headerChips.length > 0 && (
            <div class="event-tags">
              {headerChips.map((chip) => (
                <span
                  class:list={[
                    'tag',
                    chip.id === 'status' && scheduleStatus === 'ended' && 'tag--ended',
                    chip.id === 'status' && scheduleStatus === 'today' && 'tag--today',
                  ]}
                >
                  {chip.label}
                </span>
              ))}
            </div>
          )}
          {placeLabel && <p class="event-area">{placeLabel}</p>}
          <h1 class="event-title">{event.title}</h1>
        </header>

        {displayImage && (
          <div class="event-image">
            <img
              src={displayImage.src}
              alt={event.title}
              loading="eager"
              decoding="async"
              class:list={[
                displayImage.kind !== 'external' && 'event-image__img--fallback',
                isEnded && 'event-image__img--ended',
              ]}
            />
            {isEnded && (
              <div class="event-image__ended" aria-hidden="true">
                <span class="event-image__ended-label">開催終了</span>
              </div>
            )}
            {displayImage.kind === 'generated' && (
              <span class="event-image__concept">イメージ</span>
            )}
            {imageCredit && <p class="event-image__credit">{imageCredit}</p>}
          </div>
        )}

        {hasBasicInfo && (
          <section class="event-basics" aria-labelledby="event-basics-heading">
            <h2 id="event-basics-heading" class="event-section-heading">
              基本情報
            </h2>
            <dl class="event-meta">
              {dateLabel && (
                <div class="event-meta__row">
                  <dt>開催日</dt>
                  <dd>{dateLabel}</dd>
                </div>
              )}
              {timeLabel && (
                <div class="event-meta__row">
                  <dt>開催時間</dt>
                  <dd>{timeLabel}</dd>
                </div>
              )}
              {event.venue && (
                <div class="event-meta__row">
                  <dt>会場</dt>
                  <dd>{event.venue}</dd>
                </div>
              )}
              {event.address && (
                <div class="event-meta__row">
                  <dt>住所</dt>
                  <dd>{event.address}</dd>
                </div>
              )}
              {(admissionLabel || admissionNote) && (
                <div class="event-meta__row">
                  <dt>料金</dt>
                  <dd>
                    {admissionLabel && <span>{admissionLabel}</span>}
                    {admissionNote && (
                      <span class="event-meta__note">{admissionNote}</span>
                    )}
                  </dd>
                </div>
              )}
              {(reservationLabel || reservationUrl) && (
                <div class="event-meta__row">
                  <dt>予約</dt>
                  <dd class="event-meta__reservation">
                    {reservationLabel && <span>{reservationLabel}</span>}
                    {reservationUrl && (
                      <a
                        href={reservationUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        予約ページを見る
                      </a>
                    )}
                  </dd>
                </div>
              )}
              {ageNote && (
                <div class="event-meta__row">
                  <dt>年齢・対象</dt>
                  <dd>{ageNote}</dd>
                </div>
              )}
              {durationLabel && (
                <div class="event-meta__row">
                  <dt>所要時間</dt>
                  <dd>{durationLabel}</dd>
                </div>
              )}
            </dl>
          </section>
        )}

        {event.summary && (
          <section class="event-body">
            <h2 class="event-section-heading">イベント概要</h2>
            <p class="event-body__text">{event.summary}</p>
          </section>
        )}

        <EventVisitChecklist event={event} />

        <EventAccess event={event} />

        {reactionSummary && <EventReactionSummary summary={reactionSummary} />}

        {event.official_url && (
          <div class="event-cta">
            <a
              href={event.official_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              公式サイトで詳細を見る →
            </a>
          </div>
        )}

        {event.source_url && (
          <p class="event-source">
            情報元:{' '}
            <a
              href={event.source_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {event.source_url}
            </a>
          </p>
        )}

        <section class="organizer-note" aria-labelledby="organizer-note-heading">
          <h2 id="organizer-note-heading" class="organizer-note__heading">
            イベント主催者・関係者の皆さまへ
          </h2>
          <p class="organizer-note__text">
            Seekigoでは、公開情報をもとにイベント情報をご紹介しています。
            掲載内容の確認、公式画像のご提供、情報の追加・変更、
            今後のイベント掲載についてご希望がございましたら、
            お気軽にご連絡ください。
            ご提供いただいた情報は内容を確認のうえ、掲載に反映いたします。
          </p>
          <p class="organizer-note__cta">
            <a
              class="organizer-note__link"
              href={`/contact/event-info/?event=${encodeURIComponent(`/tokyo/event/${event.slug}/`)}`}
            >
              掲載・情報提供について連絡する
            </a>
          </p>
        </section>

        <RelatedEvents heading={relatedHeading} events={relatedEvents} />

        <p class="back-link">
          <a href="/tokyo/">← 東京のイベント一覧に戻る</a>
        </p>
      </article>
    </main>
  ) : (
    <main class="event-page">
      <div class="event-article">
        <p class="not-found">イベントが見つかりませんでした。</p>
        <p class="back-link">
          <a href="/tokyo/">← 東京のイベント一覧に戻る</a>
        </p>
      </div>
    </main>
  )}
</Layout>

<style>
  .event-page {
    padding-bottom: 80px;
  }

  .event-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px var(--px) 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .breadcrumb {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .breadcrumb a {
    color: var(--c-muted);
  }
  .breadcrumb a:hover {
    color: var(--c-primary);
    text-decoration: underline;
  }
  .breadcrumb__sep {
    color: var(--c-border);
  }
  .breadcrumb__current {
    color: var(--c-muted);
    overflow-wrap: anywhere;
  }

  .event-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    background: var(--c-accent);
    color: var(--c-text);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    letter-spacing: 0.02em;
  }
  .tag--today {
    background: var(--c-primary);
    color: var(--c-white);
  }
  .tag--ended {
    background: #e5e7eb;
    color: #4b5563;
  }
  .event-area {
    font-size: 13px;
    font-weight: 700;
    color: var(--c-primary);
    letter-spacing: 0.02em;
  }
  .event-title {
    font-size: clamp(22px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.4px;
    line-height: 1.3;
    color: var(--c-text);
    overflow-wrap: anywhere;
  }

  .event-image {
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--c-border);
    position: relative;
  }
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .event-image__img--fallback {
    background: var(--c-border);
  }
  .event-image__img--ended {
    filter: grayscale(0.35) brightness(0.85);
  }
  .event-image__ended {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 24, 39, 0.42);
    pointer-events: none;
  }
  .event-image__concept {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    padding: 3px 8px;
    border-radius: var(--r-sm);
    background: rgba(17, 24, 39, 0.62);
  }
  .event-image__ended-label {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #fff;
    padding: 10px 20px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: var(--r-sm);
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(2px);
  }
  .event-image__credit {
    margin: 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    color: var(--c-muted, #666);
    background: #f7f7f7;
  }

  .event-basics {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .event-section-heading {
    font-size: 16px;
    font-weight: 700;
    color: var(--c-text);
    padding-bottom: 8px;
    border-bottom: 2px solid var(--c-primary);
    align-self: flex-start;
  }

  .event-meta {
    margin: 0;
    border-top: 1px solid var(--c-border);
  }
  .event-meta__row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-border);
    align-items: start;
  }
  .event-meta__row dt {
    font-size: 13px;
    font-weight: 600;
    color: var(--c-muted);
  }
  .event-meta__row dd {
    margin: 0;
    font-size: 14px;
    color: var(--c-text);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .event-meta__note {
    display: block;
    margin-top: 4px;
    color: var(--c-muted);
    font-size: 14px;
    line-height: 1.5;
  }
  }
  .event-meta__reservation {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .event-meta__reservation a {
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .event-meta__reservation a:hover {
    color: var(--c-primary-dk);
  }

  .event-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .event-body__text {
    font-size: 15px;
    line-height: 1.85;
    color: var(--c-text);
    white-space: pre-wrap;
  }

  .event-cta {
    padding-top: 4px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: var(--c-primary);
    color: var(--c-white) !important;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: var(--r-lg);
    text-align: center;
    transition: background 0.15s;
  }
  .btn-primary:hover {
    background: var(--c-primary-dk);
  }

  .event-source {
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.5;
    overflow-wrap: anywhere;
    margin-top: -8px;
  }
  .event-source a {
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .event-source a:hover {
    color: var(--c-primary);
  }

  .organizer-note {
    margin-top: 8px;
    padding: 22px 20px;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-white);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .organizer-note__heading {
    font-size: 15px;
    font-weight: 700;
    color: var(--c-text);
  }
  .organizer-note__text {
    font-size: 13px;
    line-height: 1.8;
    color: var(--c-muted);
  }
  .organizer-note__cta {
    margin: 0;
  }
  .organizer-note__link {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .organizer-note__link:hover {
    color: var(--c-primary-dk);
  }

  .back-link {
    font-size: 14px;
    padding-top: 8px;
  }
  .back-link a {
    color: var(--c-muted);
  }
  .back-link a:hover {
    color: var(--c-text);
  }

  .not-found {
    color: var(--c-muted);
  }

  @media (min-width: 640px) {
    .btn-primary {
      width: auto;
      min-width: 280px;
    }
  }
</style>
