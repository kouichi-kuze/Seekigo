---
import Layout from '../../../layouts/Layout.astro'
import { supabase } from '../../../lib/supabase'
import { formatAreaLabel, formatEventDateRange, isEventEnded } from '../../../lib/display'
import { resolveEventDisplayImage } from '../../../lib/event-image-usage'

export async function getStaticPaths() {
  const { data: events } = await supabase
    .from('events')
    .select('slug')
    .eq('status', 'published')
    .not('slug', 'is', null)

  return (events ?? []).map((event) => ({
    params: { slug: event.slug as string },
  }))
}

const { slug } = Astro.params

const { data: event } = await supabase
  .from('events')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .single()

const dateLabel = formatEventDateRange(event?.start_date, event?.end_date)
const areaLabel = formatAreaLabel(event?.area)
const displayImage = event ? resolveEventDisplayImage(event) : null
const imageCredit =
  displayImage?.kind === 'external' && event?.image_credit
    ? String(event.image_credit).trim() || null
    : null
const isEnded = event ? isEventEnded(event.start_date, event.end_date) : false

const timeLabel = (() => {
  if (!event) return null
  const start = event.start_time?.trim() || null
  const end = event.end_time?.trim() || null
  if (!start && !end) return null
  if (start && end) return `${start} 〜 ${end}`
  return start ?? end
})()

const hasTags = Boolean(
  event && (event.is_free || event.is_kids || event.is_indoor || event.is_night),
)

const hasMeta = Boolean(
  event &&
    (dateLabel ||
      timeLabel ||
      event.venue ||
      areaLabel ||
      event.address ||
      event.price_text),
)
---

<Layout
  title={event ? `${event.title} | Seekigo` : 'Seekigo'}
  description={
    event?.summary ??
    `${event?.title ?? ''}の詳細情報。東京のイベント・お出かけ情報はSeekigoで。`
  }
>
  {event ? (
    <main class="event-page">
      <article class="event-article">
        <nav class="breadcrumb" aria-label="パンくず">
          <a href="/tokyo/">東京のイベント</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <span class="breadcrumb__current" aria-current="page">{event.title}</span>
        </nav>

        <header class="event-header">
          {hasTags && (
            <div class="event-tags">
              {event.is_free && <span class="tag">無料</span>}
              {event.is_kids && <span class="tag">子ども向け</span>}
              {event.is_indoor && <span class="tag">屋内</span>}
              {event.is_night && <span class="tag">夜</span>}
            </div>
          )}
          {areaLabel && <p class="event-area">{areaLabel}</p>}
          <h1 class="event-title">{event.title}</h1>
        </header>

        {displayImage && (
          <div class="event-image">
            <img
              src={displayImage.src}
              alt={event.title}
              loading="eager"
              decoding="async"
              class:list={[
                displayImage.kind !== 'external' && 'event-image__img--fallback',
                isEnded && 'event-image__img--ended',
              ]}
            />
            {isEnded && (
              <div class="event-image__ended" aria-hidden="true">
                <span class="event-image__ended-label">開催終了</span>
              </div>
            )}
            {imageCredit && <p class="event-image__credit">{imageCredit}</p>}
          </div>
        )}

        {hasMeta && (
          <dl class="event-meta">
            {dateLabel && (
              <div class="event-meta__row">
                <dt>開催日</dt>
                <dd>{dateLabel}</dd>
              </div>
            )}
            {timeLabel && (
              <div class="event-meta__row">
                <dt>時間</dt>
                <dd>{timeLabel}</dd>
              </div>
            )}
            {event.venue && (
              <div class="event-meta__row">
                <dt>会場</dt>
                <dd>{event.venue}</dd>
              </div>
            )}
            {areaLabel && (
              <div class="event-meta__row">
                <dt>エリア</dt>
                <dd>{areaLabel}</dd>
              </div>
            )}
            {event.address && (
              <div class="event-meta__row">
                <dt>住所</dt>
                <dd>{event.address}</dd>
              </div>
            )}
            {event.price_text && (
              <div class="event-meta__row">
                <dt>料金</dt>
                <dd>{event.price_text}</dd>
              </div>
            )}
          </dl>
        )}

        {event.summary && (
          <section class="event-body">
            <h2 class="event-body__heading">イベント概要</h2>
            <p class="event-body__text">{event.summary}</p>
          </section>
        )}

        {event.official_url && (
          <div class="event-cta">
            <a
              href={event.official_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              公式サイトで詳細を見る →
            </a>
          </div>
        )}

        {event.source_url && (
          <p class="event-source">
            情報元:{' '}
            <a
              href={event.source_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {event.source_url}
            </a>
          </p>
        )}

        <section class="organizer-note" aria-labelledby="organizer-note-heading">
          <h2 id="organizer-note-heading" class="organizer-note__heading">
            イベント主催者・関係者の皆さまへ
          </h2>
          <p class="organizer-note__text">
            Seekigoでは、公開情報をもとにイベント情報をご紹介しています。
            掲載内容の確認、公式画像のご提供、情報の追加・変更、
            今後のイベント掲載についてご希望がございましたら、
            お気軽にご連絡ください。
            ご提供いただいた情報は内容を確認のうえ、掲載に反映いたします。
          </p>
          <p class="organizer-note__cta">
            <a
              class="organizer-note__link"
              href={`/contact/event-info/?event=${encodeURIComponent(`/tokyo/event/${event.slug}/`)}`}
            >
              掲載・情報提供について連絡する
            </a>
          </p>
        </section>

        <p class="back-link">
          <a href="/tokyo/">← 東京のイベント一覧に戻る</a>
        </p>
      </article>
    </main>
  ) : (
    <main class="event-page">
      <div class="event-article">
        <p class="not-found">イベントが見つかりませんでした。</p>
        <p class="back-link">
          <a href="/tokyo/">← 東京のイベント一覧に戻る</a>
        </p>
      </div>
    </main>
  )}
</Layout>

<style>
  .event-page {
    padding-bottom: 80px;
  }

  .event-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px var(--px) 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Breadcrumb — 控えめ */
  .breadcrumb {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .breadcrumb a {
    color: var(--c-muted);
  }
  .breadcrumb a:hover {
    color: var(--c-primary);
    text-decoration: underline;
  }
  .breadcrumb__sep {
    color: var(--c-border);
  }
  .breadcrumb__current {
    color: var(--c-muted);
    overflow-wrap: anywhere;
  }

  /* Header */
  .event-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    background: var(--c-accent);
    color: var(--c-text);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    letter-spacing: 0.02em;
  }
  .event-area {
    font-size: 13px;
    font-weight: 700;
    color: var(--c-primary);
    letter-spacing: 0.02em;
  }
  .event-title {
    font-size: clamp(22px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.4px;
    line-height: 1.3;
    color: var(--c-text);
    overflow-wrap: anywhere;
  }

  /* Image */
  .event-image {
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--c-border);
    position: relative;
  }
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .event-image__img--fallback {
    background: var(--c-border);
  }
  .event-image__img--ended {
    filter: grayscale(0.35) brightness(0.85);
  }
  .event-image__ended {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 24, 39, 0.42);
    pointer-events: none;
  }
  .event-image__ended-label {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #fff;
    padding: 10px 20px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: var(--r-sm);
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(2px);
  }
  .event-image__credit {
    margin: 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    color: var(--c-muted, #666);
    background: #f7f7f7;
  }

  /* Meta — 軽い区切り（強い表にしない） */
  .event-meta {
    margin: 0;
    border-top: 1px solid var(--c-border);
  }
  .event-meta__row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-border);
    align-items: start;
  }
  .event-meta__row dt {
    font-size: 13px;
    font-weight: 600;
    color: var(--c-muted);
  }
  .event-meta__row dd {
    margin: 0;
    font-size: 14px;
    color: var(--c-text);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  /* 概要 */
  .event-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .event-body__heading {
    font-size: 16px;
    font-weight: 700;
    color: var(--c-text);
    padding-bottom: 8px;
    border-bottom: 2px solid var(--c-primary);
    align-self: flex-start;
  }
  .event-body__text {
    font-size: 15px;
    line-height: 1.85;
    color: var(--c-text);
    white-space: pre-wrap;
  }

  /* 主要 CTA */
  .event-cta {
    padding-top: 4px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: var(--c-primary);
    color: var(--c-white) !important;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: var(--r-lg);
    text-align: center;
    transition: background 0.15s;
  }
  .btn-primary:hover {
    background: var(--c-primary-dk);
  }

  /* 情報元 — 補助的 */
  .event-source {
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.5;
    overflow-wrap: anywhere;
    margin-top: -8px;
  }
  .event-source a {
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .event-source a:hover {
    color: var(--c-primary);
  }

  /* 主催者・関係者向け案内 */
  .organizer-note {
    margin-top: 8px;
    padding: 22px 20px;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-white);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .organizer-note__heading {
    font-size: 15px;
    font-weight: 700;
    color: var(--c-text);
  }
  .organizer-note__text {
    font-size: 13px;
    line-height: 1.8;
    color: var(--c-muted);
  }
  .organizer-note__cta {
    margin: 0;
  }
  .organizer-note__link {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .organizer-note__link:hover {
    color: var(--c-primary-dk);
  }

  .back-link {
    font-size: 14px;
    padding-top: 8px;
  }
  .back-link a {
    color: var(--c-muted);
  }
  .back-link a:hover {
    color: var(--c-text);
  }

  .not-found {
    color: var(--c-muted);
  }

  @media (min-width: 640px) {
    .btn-primary {
      width: auto;
      min-width: 280px;
    }
  }
</style>
