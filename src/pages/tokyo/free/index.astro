---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getFreeEvents } from '../../../lib/events'

const events = await getFreeEvents()
---

<Layout
  title="東京の無料イベント | Seekigo"
  description="東京で開催される無料のイベント・お祭り・展示・お出かけ情報を紹介します。"
>
  <EventListPage
    breadcrumbCurrent="無料"
    eyebrow="Free"
    headline="東京の無料イベント"
    description="入場や参加が無料で楽しめる、東京のイベントをまとめています。"
    countLabel="無料イベント"
    events={events}
    emptyMessage="現在掲載中の無料イベントはありません。"
  />
</Layout>
