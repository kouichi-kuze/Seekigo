---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getFreeEvents } from '../../../lib/events'

const events = await getFreeEvents()
---

<Layout
  title="東京の無料イベント | Seekigo"
  description="東京で、主な入場や観覧が無料のイベントと、一部だけ有料のイベントを紹介します。"
>
  <EventListPage
    breadcrumbCurrent="無料"
    eyebrow="Free"
    headline="東京の無料イベント"
    description="主な入場や観覧が無料のイベントと、一部だけ有料のイベントをまとめています。"
    countLabel="無料イベント"
    events={events}
    emptyMessage="現在掲載中の無料イベントはありません。"
  />
</Layout>
