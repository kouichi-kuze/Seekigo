---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getTodayEvents } from '../../../lib/events'

const { today, events } = await getTodayEvents()

const todayLabel = new Date().toLocaleDateString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'short',
})
---

<Layout
  title={`今日の東京イベント（${today}）| Seekigo`}
  description={`${todayLabel}に東京で開催されるイベント・お祭り・展示・グルメ・お出かけ情報を紹介します。`}
>
  <EventListPage
    breadcrumbCurrent="今日"
    eyebrow="Today"
    headline="今日の東京イベント"
    description={`${todayLabel}に開催中のイベントです。`}
    countLabel="今日のイベント"
    events={events}
    emptyMessage="今日開催のイベントは現在ありません。"
    emptyLinks={[
      { href: '/tokyo/', label: '東京のイベント一覧へ' },
      { href: '/tokyo/this-weekend/', label: '今週末のイベント' },
    ]}
  />
</Layout>
