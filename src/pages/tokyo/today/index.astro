---
import Layout from '../../../layouts/Layout.astro'
import { getTodayEvents } from '../../../lib/events'
import EventCard from '../../../components/EventCard.astro'

const { today, events } = await getTodayEvents()
---

<Layout
  title="東京の今日のイベント | Seekigo"
  description="東京で今日開催されるイベント・お祭り・展示・グルメ・お出かけ情報を紹介します。"
>
  <main>
    <p>
      <a href="/tokyo/">東京イベントTOP</a>
    </p>

    <header>
      <h1>東京の今日のイベント</h1>
      <p>{today}</p>
    </header>

    <section>
      <h2>今日のイベント</h2>

      {events && events.length > 0 ? (
        <div>
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <p>現在掲載中のイベントはありません。</p>
      )}
    </section>
  </main>
</Layout>
