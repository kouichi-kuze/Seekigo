---
import Layout from '../../layouts/Layout.astro'
import EventExplorer from '../../components/EventExplorer.astro'
import { getPublishedEvents } from '../../lib/events'

const events = await getPublishedEvents()
---

<Layout
  hideNavOnMobile
  title="東京のイベント | Seekigo"
  description="東京で開催されるイベント・お祭り・展示・グルメ・お出かけ情報を紹介します。今日・今週末・無料・子ども向けなど状況から探せます。"
>
  <main>

    <section class="page-head">
      <div class="inner">
        <nav class="breadcrumb" aria-label="パンくず">
          <a href="/">ホーム</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">東京のイベント</span>
        </nav>
        <h1 class="page-head__title">東京のイベント</h1>
        <p class="page-head__sub">
          開催中・開催予定のイベントを、いまの気分で絞り込めます。
        </p>
      </div>
    </section>

    <EventExplorer events={events} />
  </main>
</Layout>

<style>
  .page-head {
    background: var(--c-white);
    border-bottom: 1px solid var(--c-border);
    padding: 32px 0 28px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    font-size: 12px;
    color: var(--c-muted);
    margin-bottom: 12px;
  }
  .breadcrumb a { color: var(--c-muted); }
  .breadcrumb a:hover { color: var(--c-primary); text-decoration: underline; }
  .page-head__title {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--c-text);
  }
  .page-head__sub {
    margin-top: 8px;
    font-size: 15px;
    color: var(--c-muted);
  }
</style>
