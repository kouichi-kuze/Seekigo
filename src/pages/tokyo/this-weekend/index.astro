---
import Layout from '../../../layouts/Layout.astro'
import EventListPage from '../../../components/EventListPage.astro'
import { getThisWeekendEvents } from '../../../lib/events'

const { saturday, sunday, events } = await getThisWeekendEvents()

const rangeLabel = `${saturday} 〜 ${sunday}`
---

<Layout
  title="今週末の東京イベント | Seekigo"
  description="今週末に東京で開催されるイベント・お祭り・展示・グルメ・子ども向けのお出かけ情報を紹介します。"
>
  <EventListPage
    breadcrumbCurrent="今週末"
    eyebrow="This weekend"
    headline="今週末の東京イベント"
    description={`今週末（${rangeLabel}）に開催されるイベントです。`}
    countLabel="今週末のイベント"
    events={events}
    emptyMessage="今週末に開催予定の掲載イベントはありません。"
    emptyLinks={[
      { href: '/tokyo/', label: '東京のイベント一覧へ' },
      { href: '/tokyo/today/', label: '今日のイベント' },
    ]}
  />
</Layout>
