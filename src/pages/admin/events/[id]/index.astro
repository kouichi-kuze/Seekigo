---
import AdminLayout from '../../../../layouts/AdminLayout.astro'
import AdminFieldLabel from '../../../../components/admin/AdminFieldLabel.astro'
import FieldReviewCards from '../../../../components/admin/FieldReviewCards.astro'
import { adminDevNotFoundResponse } from '../../../../lib/admin/dev-guard'
import { getOrCreateAdminCsrfToken } from '../../../../lib/admin-security'
import { ADMIN_EVENT_SELECT, type AdminEvent } from '../../../../lib/admin/types'
import { fetchAdminFieldReviews } from '../../../../lib/admin/field-reviews'
import {
  ADMIN_ENUM_UNSET_LABEL,
  FRIENDLY_VALUE_LABELS,
  IMAGE_USAGE_STATUS_LABELS,
  IS_NIGHT_LABELS,
  PRICE_TYPE_LABELS,
  PARKING_STATUS_LABELS,
  RESERVATION_STATUS_LABELS,
  VENUE_TYPE_LABELS,
} from '../../../../lib/admin/field-labels'
import { IMAGE_USAGE_STATUSES } from '../../../../lib/event-image-usage'
import { isBodyProtectedFromSync } from '../../../../lib/event-status'
import {
  FRIENDLY_VALUES,
  PARKING_STATUSES,
  PRICE_TYPES,
  RESERVATION_STATUSES,
  VENUE_TYPES,
} from '../../../../lib/event-visit-attrs'
import { getAdminEventEditStaticPaths } from '../../../../lib/admin/event-edit-paths'
import {
  getAdminEventScheduleGroup,
  type AdminEventScheduleGroup,
} from '../../../../lib/admin/event-sort'
import {
  bulletsToTextarea,
  mapSummaryRow,
  type EventReactionSourceRow,
  type EventReactionSummaryRow,
} from '../../../../lib/event-reaction-summary'
import { classifyBulletTheme } from '../../../../lib/reaction-summary-quality'
import {
  fetchAdminEventTranslation,
  fetchAdminReactionTranslation,
} from '../../../../lib/admin-event-translate'
import type {
  EventTranslationRow,
  ReactionSummaryTranslationRow,
} from '../../../../lib/event-translations'

/** 本番 SSG では admin 編集ページを生成しない。DEV では Supabase から id 一覧を取得。 */
export async function getStaticPaths() {
  return getAdminEventEditStaticPaths()
}

if (!import.meta.env.DEV) {
  return adminDevNotFoundResponse()
}

const { id: idParam } = Astro.params
const eventId = Number(idParam)
if (!Number.isFinite(eventId) || eventId <= 0) {
  return adminDevNotFoundResponse()
}

const { createAdminClient } = await import('../../../../lib/supabase-admin')
const csrfToken = getOrCreateAdminCsrfToken(Astro.cookies)

let event: AdminEvent | null = null
let pendingFieldReviews: import('../../../../lib/admin/field-review-display').AdminFieldReviewRow[] =
  []
let reactionSummary: EventReactionSummaryRow | null = null
let reactionSources: EventReactionSourceRow[] = []
let reactionLoadNote: string | null = null
let eventTranslation: EventTranslationRow | null = null
let reactionTranslation: ReactionSummaryTranslationRow | null = null
let translationLoadNote: string | null = null
let eventSourceCount = 0
let generatedImageUrl: string | null = null
let generatedImageStatus = 'none'
let generatedImageSource: string | null = null
let generatedImageInstruction: string | null = null
let generatedImageUpdatedAt: string | null = null
let generatedImageNote: string | null = null
let loadError: string | null = null
let message: string | null = null
let errorMessage: string | null = Astro.url.searchParams.get('error')

const sp = Astro.url.searchParams
if (sp.get('saved') === '1') {
  message = '保存しました'
} else if (sp.get('hidden') === '1') {
  message = '非表示（hidden）にしました'
} else if (sp.get('unhidden') === '1') {
  message = '再公開（published）しました'
} else if (sp.get('field') === 'accepted') {
  message = `差分を承認しました (field=${sp.get('fname') ?? '?'})`
} else if (sp.get('field') === 'rejected') {
  message = '差分を却下しました'
} else if (sp.get('field') === 'accepted_bulk') {
  message = `差分を一括承認しました (${sp.get('count') ?? '?'}件)`
} else if (sp.get('field') === 'rejected_bulk') {
  message = `差分を一括却下しました (${sp.get('count') ?? '?'}件)`
} else if (sp.get('reaction_saved') === '1') {
  message = 'SNS・Web反応を保存しました'
} else if (sp.get('reaction_published') === '1') {
  message = 'SNS・Web反応を Publish しました'
} else if (sp.get('reaction_hidden') === '1') {
  message = 'SNS・Web反応を Hidden にしました'
} else if (sp.get('reaction_ai') === '1') {
  message = 'AI要約を生成しました（status=draft・要確認）'
} else if (sp.get('translation_saved') === '1') {
  message = '英語翻訳を保存しました'
} else if (sp.get('translation_published') === '1') {
  message = '英語翻訳を Publish しました'
} else if (sp.get('translation_hidden') === '1') {
  message = '英語翻訳を Hidden にしました'
} else if (sp.get('translation_ai') === '1') {
  message = 'AI英語翻訳を生成しました（status=draft・要確認）'
  } else if (sp.get('generated') === 'pending' && sp.get('source') === 'upload') {
    message = 'イメージ画像をアップロードしました（未確認）。Image Reviews で採用してください。'
  } else if (sp.get('generated') === 'pending') {
    message = 'イメージ画像を生成しました（未確認）。Image Reviews で採用してください。'
  }

try {
  const admin = createAdminClient()
  const { data, error } = await admin
    .from('events')
    .select(ADMIN_EVENT_SELECT)
    .eq('id', eventId)
    .maybeSingle()
  if (error) throw error
  event = (data as AdminEvent | null) ?? null
  if (!event) loadError = `Event id=${eventId} not found`
  else {
    pendingFieldReviews = await fetchAdminFieldReviews(admin, {
      status: 'pending',
      eventId,
    })

    const { count: srcCount } = await admin
      .from('event_sources')
      .select('*', { count: 'exact', head: true })
      .eq('event_id', eventId)
    eventSourceCount = srcCount ?? 0

    const generatedSelect =
      'generated_image_url, generated_image_status, generated_image_source, generated_image_instruction, updated_at'
    let generated = await admin
      .from('events')
      .select(generatedSelect)
      .eq('id', eventId)
      .maybeSingle()
    if (
      generated.error &&
      /generated_image_source|generated_image_instruction/i.test(generated.error.message)
    ) {
      generatedImageNote =
        '生成方法の列はまだありません。migration 適用後に表示できます。'
      generated = await admin
        .from('events')
        .select('generated_image_url, generated_image_status, updated_at')
        .eq('id', eventId)
        .maybeSingle()
    }
    if (generated.error) {
      generatedImageNote =
        'generated_image 列がまだありません。migration 適用後に生成できます。'
    } else {
      generatedImageUrl =
        (generated.data?.generated_image_url as string | null) ?? null
      generatedImageStatus =
        (generated.data?.generated_image_status as string | null) || 'none'
      generatedImageSource =
        (generated.data?.generated_image_source as string | null) ?? null
      generatedImageInstruction =
        (generated.data?.generated_image_instruction as string | null) ?? null
      generatedImageUpdatedAt =
        (generated.data?.updated_at as string | null) ?? null
    }

    const { data: reactionData, error: reactionError } = await admin
      .from('event_reaction_summaries')
      .select(
        'id, event_id, summary_bullets, signals, source_count, confidence, status, generated_at, reviewed_at, reviewed_by, created_at, updated_at',
      )
      .eq('event_id', eventId)
      .maybeSingle()

    if (reactionError) {
      const msg = reactionError.message ?? ''
      if (
        reactionError.code === '42P01' ||
        reactionError.code === 'PGRST205' ||
        /does not exist/i.test(msg) ||
        /Could not find the table/i.test(msg) ||
        /schema cache/i.test(msg)
      ) {
        reactionLoadNote =
          'event_reaction_summaries 未作成です。scripts/create-event-reaction-summaries.sql を適用してください。'
      } else {
        reactionLoadNote = `反応要約の読み込み失敗: ${msg}`
      }
    } else if (reactionData) {
      reactionSummary = mapSummaryRow(reactionData as Record<string, unknown>)
      const { data: sourcesData, error: sourcesError } = await admin
        .from('event_reaction_sources')
        .select(
          'id, event_id, summary_id, source_type, source_url, source_name, observed_at, excerpt_for_internal_review, created_at',
        )
        .eq('summary_id', reactionSummary.id)
        .order('observed_at', { ascending: false })
      if (sourcesError) {
        reactionLoadNote = `根拠ソースの読み込み失敗: ${sourcesError.message}`
      } else {
        reactionSources = (sourcesData ?? []) as EventReactionSourceRow[]
      }
    }

    try {
      eventTranslation = await fetchAdminEventTranslation(admin, eventId, 'en')
      if (reactionSummary) {
        reactionTranslation = await fetchAdminReactionTranslation(
          admin,
          reactionSummary.id,
          'en',
        )
      }
    } catch (te) {
      const msg = te instanceof Error ? te.message : String(te)
      if (/does not exist|PGRST205|schema cache/i.test(msg)) {
        translationLoadNote =
          '翻訳テーブル未作成です。scripts/create-event-translations.sql と grant-event-translations.sql を適用してください。'
      } else {
        translationLoadNote = `英語翻訳の読み込み失敗: ${msg}`
      }
    }
  }
} catch (e) {
  loadError = e instanceof Error ? e.message : String(e)
}

function fmtTime(t: string | null | undefined): string {
  if (!t) return ''
  const m = t.match(/^(\d{2}:\d{2})/)
  return m ? m[1] : t
}

function fmtCategory(c: string[] | null | undefined): string {
  if (!c?.length) return ''
  return c.join(', ')
}

function usageStatusOf(ev: AdminEvent): string {
  return ev.image_usage_status?.trim() || 'unknown'
}

function scheduleLabel(g: AdminEventScheduleGroup): string {
  switch (g) {
    case 'upcoming':
      return 'これから'
    case 'ongoing':
      return '開催中'
    case 'ended':
      return '終了'
    default:
      return '日付不明'
  }
}

const syncProtected = event ? isBodyProtectedFromSync(event.status) : false
const isDraft = event?.status === 'draft'
const isPublished = event?.status === 'published'
const isHidden = event?.status === 'hidden'
const scheduleGroup = event ? getAdminEventScheduleGroup(event) : 'unknown'
const reactionSignals = reactionSummary?.signals ?? {}
const reactionBulletsText = bulletsToTextarea(reactionSummary?.summary_bullets ?? [])
const reactionBulletDebug = (reactionSummary?.summary_bullets ?? []).map((text) => ({
  text,
  theme: classifyBulletTheme(text),
}))
const reactionStatusLabel = reactionSummary?.status ?? '未作成'
const translationStatusLabel = eventTranslation?.status ?? '未作成'
const reactionTranslationBulletsText = bulletsToTextarea(
  reactionTranslation?.summary_bullets ?? [],
)
const publicHref =
  event?.slug && isPublished ? `/tokyo/event/${event.slug}/` : null
const publicEnHref =
  event?.slug && isPublished ? `/en/tokyo/event/${event.slug}/` : null
---

<AdminLayout title={event ? `Edit #${event.id}` : 'Edit Event'} csrfToken={csrfToken}>
  <p class="crumb"><a href="/admin/events/all/">← All Events</a></p>

  {message && <p class="ok">{message}</p>}
  {errorMessage && <p class="err">{decodeURIComponent(errorMessage)}</p>}
  {loadError && <p class="err">{loadError}</p>}

  {
    event && (
      <>
        <header class="event-header admin-panel">
          <div class="event-header__main">
            <p class="event-header__id">Event #{event.id}</p>
            <h1 class="event-header__title">{event.title ?? '(no title)'}</h1>
            <div class="event-header__meta">
              <span class={`badge badge--event-${event.status ?? 'unknown'}`}>
                event: {event.status}
              </span>
              <span class={`badge badge--schedule badge--schedule-${scheduleGroup}`}>
                {scheduleLabel(scheduleGroup)}
              </span>
              <span class="meta-chip">sources {eventSourceCount}</span>
              <span class="meta-chip">
                field review pending {pendingFieldReviews.length}
              </span>
              <span class={`badge badge--reaction-${reactionSummary?.status ?? 'none'}`}>
                reaction: {reactionStatusLabel}
              </span>
              <span class={`badge badge--reaction-${eventTranslation?.status ?? 'none'}`}>
                en: {translationStatusLabel}
              </span>
            </div>
            <div class="event-header__links">
              {publicHref ? (
                <a href={publicHref} target="_blank" rel="noopener">
                  公開ページ ↗
                </a>
              ) : (
                <span class="hint">公開ページは published + slug 時のみ</span>
              )}
              {publicEnHref && (
                <a href={publicEnHref} target="_blank" rel="noopener">
                  EN ページ ↗
                </a>
              )}
              {event.slug && <span class="hint">slug: {event.slug}</span>}
            </div>
            {isDraft && (
              <p class="sync-warn">
                draft は次回 sync でソース値に上書きされる可能性があります。published /
                hidden は sync 本体非上書き（field review 経路は別）。
              </p>
            )}
            {syncProtected && (
              <p class="hint compact">
                published / hidden — sync import は本体を上書きしません。
              </p>
            )}
          </div>

          <div class="event-header__actions">
            <p class="action-label">イベント公開状態</p>
            {isPublished && (
              <form method="post" action="/admin/events/" class="inline-form">
                <input type="hidden" name="csrf_token" value={csrfToken} />
                <input type="hidden" name="intent" value="hide_event" />
                <input type="hidden" name="event_id" value={String(event.id)} />
                <button type="submit" class="btn btn--secondary">
                  Hidden にする
                </button>
              </form>
            )}
            {isHidden && (
              <form method="post" action="/admin/events/" class="inline-form">
                <input type="hidden" name="csrf_token" value={csrfToken} />
                <input type="hidden" name="intent" value="unhide_event" />
                <input type="hidden" name="event_id" value={String(event.id)} />
                <button type="submit" class="btn btn--primary">
                  Published に戻す
                </button>
              </form>
            )}
            {isDraft && (
              <p class="hint compact">
                draft の公開は
                <a href="/admin/events/draft/">Draft workspace</a>
                から。
              </p>
            )}
            <button
              type="submit"
              form="event-edit-form"
              class="btn btn--primary btn--save"
            >
              基本情報を保存
            </button>
          </div>
        </header>

        {
          pendingFieldReviews.length > 0 && (
            <section class="admin-panel field-review-section">
              <h2>差分レビュー {pendingFieldReviews.length}件</h2>
              <p class="hint">
                import 由来の変更候補です。承認すると published イベント本体が更新されます。
                <a href="/admin/events/reviews/field/pending/">Field Reviews 一覧</a>
              </p>
              <FieldReviewCards
                reviews={pendingFieldReviews}
                csrfToken={csrfToken}
                returnTo={`/admin/events/${eventId}/`}
                showBulkActions={true}
                showEventHeader={false}
              />
            </section>
          )
        }

        <div class="admin-event-main">
          <form
            id="event-edit-form"
            class="edit-form admin-panel admin-event-main__left"
            method="post"
            action="/admin/events/"
          >
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="event_update" />
            <input type="hidden" name="event_id" value={String(event.id)} />
            <input type="hidden" name="image_source" value={event.image_source ?? 'seekigo'} />

            <h2>基本情報</h2>
            <label>
              <AdminFieldLabel field="title" />
              <input type="text" name="title" value={event.title ?? ''} required />
            </label>

            <h3 class="subhead">日時</h3>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="start_date" />
                <input
                  type="date"
                  name="start_date"
                  value={event.start_date?.slice(0, 10) ?? ''}
                />
              </label>
              <label>
                <AdminFieldLabel field="end_date" />
                <input
                  type="date"
                  name="end_date"
                  value={event.end_date?.slice(0, 10) ?? ''}
                />
              </label>
            </div>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="start_time" note="HH:MM" />
                <input
                  type="text"
                  name="start_time"
                  value={fmtTime(event.start_time)}
                  placeholder="10:00"
                />
              </label>
              <label>
                <AdminFieldLabel field="end_time" note="HH:MM" />
                <input
                  type="text"
                  name="end_time"
                  value={fmtTime(event.end_time)}
                  placeholder="17:00"
                />
              </label>
            </div>

            <h3 class="subhead">会場</h3>
            <label>
              <AdminFieldLabel field="venue" />
              <input type="text" name="venue" value={event.venue ?? ''} />
            </label>
            <label>
              <AdminFieldLabel field="area" />
              <input type="text" name="area" value={event.area ?? ''} />
            </label>
            <label>
              <AdminFieldLabel field="address" />
              <textarea name="address" rows="2">{event.address ?? ''}</textarea>
            </label>

            <h3 class="subhead">料金・予約</h3>
            <p class="field-hint">
              未設定は空欄のまま。推測で確定しない。金額単位は円（JPY）。
            </p>
            <label>
              <AdminFieldLabel field="price_type" />
              <select name="price_type">
                <option value="" selected={event.price_type == null}>{PRICE_TYPE_LABELS.unset}</option>
                {PRICE_TYPES.map((value) => (
                  <option value={value} selected={event.price_type === value}>{PRICE_TYPE_LABELS[value]}</option>
                ))}
              </select>
            </label>
            <label>
              <AdminFieldLabel field="is_night" />
              <select name="is_night">
                <option value="" selected={event.is_night == null}>{IS_NIGHT_LABELS.unset}</option>
                <option value="true" selected={event.is_night === true}>{IS_NIGHT_LABELS.night}</option>
                <option value="false" selected={event.is_night === false}>{IS_NIGHT_LABELS.notNight}</option>
              </select>
            </label>
            <p class="field-hint">
              夜どこ行く？の候補です。遅くまで開いているだけでは付けません。
            </p>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="price_min" />
                <span class="admin-input-with-suffix">
                  <input
                    type="number"
                    name="price_min"
                    min="0"
                    step="1"
                    value={event.price_min ?? ''}
                  />
                  <span class="admin-field-suffix">円</span>
                </span>
              </label>
              <label>
                <AdminFieldLabel field="price_max" />
                <span class="admin-input-with-suffix">
                  <input
                    type="number"
                    name="price_max"
                    min="0"
                    step="1"
                    value={event.price_max ?? ''}
                  />
                  <span class="admin-field-suffix">円</span>
                </span>
              </label>
            </div>
            <label>
              <AdminFieldLabel field="price_text" />
              <input type="text" name="price_text" value={event.price_text ?? ''} />
            </label>
            <label>
              <AdminFieldLabel field="reservation_status" />
              <select name="reservation_status">
                <option value="" selected={!event.reservation_status}>{ADMIN_ENUM_UNSET_LABEL}</option>
                {RESERVATION_STATUSES.map((v) => (
                  <option value={v} selected={event.reservation_status === v}>
                    {RESERVATION_STATUS_LABELS[v] ?? v}
                  </option>
                ))}
              </select>
            </label>
            <label>
              <AdminFieldLabel field="reservation_url" />
              <input
                type="url"
                name="reservation_url"
                value={event.reservation_url ?? ''}
              />
            </label>

            <h3 class="subhead">アクセス</h3>
            <label>
              <AdminFieldLabel field="nearest_station" />
              <input
                type="text"
                name="nearest_station"
                value={event.nearest_station ?? ''}
                placeholder="例: 東京テレポート駅"
              />
            </label>
            <label>
              <AdminFieldLabel field="walk_minutes" />
              <span class="admin-input-with-suffix">
                <input
                  type="number"
                  name="walk_minutes"
                  min="0"
                  step="1"
                  value={event.walk_minutes ?? ''}
                />
                <span class="admin-field-suffix">分</span>
              </span>
            </label>
            <label>
              <AdminFieldLabel field="access_text" />
              <textarea name="access_text" rows="2">{event.access_text ?? ''}</textarea>
            </label>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="latitude" />
                <input
                  type="number"
                  name="latitude"
                  step="any"
                  value={event.latitude ?? ''}
                />
              </label>
              <label>
                <AdminFieldLabel field="longitude" />
                <input
                  type="number"
                  name="longitude"
                  step="any"
                  value={event.longitude ?? ''}
                />
              </label>
            </div>
            <label>
              <AdminFieldLabel field="parking_status" />
              <select name="parking_status">
                <option value="" selected={!event.parking_status}>{ADMIN_ENUM_UNSET_LABEL}</option>
                {PARKING_STATUSES.map((v) => (
                  <option value={v} selected={event.parking_status === v}>
                    {PARKING_STATUS_LABELS[v] ?? v}
                  </option>
                ))}
              </select>
            </label>
            <label>
              <AdminFieldLabel field="parking_text" />
              <textarea name="parking_text" rows="2">{event.parking_text ?? ''}</textarea>
            </label>

            <h3 class="subhead">行く前チェック</h3>
            <p class="field-hint">
              イベント属性（公式情報ベース）。SNS反応の signals とは別です。不明は「不明」か「未設定」。
            </p>
            <label>
              <AdminFieldLabel field="venue_type" />
              <select name="venue_type">
                <option value="" selected={!event.venue_type}>{ADMIN_ENUM_UNSET_LABEL}</option>
                {VENUE_TYPES.map((v) => (
                  <option value={v} selected={event.venue_type === v}>
                    {VENUE_TYPE_LABELS[v] ?? v}
                  </option>
                ))}
              </select>
            </label>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="family_friendly" />
                <select name="family_friendly">
                  <option value="" selected={!event.family_friendly}>{ADMIN_ENUM_UNSET_LABEL}</option>
                  {FRIENDLY_VALUES.map((v) => (
                    <option value={v} selected={event.family_friendly === v}>
                      {FRIENDLY_VALUE_LABELS[v] ?? v}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                <AdminFieldLabel field="date_friendly" />
                <select name="date_friendly">
                  <option value="" selected={!event.date_friendly}>{ADMIN_ENUM_UNSET_LABEL}</option>
                  {FRIENDLY_VALUES.map((v) => (
                    <option value={v} selected={event.date_friendly === v}>
                      {FRIENDLY_VALUE_LABELS[v] ?? v}
                    </option>
                  ))}
                </select>
              </label>
            </div>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="solo_friendly" />
                <select name="solo_friendly">
                  <option value="" selected={!event.solo_friendly}>{ADMIN_ENUM_UNSET_LABEL}</option>
                  {FRIENDLY_VALUES.map((v) => (
                    <option value={v} selected={event.solo_friendly === v}>
                      {FRIENDLY_VALUE_LABELS[v] ?? v}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                <AdminFieldLabel field="rain_friendly" />
                <select name="rain_friendly">
                  <option value="" selected={!event.rain_friendly}>{ADMIN_ENUM_UNSET_LABEL}</option>
                  {FRIENDLY_VALUES.map((v) => (
                    <option value={v} selected={event.rain_friendly === v}>
                      {FRIENDLY_VALUE_LABELS[v] ?? v}
                    </option>
                  ))}
                </select>
              </label>
            </div>
            <label>
              <AdminFieldLabel field="age_note" />
              <input
                type="text"
                name="age_note"
                value={event.age_note ?? ''}
                placeholder="例: 3歳以上 / 小学生以下は保護者同伴"
              />
            </label>
            <div class="form-row">
              <label>
                <AdminFieldLabel field="duration_minutes_min" />
                <span class="admin-input-with-suffix">
                  <input
                    type="number"
                    name="duration_minutes_min"
                    min="0"
                    step="1"
                    value={event.duration_minutes_min ?? ''}
                  />
                  <span class="admin-field-suffix">分</span>
                </span>
              </label>
              <label>
                <AdminFieldLabel field="duration_minutes_max" />
                <span class="admin-input-with-suffix">
                  <input
                    type="number"
                    name="duration_minutes_max"
                    min="0"
                    step="1"
                    value={event.duration_minutes_max ?? ''}
                  />
                  <span class="admin-field-suffix">分</span>
                </span>
              </label>
            </div>

            <h3 class="subhead">カテゴリ・概要</h3>
            <label>
              <AdminFieldLabel field="category" note="カンマ区切り" />
              <input type="text" name="category" value={fmtCategory(event.category)} />
            </label>
            <label>
              <AdminFieldLabel field="official_url" />
              <input type="url" name="official_url" value={event.official_url ?? ''} />
            </label>
            <label>
              <AdminFieldLabel field="summary" />
              <textarea name="summary" rows="8">{event.summary ?? ''}</textarea>
            </label>

            <div class="form-footer">
              <button type="submit" class="btn btn--primary">基本情報を保存</button>
            </div>
          </form>

          <div class="admin-event-main__right">
            <section class="admin-panel image-panel">
              <h2>画像</h2>
              <div class="image-preview">
                {event.image_url ? (
                  <img
                    src={event.image_url}
                    alt=""
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  />
                ) : (
                  <p class="hint">画像未設定</p>
                )}
              </div>
              <div class="admin-panel">
                <h3 class="subhead">イメージ画像</h3>
                {generatedImageNote && <p class="hint">{generatedImageNote}</p>}
                <p class="hint">
                  status: {generatedImageStatus}
                  {generatedImageSource === 'openai' ? ' · 生成方法: OpenAI' : ''}
                  {generatedImageSource === 'upload' ? ' · 生成方法: アップロード' : ''}
                  {generatedImageUrl ? ` · ${generatedImageUrl}` : ''}
                </p>
                {generatedImageInstruction && (
                  <p class="hint">追加指示: {generatedImageInstruction}</p>
                )}
                {generatedImageUrl && (
                  <img
                    src={generatedImageUpdatedAt
                      ? `${generatedImageUrl}?v=${encodeURIComponent(generatedImageUpdatedAt)}`
                      : generatedImageUrl}
                    alt=""
                    width="320"
                    height="180"
                    loading="lazy"
                  />
                )}
                <form id="concept-image-form" method="post" action="/admin/events/">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input
                    type="hidden"
                    name="intent"
                    value={generatedImageStatus === 'none'
                      ? 'generated_image_create'
                      : 'generated_image_regenerate'}
                  />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <input type="hidden" name="return_to" value={`/admin/events/${event.id}/`} />
                  <button type="submit" class="btn" form="concept-image-form">
                    {generatedImageStatus === 'none'
                      ? '標準設定でイメージ画像を生成'
                      : '標準設定で再生成'}
                  </button>
                </form>
                <form method="post" action="/admin/events/">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="generated_image_custom" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <input type="hidden" name="return_to" value={`/admin/events/${event.id}/`} />
                  <label>
                    追加指示（任意）
                    <textarea
                      name="generated_image_instruction"
                      rows="3"
                      maxlength="800"
                      placeholder="例：人物なし。複数種類のカレーを見せる。明るく上質な写真調。"
                    ></textarea>
                  </label>
                  <button type="submit" class="btn">
                    {generatedImageStatus === 'none' ? '追加指示で生成' : '追加指示で再生成'}
                  </button>
                </form>
                <form method="post" action="/admin/events/" enctype="multipart/form-data">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="generated_image_upload" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <input type="hidden" name="return_to" value={`/admin/events/${event.id}/`} />
                  <label>
                    用意した画像
                    <input
                      type="file"
                      name="generated_image_file"
                      accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                      required
                    />
                  </label>
                  <button type="submit" class="btn">画像をアップロード</button>
                </form>
                <p class="hint">
                  1回の操作で1枚です。標準・追加指示・アップロードのあと、採用は Image Reviews です。
                </p>
              </div>
              <label>
                <AdminFieldLabel field="image_url" />
                <input
                  form="event-edit-form"
                  type="url"
                  name="image_url"
                  value={event.image_url ?? ''}
                />
              </label>
              <label>
                <AdminFieldLabel field="image_usage_status" />
                <select form="event-edit-form" name="image_usage_status">
                  {IMAGE_USAGE_STATUSES.map((s) => (
                    <option value={s} selected={usageStatusOf(event) === s}>
                      {IMAGE_USAGE_STATUS_LABELS[s] ?? s}
                    </option>
                  ))}
                </select>
              </label>
              <label>
                <AdminFieldLabel field="image_credit" note="ライセンス取得済 / 主催者許可時" />
                <input
                  form="event-edit-form"
                  type="text"
                  name="image_credit"
                  value={event.image_credit ?? ''}
                />
              </label>
              <p class="hint compact">
                画像項目も「基本情報を保存」で一緒に保存されます。
              </p>
            </section>

            <section class="admin-panel reaction-section">
              <h2>SNS・Web反応</h2>
              <p class="hint compact">
                イベント公開状態とは別です。公開ページには published の反応要約のみ出ます。
              </p>
              {reactionLoadNote && <p class="err">{reactionLoadNote}</p>}

              <div class="reaction-summary-card">
                <div>
                  <span class="card-k">status</span>
                  <strong class={`badge badge--reaction-${reactionSummary?.status ?? 'none'}`}>
                    {reactionStatusLabel}
                  </strong>
                </div>
                <div>
                  <span class="card-k">confidence</span>
                  <strong>{reactionSummary?.confidence ?? '—'}</strong>
                </div>
                <div>
                  <span class="card-k">source_count</span>
                  <strong>{reactionSummary?.source_count ?? 0}</strong>
                </div>
                <div>
                  <span class="card-k">generated_at</span>
                  <strong class="card-v-sm">{reactionSummary?.generated_at ?? '—'}</strong>
                </div>
              </div>

              {
                (reactionSummary?.source_count ?? reactionSources.length) > 0 &&
                  (reactionSummary?.source_count ?? reactionSources.length) < 10 && (
                    <p class="hint compact reaction-low-source-note">
                      投稿数が少ないため、傾向は参考情報です
                    </p>
                  )
              }

              <div class="reaction-actions reaction-actions--ai">
                <form method="post" action="/admin/events/" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="reaction_ai_generate" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <button type="submit" class="btn btn--secondary">
                    AI要約を生成
                  </button>
                </form>
                <p class="hint compact">
                  サーバー側のみ（ブラウザから OpenAI は呼びません）。生成後は draft。自動 Publish
                  しません。ソース3件未満はスキップ。published/hidden は上書きしません。
                </p>
              </div>

              <form method="post" action="/admin/events/" class="reaction-form">
                <input type="hidden" name="csrf_token" value={csrfToken} />
                <input type="hidden" name="intent" value="reaction_save" />
                <input type="hidden" name="event_id" value={String(event.id)} />

                <label>
                  要約 bullets（1行1項目）
                  <textarea
                    name="summary_bullets"
                    rows="6"
                    placeholder={'・週末は混雑したという反応が多めです\n・子ども連れでも楽しめたという声があります'}
                  >{reactionBulletsText}</textarea>
                </label>

                {
                  reactionBulletDebug.length > 0 && (
                    <details class="reaction-theme-debug">
                      <summary class="hint compact">
                        DEV: bullet theme 推定（保存なし・公開非表示）
                      </summary>
                      <ul class="reaction-theme-debug__list">
                        {reactionBulletDebug.map((b) => (
                          <li>
                            <code>{b.theme}</code>
                            <span>{b.text}</span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  )
                }

                <fieldset class="reaction-signals">
                  <legend>signals</legend>
                  <div class="form-row">
                    <label>
                      crowd_level
                      <select name="crowd_level">
                        <option value="">（なし）</option>
                        <option
                          value="high"
                          selected={reactionSignals.crowd_level === 'high'}
                        >
                          high
                        </option>
                        <option
                          value="medium"
                          selected={reactionSignals.crowd_level === 'medium'}
                        >
                          medium
                        </option>
                        <option
                          value="low"
                          selected={reactionSignals.crowd_level === 'low'}
                        >
                          low
                        </option>
                      </select>
                    </label>
                    <label>
                      wait_time
                      <select name="wait_time">
                        <option value="">（なし）</option>
                        <option
                          value="long"
                          selected={reactionSignals.wait_time === 'long'}
                        >
                          long
                        </option>
                        <option
                          value="medium"
                          selected={reactionSignals.wait_time === 'medium'}
                        >
                          medium
                        </option>
                        <option
                          value="short"
                          selected={reactionSignals.wait_time === 'short'}
                        >
                          short
                        </option>
                      </select>
                    </label>
                  </div>
                  <div class="check-row">
                    <label class="check">
                      <input
                        type="checkbox"
                        name="signal_family"
                        value="1"
                        checked={reactionSignals.family === true}
                      />
                      子ども向け
                    </label>
                    <label class="check">
                      <input
                        type="checkbox"
                        name="signal_date"
                        value="1"
                        checked={reactionSignals.date === true}
                      />
                      デート
                    </label>
                    <label class="check">
                      <input
                        type="checkbox"
                        name="signal_solo"
                        value="1"
                        checked={reactionSignals.solo === true}
                      />
                      一人向け
                    </label>
                    <label class="check">
                      <input
                        type="checkbox"
                        name="signal_photo"
                        value="1"
                        checked={reactionSignals.photo === true}
                      />
                      写真映え
                    </label>
                    <label class="check">
                      <input
                        type="checkbox"
                        name="signal_rain"
                        value="1"
                        checked={reactionSignals.rain === true}
                      />
                      雨の日
                    </label>
                  </div>
                  <label>
                    recommended_time
                    <input
                      type="text"
                      name="recommended_time"
                      value={reactionSignals.recommended_time ?? ''}
                      placeholder="例: 夕方"
                    />
                  </label>
                </fieldset>

                <div class="form-row">
                  <label>
                    source_count
                    <input
                      type="number"
                      name="source_count"
                      min="0"
                      max="999"
                      value={String(reactionSummary?.source_count ?? 0)}
                    />
                  </label>
                  <label>
                    confidence
                    <select name="confidence">
                      <option
                        value="low"
                        selected={(reactionSummary?.confidence ?? 'low') === 'low'}
                      >
                        low
                      </option>
                      <option
                        value="medium"
                        selected={reactionSummary?.confidence === 'medium'}
                      >
                        medium
                      </option>
                      <option
                        value="high"
                        selected={reactionSummary?.confidence === 'high'}
                      >
                        high
                      </option>
                    </select>
                  </label>
                </div>

                <label class="check">
                  <input type="checkbox" name="mark_reviewed" value="1" />
                  保存時に reaction status=reviewed（published は維持）
                </label>

                <div class="reaction-actions">
                  <button type="submit" class="btn btn--primary">反応を保存</button>
                </div>
              </form>

              <div class="reaction-actions reaction-actions--status">
                <span class="action-label">反応の公開状態（イベント本体とは別）</span>
                <form method="post" action="/admin/events/" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="reaction_publish" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <button type="submit" class="btn btn--secondary">
                    Reaction Publish
                  </button>
                </form>
                <form method="post" action="/admin/events/" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="reaction_hide" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <button type="submit" class="btn btn--ghost">Reaction Hidden</button>
                </form>
              </div>

              <details class="sources-fold">
                <summary>
                  根拠ソース {reactionSources.length}件
                  <span class="hint">（内部確認用・公開非表示）</span>
                </summary>
                {
                  reactionSources.length === 0 ? (
                    <p class="hint">
                      ソースはまだありません。collect:reaction-web または SQL
                      シードで追加できます。
                    </p>
                  ) : (
                    <ul class="reaction-sources">
                      {reactionSources.map((src) => (
                        <li>
                          <div class="src-line">
                            <strong>{src.source_type}</strong>
                            {src.source_name ? ` · ${src.source_name}` : ''}
                          </div>
                          {src.source_url && (
                            <div class="src-line">
                              <a href={src.source_url} target="_blank" rel="noopener">
                                {src.source_url}
                              </a>
                            </div>
                          )}
                          {src.observed_at && (
                            <div class="hint compact">observed: {src.observed_at}</div>
                          )}
                          {src.excerpt_for_internal_review && (
                            <p class="excerpt">{src.excerpt_for_internal_review}</p>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                }
              </details>
            </section>

            <section class="admin-panel translation-section">
              <h2>英語翻訳</h2>
              <p class="hint compact">
                日本語イベント本体は変更しません。AI 生成は draft。公開 EN ページは
                published のみ使用します。
              </p>
              {translationLoadNote && <p class="err">{translationLoadNote}</p>}

              <div class="reaction-summary-card">
                <div>
                  <span class="card-k">status</span>
                  <strong class={`badge badge--reaction-${eventTranslation?.status ?? 'none'}`}>
                    {translationStatusLabel}
                  </strong>
                </div>
                <div>
                  <span class="card-k">locale</span>
                  <strong>en</strong>
                </div>
                <div>
                  <span class="card-k">generated_at</span>
                  <strong class="card-v-sm">
                    {eventTranslation?.generated_at ?? '—'}
                  </strong>
                </div>
                <div>
                  <span class="card-k">reaction EN</span>
                  <strong class={`badge badge--reaction-${reactionTranslation?.status ?? 'none'}`}>
                    {reactionTranslation?.status ?? '未作成'}
                  </strong>
                </div>
              </div>

              <div class="reaction-actions reaction-actions--ai">
                <form method="post" action="/admin/events/" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="translation_ai_generate" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <input type="hidden" name="translate_reaction" value="1" />
                  <button type="submit" class="btn btn--secondary">
                    AI翻訳を生成
                  </button>
                </form>
                <p class="hint compact">
                  サーバー側のみ。生成後は draft。自動 Publish しません。published/hidden
                  は上書きしません（force なし）。公式英語タイトルがあれば AI より優先。
                </p>
              </div>

              <form method="post" action="/admin/events/" class="reaction-form">
                <input type="hidden" name="csrf_token" value={csrfToken} />
                <input type="hidden" name="intent" value="translation_save" />
                <input type="hidden" name="event_id" value={String(event.id)} />

                <div class="translation-fields">
                  <div class="translation-pair">
                    <label>
                      title（JA）
                      <textarea rows="2" readonly>{event.title ?? ''}</textarea>
                    </label>
                    <label>
                      title（EN）
                      <textarea name="tr_title" rows="2">{eventTranslation?.title ?? ''}</textarea>
                    </label>
                  </div>
                  <div class="translation-pair">
                    <label>
                      summary（JA）
                      <textarea rows="3" readonly>{event.summary ?? ''}</textarea>
                    </label>
                    <label>
                      summary（EN）
                      <textarea name="tr_summary" rows="3">{eventTranslation?.summary ?? ''}</textarea>
                    </label>
                  </div>
                  <div class="translation-pair">
                    <label>
                      access_text（JA）
                      <textarea rows="2" readonly>{event.access_text ?? ''}</textarea>
                    </label>
                    <label>
                      access_text（EN）
                      <textarea name="tr_access_text" rows="2">{eventTranslation?.access_text ?? ''}</textarea>
                    </label>
                  </div>
                  <div class="translation-pair">
                    <label>
                      price_text（JA）
                      <textarea rows="2" readonly>{event.price_text ?? ''}</textarea>
                    </label>
                    <label>
                      price_text（EN）
                      <textarea name="tr_price_text" rows="2">{eventTranslation?.price_text ?? ''}</textarea>
                    </label>
                  </div>
                  <div class="translation-pair">
                    <label>
                      age_note（JA）
                      <textarea rows="2" readonly>{event.age_note ?? ''}</textarea>
                    </label>
                    <label>
                      age_note（EN）
                      <textarea name="tr_age_note" rows="2">{eventTranslation?.age_note ?? ''}</textarea>
                    </label>
                  </div>
                  <div class="translation-pair">
                    <label>
                      parking_text（JA）
                      <textarea rows="2" readonly>{event.parking_text ?? ''}</textarea>
                    </label>
                    <label>
                      parking_text（EN）
                      <textarea name="tr_parking_text" rows="2">{eventTranslation?.parking_text ?? ''}</textarea>
                    </label>
                  </div>
                  <div class="translation-pair">
                    <label>
                      reaction bullets（JA published）
                      <textarea rows="4" readonly>{reactionBulletsText}</textarea>
                    </label>
                    <label>
                      reaction bullets（EN）
                      <textarea
                        name="tr_reaction_bullets"
                        rows="4"
                        placeholder="1行1項目"
                      >{reactionTranslationBulletsText}</textarea>
                    </label>
                  </div>
                </div>

                <div class="reaction-actions">
                  <button type="submit" class="btn btn--primary">翻訳を保存</button>
                </div>
              </form>

              <div class="reaction-actions reaction-actions--status">
                <span class="action-label">英語翻訳の公開状態</span>
                <form method="post" action="/admin/events/" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="translation_publish" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <button type="submit" class="btn btn--secondary">
                    Translation Publish
                  </button>
                </form>
                <form method="post" action="/admin/events/" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="translation_hide" />
                  <input type="hidden" name="event_id" value={String(event.id)} />
                  <button type="submit" class="btn btn--ghost">Translation Hidden</button>
                </form>
              </div>
            </section>
          </div>
        </div>

        <details class="danger-fold">
          <summary>危険な操作（削除）</summary>
          <div class="danger-zone-inner">
            <p class="err">
              物理削除します。event_sources / field_reviews は CASCADE、dedupe reviews
              は SET NULL されます。
            </p>
            <form
              method="post"
              action="/admin/events/"
              id="delete-form"
              onsubmit="return confirm('本当に削除しますか？この操作は取り消せません。');"
            >
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="delete_event" />
              <input type="hidden" name="event_id" value={String(event.id)} />
              <label>
                確認のため event id を入力: <strong>{event.id}</strong>
                <input
                  type="text"
                  name="confirm_delete"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder={String(event.id)}
                  required
                />
              </label>
              <button type="submit" class="btn-danger">イベントを削除</button>
            </form>
          </div>
        </details>
      </>
    )
  }
</AdminLayout>

<style>
  .crumb {
    margin: 0 0 0.75rem;
  }

  .event-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.5rem;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .event-header__id {
    margin: 0;
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 600;
  }

  .event-header__title {
    margin: 0.15rem 0 0.65rem;
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    line-height: 1.25;
  }

  .event-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-bottom: 0.5rem;
  }

  .event-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .event-header__actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: min(100%, 12rem);
  }

  .action-label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: #e2e8f0;
    color: #334155;
  }

  .badge--event-published {
    background: #dcfce7;
    color: #166534;
  }
  .badge--event-hidden {
    background: #f1f5f9;
    color: #475569;
  }
  .badge--event-draft {
    background: #fef9c3;
