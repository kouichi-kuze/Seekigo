---
import AdminLayout from '../../../../layouts/AdminLayout.astro'
import FieldReviewCards from '../../../../components/admin/FieldReviewCards.astro'
import { adminDevNotFoundResponse } from '../../../../lib/admin/dev-guard'
import { getOrCreateAdminCsrfToken } from '../../../../lib/admin-security'
import { ADMIN_EVENT_SELECT, type AdminEvent } from '../../../../lib/admin/types'
import { fetchAdminFieldReviews } from '../../../../lib/admin/field-reviews'
import { IMAGE_USAGE_STATUSES } from '../../../../lib/event-image-usage'
import { isBodyProtectedFromSync } from '../../../../lib/event-status'
import { getAdminEventEditStaticPaths } from '../../../../lib/admin/event-edit-paths'
import {
  bulletsToTextarea,
  mapSummaryRow,
  type EventReactionSourceRow,
  type EventReactionSummaryRow,
} from '../../../../lib/event-reaction-summary'

/** 本番 SSG では admin 編集ページを生成しない。DEV では Supabase から id 一覧を取得。 */
export async function getStaticPaths() {
  return getAdminEventEditStaticPaths()
}

if (!import.meta.env.DEV) {
  return adminDevNotFoundResponse()
}

const { id: idParam } = Astro.params
const eventId = Number(idParam)
if (!Number.isFinite(eventId) || eventId <= 0) {
  return adminDevNotFoundResponse()
}

const { createAdminClient } = await import('../../../../lib/supabase-admin')
const csrfToken = getOrCreateAdminCsrfToken(Astro.cookies)

let event: AdminEvent | null = null
let pendingFieldReviews: import('../../../../lib/admin/field-review-display').AdminFieldReviewRow[] = []
let reactionSummary: EventReactionSummaryRow | null = null
let reactionSources: EventReactionSourceRow[] = []
let reactionLoadNote: string | null = null
let loadError: string | null = null
let message: string | null = null
let errorMessage: string | null = Astro.url.searchParams.get('error')

const sp = Astro.url.searchParams
if (sp.get('saved') === '1') {
  message = '保存しました'
} else if (sp.get('hidden') === '1') {
  message = '非表示（hidden）にしました'
} else if (sp.get('unhidden') === '1') {
  message = '再公開（published）しました'
} else if (sp.get('field') === 'accepted') {
  message = `差分を承認しました (field=${sp.get('fname') ?? '?'})`
} else if (sp.get('field') === 'rejected') {
  message = '差分を却下しました'
} else if (sp.get('field') === 'accepted_bulk') {
  message = `差分を一括承認しました (${sp.get('count') ?? '?'}件)`
} else if (sp.get('field') === 'rejected_bulk') {
  message = `差分を一括却下しました (${sp.get('count') ?? '?'}件)`
} else if (sp.get('reaction_saved') === '1') {
  message = 'SNS・Web反応を保存しました'
} else if (sp.get('reaction_published') === '1') {
  message = 'SNS・Web反応を Publish しました'
} else if (sp.get('reaction_hidden') === '1') {
  message = 'SNS・Web反応を Hidden にしました'
}

try {
  const admin = createAdminClient()
  const { data, error } = await admin
    .from('events')
    .select(ADMIN_EVENT_SELECT)
    .eq('id', eventId)
    .maybeSingle()
  if (error) throw error
  event = (data as AdminEvent | null) ?? null
  if (!event) loadError = `Event id=${eventId} not found`
  else {
    pendingFieldReviews = await fetchAdminFieldReviews(admin, {
      status: 'pending',
      eventId,
    })

    const { data: reactionData, error: reactionError } = await admin
      .from('event_reaction_summaries')
      .select(
        'id, event_id, summary_bullets, signals, source_count, confidence, status, generated_at, reviewed_at, reviewed_by, created_at, updated_at',
      )
      .eq('event_id', eventId)
      .maybeSingle()

    if (reactionError) {
      const msg = reactionError.message ?? ''
      if (
        reactionError.code === '42P01' ||
        reactionError.code === 'PGRST205' ||
        /does not exist/i.test(msg) ||
        /Could not find the table/i.test(msg) ||
        /schema cache/i.test(msg)
      ) {
        reactionLoadNote =
          'event_reaction_summaries 未作成です。scripts/create-event-reaction-summaries.sql を適用してください。'
      } else {
        reactionLoadNote = `反応要約の読み込み失敗: ${msg}`
      }
    } else if (reactionData) {
      reactionSummary = mapSummaryRow(reactionData as Record<string, unknown>)
      const { data: sourcesData, error: sourcesError } = await admin
        .from('event_reaction_sources')
        .select(
          'id, event_id, summary_id, source_type, source_url, source_name, observed_at, excerpt_for_internal_review, created_at',
        )
        .eq('summary_id', reactionSummary.id)
        .order('observed_at', { ascending: false })
      if (sourcesError) {
        reactionLoadNote = `根拠ソースの読み込み失敗: ${sourcesError.message}`
      } else {
        reactionSources = (sourcesData ?? []) as EventReactionSourceRow[]
      }
    }
  }
} catch (e) {
  loadError = e instanceof Error ? e.message : String(e)
}

function fmtTime(t: string | null | undefined): string {
  if (!t) return ''
  const m = t.match(/^(\d{2}:\d{2})/)
  return m ? m[1] : t
}

function fmtCategory(c: string[] | null | undefined): string {
  if (!c?.length) return ''
  return c.join(', ')
}

function usageStatusOf(ev: AdminEvent): string {
  return ev.image_usage_status?.trim() || 'unknown'
}

const syncProtected = event ? isBodyProtectedFromSync(event.status) : false
const isDraft = event?.status === 'draft'
const isPublished = event?.status === 'published'
const isHidden = event?.status === 'hidden'

const reactionSignals = reactionSummary?.signals ?? {}
const reactionBulletsText = bulletsToTextarea(reactionSummary?.summary_bullets ?? [])
---

<AdminLayout title={event ? `Edit #${event.id}` : 'Edit Event'} csrfToken={csrfToken}>
  <p><a href="/admin/events/all/">← All Events</a></p>
  <h1>Event #{eventId}</h1>

  {message && <p class="ok">{message}</p>}
  {errorMessage && <p class="err">{decodeURIComponent(errorMessage)}</p>}
  {loadError && <p class="err">{loadError}</p>}

  {
    event && (
      <>
        <div class="admin-panel">
          <p>
            status: <strong>{event.status}</strong>
            {event.slug && isPublished && (
              <>
                {' · '}
                <a href={`/tokyo/event/${event.slug}/`} target="_blank" rel="noopener">
                  公開ページ ↗
                </a>
              </>
            )}
          </p>
          {isDraft && (
            <p class="sync-warn">
              draft は次回 sync でソース値に上書きされる可能性があります。published
              / hidden は sync 本体非上書き（field review 経路は別）。
            </p>
          )}
          {syncProtected && (
            <p class="hint">
              published / hidden — sync import は本体を上書きしません。
            </p>
          )}
        </div>

        {
          pendingFieldReviews.length > 0 && (
            <section class="admin-panel field-review-section">
              <h2>差分レビュー {pendingFieldReviews.length}件</h2>
              <p class="hint">
                import 由来の変更候補です。承認すると published イベント本体が更新されます。
                <a href="/admin/events/reviews/field/pending/">Field Reviews 一覧</a>
              </p>
              <FieldReviewCards
                reviews={pendingFieldReviews}
                csrfToken={csrfToken}
                returnTo={`/admin/events/${eventId}/`}
                showBulkActions={true}
                showEventHeader={false}
              />
            </section>
          )
        }

        <form
          class="admin-panel edit-form"
          method="post"
          action="/admin/events/"
        >
          <input type="hidden" name="csrf_token" value={csrfToken} />
          <input type="hidden" name="intent" value="event_update" />
          <input type="hidden" name="event_id" value={String(event.id)} />

          <h2>基本情報</h2>
          <label>
            title
            <input type="text" name="title" value={event.title ?? ''} required />
          </label>
          <div class="form-row">
            <label>
              start_date
              <input type="date" name="start_date" value={event.start_date?.slice(0, 10) ?? ''} />
            </label>
            <label>
              end_date
              <input type="date" name="end_date" value={event.end_date?.slice(0, 10) ?? ''} />
            </label>
          </div>
          <div class="form-row">
            <label>
              start_time (HH:MM)
              <input type="text" name="start_time" value={fmtTime(event.start_time)} placeholder="10:00" />
            </label>
            <label>
              end_time (HH:MM)
              <input type="text" name="end_time" value={fmtTime(event.end_time)} placeholder="17:00" />
            </label>
          </div>
          <label>
            venue
            <input type="text" name="venue" value={event.venue ?? ''} />
          </label>
          <label>
            area
            <input type="text" name="area" value={event.area ?? ''} />
          </label>
          <label>
            address
            <textarea name="address" rows="2">{event.address ?? ''}</textarea>
          </label>
          <label>
            price_text
            <input type="text" name="price_text" value={event.price_text ?? ''} />
          </label>
          <label>
            category（カンマ区切り）
            <input type="text" name="category" value={fmtCategory(event.category)} />
          </label>
          <label>
            official_url
            <input type="url" name="official_url" value={event.official_url ?? ''} />
          </label>
          <label>
            summary
            <textarea name="summary" rows="5">{event.summary ?? ''}</textarea>
          </label>

          <h2>画像</h2>
          <label>
            image_url
            <input type="url" name="image_url" value={event.image_url ?? ''} />
          </label>
          <label>
            image_usage_status
            <select name="image_usage_status">
              {IMAGE_USAGE_STATUSES.map((s) => (
                <option value={s} selected={usageStatusOf(event) === s}>
                  {s}
                </option>
              ))}
            </select>
          </label>
          <label>
            image_credit（licensed / organizer_granted 時）
            <input type="text" name="image_credit" value={event.image_credit ?? ''} />
          </label>
          <input type="hidden" name="image_source" value={event.image_source ?? 'seekigo'} />

          <button type="submit">保存</button>
        </form>

        <section class="admin-panel reaction-section">
          <h2>SNS・Web反応</h2>
          <p class="hint">
            公開情報の傾向要約です。第三者投稿本文は公開ページに出ません。
            AI 生成後も自動公開せず、人間確認後に Publish してください。
          </p>
          {reactionLoadNote && <p class="err">{reactionLoadNote}</p>}

          <form method="post" action="/admin/events/" class="reaction-form">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="reaction_save" />
            <input type="hidden" name="event_id" value={String(event.id)} />

            <p>
              status: <strong>{reactionSummary?.status ?? '（未作成）'}</strong>
              {' · '}
              confidence: <strong>{reactionSummary?.confidence ?? '—'}</strong>
              {' · '}
              source_count: <strong>{reactionSummary?.source_count ?? 0}</strong>
            </p>
            <p class="hint">
              generated_at: {reactionSummary?.generated_at ?? '—'}
              {' · '}
              reviewed_at: {reactionSummary?.reviewed_at ?? '—'}
            </p>

            <label>
              要約（1行1項目。断定せず「〜という反応 / 傾向」表現）
              <textarea
                name="summary_bullets"
                rows="5"
                placeholder={'・週末は混雑したという反応が多めです\n・子ども連れでも楽しめたという声があります'}
              >{reactionBulletsText}</textarea>
            </label>

            <fieldset class="reaction-signals">
              <legend>signals</legend>
              <label>
                crowd_level
                <select name="crowd_level">
                  <option value="">（なし）</option>
                  <option value="high" selected={reactionSignals.crowd_level === 'high'}>
                    high
                  </option>
                  <option value="medium" selected={reactionSignals.crowd_level === 'medium'}>
                    medium
                  </option>
                  <option value="low" selected={reactionSignals.crowd_level === 'low'}>
                    low
                  </option>
                </select>
              </label>
              <label>
                wait_time
                <select name="wait_time">
                  <option value="">（なし）</option>
                  <option value="long" selected={reactionSignals.wait_time === 'long'}>
                    long
                  </option>
                  <option value="medium" selected={reactionSignals.wait_time === 'medium'}>
                    medium
                  </option>
                  <option value="short" selected={reactionSignals.wait_time === 'short'}>
                    short
                  </option>
                </select>
              </label>
              <label class="check">
                <input type="checkbox" name="signal_family" value="1" checked={reactionSignals.family === true} />
                子ども向け (family)
              </label>
              <label class="check">
                <input type="checkbox" name="signal_date" value="1" checked={reactionSignals.date === true} />
                デート (date)
              </label>
              <label class="check">
                <input type="checkbox" name="signal_solo" value="1" checked={reactionSignals.solo === true} />
                一人向け (solo)
              </label>
              <label class="check">
                <input type="checkbox" name="signal_photo" value="1" checked={reactionSignals.photo === true} />
                写真映え (photo)
              </label>
              <label class="check">
                <input type="checkbox" name="signal_rain" value="1" checked={reactionSignals.rain === true} />
                雨の日 (rain)
              </label>
              <label>
                recommended_time
                <input
                  type="text"
                  name="recommended_time"
                  value={reactionSignals.recommended_time ?? ''}
                  placeholder="例: 夕方"
                />
              </label>
            </fieldset>

            <div class="form-row">
              <label>
                source_count
                <input
                  type="number"
                  name="source_count"
                  min="0"
                  max="999"
                  value={String(reactionSummary?.source_count ?? 0)}
                />
              </label>
              <label>
                confidence
                <select name="confidence">
                  <option value="low" selected={(reactionSummary?.confidence ?? 'low') === 'low'}>
                    low
                  </option>
                  <option value="medium" selected={reactionSummary?.confidence === 'medium'}>
                    medium
                  </option>
                  <option value="high" selected={reactionSummary?.confidence === 'high'}>
                    high
                  </option>
                </select>
              </label>
            </div>

            <label class="check">
              <input type="checkbox" name="mark_reviewed" value="1" />
              保存時に status=reviewed にする（published は維持）
            </label>

            <button type="submit">反応要約を保存</button>
          </form>

          <div class="reaction-actions">
            <form method="post" action="/admin/events/" class="inline-form">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="reaction_publish" />
              <input type="hidden" name="event_id" value={String(event.id)} />
              <button type="submit">Publish</button>
            </form>
            <form method="post" action="/admin/events/" class="inline-form">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="reaction_hide" />
              <input type="hidden" name="event_id" value={String(event.id)} />
              <button type="submit">Hidden</button>
            </form>
          </div>

          <h3>根拠ソース（内部確認用）</h3>
          {
            reactionSources.length === 0 ? (
              <p class="hint">
                ソースはまだありません。Phase 4A では SQL シードまたは将来の取得ジョブで追加します。
              </p>
            ) : (
              <ul class="reaction-sources">
                {reactionSources.map((src) => (
                  <li>
                    <strong>{src.source_type}</strong>
                    {src.source_name ? ` · ${src.source_name}` : ''}
                    {src.source_url && (
                      <>
                        {' · '}
                        <a href={src.source_url} target="_blank" rel="noopener">
                          URL
                        </a>
                      </>
                    )}
                    {src.observed_at && (
                      <span class="hint"> · observed: {src.observed_at}</span>
                    )}
                    {src.excerpt_for_internal_review && (
                      <p class="excerpt">{src.excerpt_for_internal_review}</p>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <div class="admin-panel">
          <h2>Visibility</h2>
          {isPublished && (
            <form method="post" action="/admin/events/" class="inline-form">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="hide_event" />
              <input type="hidden" name="event_id" value={String(event.id)} />
              <button type="submit">公開サイトから非表示（hidden）</button>
            </form>
          )}
          {isHidden && (
            <form method="post" action="/admin/events/" class="inline-form">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="unhide_event" />
              <input type="hidden" name="event_id" value={String(event.id)} />
              <button type="submit">再公開（published）</button>
            </form>
          )}
          {isDraft && (
            <p class="hint">
              draft の公開は <a href="/admin/events/draft/">Draft workspace</a> から
              Publish してください。
            </p>
          )}
        </div>

        <div class="admin-panel danger-zone">
          <h2>Danger Zone</h2>
          <p class="err">
            物理削除します。event_sources / field_reviews は CASCADE、dedupe reviews
            は SET NULL されます。
          </p>
          <form
            method="post"
            action="/admin/events/"
            id="delete-form"
            onsubmit="return confirm('本当に削除しますか？この操作は取り消せません。');"
          >
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="delete_event" />
            <input type="hidden" name="event_id" value={String(event.id)} />
            <label>
              確認のため event id を入力: <strong>{event.id}</strong>
              <input
                type="text"
                name="confirm_delete"
                inputmode="numeric"
                autocomplete="off"
                placeholder={String(event.id)}
                required
              />
            </label>
            <button type="submit" class="btn-danger">イベントを削除</button>
          </form>
        </div>
      </>
    )
  }
</AdminLayout>

<style>
  .edit-form label {
    display: block;
    margin-bottom: 0.75rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .edit-form input[type='text'],
  .edit-form input[type='url'],
  .edit-form input[type='date'],
  .edit-form select,
  .edit-form textarea {
    display: block;
    width: 100%;
    max-width: 36rem;
    margin-top: 0.25rem;
    padding: 0.4rem 0.5rem;
    font-weight: 400;
  }

  .form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sync-warn {
    background: #fff8e6;
    border: 1px solid #e6c200;
    padding: 0.5rem 0.75rem;
    margin: 0.5rem 0 0;
  }

  .danger-zone {
    border-color: #e88;
    background: #fff5f5;
  }

  .btn-danger {
    background: #a40000;
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  .inline-form button {
    margin-top: 0;
  }

  .field-review-section h2 {
    margin-top: 0;
  }

  .reaction-section h2,
  .reaction-section h3 {
    margin-top: 0;
  }

  .reaction-form label {
    display: block;
    margin-bottom: 0.75rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .reaction-form textarea,
  .reaction-form input[type='text'],
  .reaction-form input[type='number'],
  .reaction-form select {
    display: block;
    width: 100%;
    max-width: 36rem;
    margin-top: 0.25rem;
    padding: 0.4rem 0.5rem;
    font-weight: 400;
  }

  .reaction-signals {
    border: 1px solid #dbe3ea;
    border-radius: 8px;
    padding: 0.75rem 1rem 0.25rem;
    margin: 0 0 1rem;
    max-width: 36rem;
  }

  .reaction-signals legend {
    font-weight: 700;
    padding: 0 0.25rem;
  }

  .reaction-form label.check {
    font-weight: 500;
  }

  .reaction-form label.check input {
    display: inline;
    width: auto;
    margin-right: 0.4rem;
  }

  .reaction-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.75rem 0 1rem;
  }

  .reaction-sources {
    margin: 0;
    padding-left: 1.1rem;
  }

  .reaction-sources .excerpt {
    margin: 0.25rem 0 0.75rem;
    font-size: 0.85rem;
    color: #555;
    background: #f6f8fa;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
  }
</style>
