---
import AdminLayout from '../../../../../layouts/AdminLayout.astro'
import { adminDevNotFoundResponse } from '../../../../../lib/admin/dev-guard'
import { getOrCreateAdminCsrfToken } from '../../../../../lib/admin-security'
import {
  IMAGE_USAGE_STATUSES,
  resolveEventDisplayImage,
} from '../../../../../lib/event-image-usage'
import type { AdminEvent } from '../../../../../lib/admin/types'

if (!import.meta.env.DEV) {
  return adminDevNotFoundResponse()
}

const { createAdminClient } = await import('../../../../../lib/supabase-admin')
const csrfToken = getOrCreateAdminCsrfToken(Astro.cookies)

const EVENT_SELECT =
  'id, title, slug, category, image_url, image_usage_status, image_source, image_credit, status'

let events: AdminEvent[] = []
let generatedReviews: Array<{
  id: number | string
  title: string | null
  generated_image_url: string | null
  generated_image_status: string | null
  generated_image_source?: string | null
  generated_image_instruction?: string | null
  updated_at?: string | null
}> = []
let generatedNote: string | null = null
let loadError: string | null = null
let message: string | null = null

const sp = Astro.url.searchParams
if (sp.get('image') === 'updated') {
  message = `更新しました (event_id=${sp.get('event_id') ?? '?'}, status=${sp.get('status') ?? '?'})`
} else if (sp.get('image') === 'bulk') {
  message = `${sp.get('count') ?? '?'}件を一括更新 (status=${sp.get('status') ?? '?'})`
} else if (sp.get('generated') === 'pending' && sp.get('source') === 'upload') {
  message = `イメージ画像をアップロードしました（未確認） event_id=${sp.get('event_id') ?? '?'}`
} else if (sp.get('generated') === 'pending') {
  message = `イメージ画像を生成しました（未確認） event_id=${sp.get('event_id') ?? '?'}`
} else if (sp.get('generated') === 'approved' || sp.get('generated') === 'rejected') {
  message = `イメージ画像を ${sp.get('generated')} にしました（event_id=${sp.get('event_id') ?? '?'}）`
} else if (sp.get('generated_bulk') === '1') {
  const okCount = Number(sp.get('ok') ?? '')
  const ngCount = Number(sp.get('ng') ?? '')
  const failedIds = (sp.get('failed') ?? '')
    .split(',')
    .map((id) => id.trim())
    .filter((id) => /^\d+$/.test(id))
  const okText = Number.isSafeInteger(okCount) && okCount >= 0 ? String(okCount) : '?'
  const ngText = Number.isSafeInteger(ngCount) && ngCount >= 0 ? String(ngCount) : '?'
  message = `表示中の画像を採用しました。成功 ${okText}件 / 失敗 ${ngText}件`
  if (failedIds.length > 0) {
    message += `（失敗した event ID: ${failedIds.join(', ')}）`
  }
}

try {
  const admin = createAdminClient()
  const { data, error } = await admin
    .from('events')
    .select(EVENT_SELECT)
    .eq('status', 'published')
    .not('image_url', 'is', null)
    .order('id', { ascending: true })
  if (error) throw error
  events = (data ?? []) as AdminEvent[]

  let generated = await admin
    .from('events')
    .select(
      'id, title, generated_image_url, generated_image_status, generated_image_source, generated_image_instruction, updated_at',
    )
    .eq('generated_image_status', 'pending')
    .order('id', { ascending: true })
  if (
    generated.error &&
    /generated_image_source|generated_image_instruction/i.test(generated.error.message)
  ) {
    generatedNote = '生成方法の列はまだありません。migration 適用後に表示できます。'
    generated = await admin
      .from('events')
      .select('id, title, generated_image_url, generated_image_status, updated_at')
      .eq('generated_image_status', 'pending')
      .order('id', { ascending: true })
  }
  if (generated.error) {
    generatedNote = '生成画像の列はまだありません。migration 適用後にレビューできます。'
  } else {
    generatedReviews = (generated.data ?? []) as typeof generatedReviews
  }
} catch (e) {
  loadError = e instanceof Error ? e.message : String(e)
}

function usageStatusOf(event: AdminEvent): string {
  return event.image_usage_status?.trim() || 'unknown'
}

function generatedSourceLabel(source: string | null | undefined): string | null {
  if (source === 'openai') return 'OpenAI'
  if (source === 'upload') return 'アップロード'
  return null
}

function generatedPreviewSrc(
  url: string | null,
  updatedAt: string | null | undefined,
): string {
  if (!url) return ''
  if (!updatedAt) return url
  return `${url}?v=${encodeURIComponent(updatedAt)}`
}
---

<AdminLayout title="Image Reviews" csrfToken={csrfToken}>
  <h1>Image Reviews</h1>
  <p class="hint">
    published イベントの image_usage_status を手動設定。一括操作・Ajax 更新は{' '}
    <a href="/admin/events/draft/#published-image-list">Draft workspace</a>{' '}
    を利用してください。
  </p>
  {message && <p class="ok">{message}</p>}
  {loadError && <p class="err">{loadError}</p>}
  {generatedNote && <p class="hint">{generatedNote}</p>}

  <section class="admin-panel">
    <h2>生成イメージ（未確認）</h2>
    <form id="approve-displayed-form" method="POST" action="/admin/events/">
      <input type="hidden" name="csrf_token" value={csrfToken} />
      <input type="hidden" name="intent" value="generated_image_approve_displayed" />
      <p class="approve-displayed__count">表示中 <span id="approve-displayed-count">{generatedReviews.length}</span>件</p>
      {
        generatedReviews.map((event) => (
          <input type="hidden" name="event_id" value={String(event.id)} />
        ))
      }
      <button
        id="approve-displayed-button"
        class="admin-btn"
        type="submit"
        disabled={generatedReviews.length === 0}
      >
        表示中の画像をすべて採用
      </button>
    </form>
    {generatedReviews.length === 0 ? (
      <p class="hint">pending のイメージ画像はありません。</p>
    ) : (
      generatedReviews.map((event) => (
        <article
          class="image-card"
          id={`generated-${event.id}`}
          data-generated-review
          data-event-id={String(event.id)}
        >
          <h3>
            <a href={`/admin/events/${event.id}/`}>{event.title}</a>
          </h3>
          {event.generated_image_url && (
            <img
              src={generatedPreviewSrc(event.generated_image_url, event.updated_at)}
              alt=""
              width="320"
              height="180"
              loading="lazy"
            />
          )}
          {generatedSourceLabel(event.generated_image_source) && (
            <p class="hint">生成方法: {generatedSourceLabel(event.generated_image_source)}</p>
          )}
          {event.generated_image_instruction && (
            <p class="hint">追加指示: {event.generated_image_instruction}</p>
          )}
          <form method="POST" action="/admin/events/">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="event_id" value={String(event.id)} />
            <input type="hidden" name="return_to" value="/admin/events/reviews/image/" />
            <button type="submit" name="intent" value="generated_image_approve">採用</button>
            <button type="submit" name="intent" value="generated_image_reject">不採用</button>
          </form>
          <form method="POST" action="/admin/events/">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="generated_image_regenerate" />
            <input type="hidden" name="event_id" value={String(event.id)} />
            <input type="hidden" name="return_to" value="/admin/events/reviews/image/" />
            <button type="submit" class="admin-btn">標準設定で再生成</button>
          </form>
          <form method="POST" action="/admin/events/">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="generated_image_custom" />
            <input type="hidden" name="event_id" value={String(event.id)} />
            <input type="hidden" name="return_to" value="/admin/events/reviews/image/" />
            <label>
              追加指示（任意）
              <textarea
                name="generated_image_instruction"
                rows="3"
                maxlength="800"
                placeholder="例：人物なし。複数種類のカレーを見せる。明るく上質な写真調。"
              ></textarea>
            </label>
            <button type="submit" class="admin-btn">追加指示で再生成</button>
          </form>
          <form class="admin-upload-form" method="POST" action="/admin/events/" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="generated_image_upload" />
            <input type="hidden" name="event_id" value={String(event.id)} />
            <input type="hidden" name="return_to" value="/admin/events/reviews/image/" />
            <label>
              用意した画像
              <input
                type="file"
                name="generated_image_file"
                accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                required
              />
            </label>
            <button type="submit" class="admin-btn">画像をアップロード</button>
          </form>
        </article>
      ))
    )}
  </section>

  <script>
    const form = document.getElementById('approve-displayed-form')
    const button = document.getElementById('approve-displayed-button')
    const countEl = document.getElementById('approve-displayed-count')
    let sending = false

    function visibleReviewIds(): Set<string> {
      const cards = document.querySelectorAll<HTMLElement>('[data-generated-review]')
      const visible = new Set<string>()
      cards.forEach((card) => {
        if (card.hidden || card.style.display === 'none') return
        const id = card.dataset.eventId
        if (id) visible.add(id)
      })
      return visible
    }

    function syncDisplayedIds(): number {
      if (!(form instanceof HTMLFormElement)) return 0
      const visible = visibleReviewIds()
      let count = 0
      form.querySelectorAll<HTMLInputElement>('input[name="event_id"]').forEach((input) => {
        const shown = visible.has(input.value)
        input.disabled = !shown
        if (shown) count += 1
      })
      if (countEl) countEl.textContent = String(count)
      if (button instanceof HTMLButtonElement && !sending) button.disabled = count === 0
      return count
    }

    form?.addEventListener('submit', (event) => {
      if (sending) {
        event.preventDefault()
        return
      }
      const count = syncDisplayedIds()
      if (count === 0) {
        event.preventDefault()
        return
      }
      const accepted = window.confirm(
        `表示中の${count}件の画像をすべて採用します。よろしいですか？`,
      )
      if (!accepted) {
        event.preventDefault()
        return
      }
      sending = true
      if (button instanceof HTMLButtonElement) {
        button.textContent = '採用しています…'
      }
    })
  </script>

  <h2>公式画像の利用</h2>

  {
    events.map((event) => {
      const displayImage = resolveEventDisplayImage({
        id: event.id,
        image_url: event.image_url,
        image_usage_status: usageStatusOf(event),
        image_credit: event.image_credit,
        category: event.category,
      })
      return (
        <article class="admin-panel image-card" id={`event-${event.id}`}>
          <div class="image-card-head">
            <img src={displayImage.src} alt="" width="120" height="80" loading="lazy" />
            <div>
              <h2>
                <a href={`/admin/events/${event.id}/`}>{event.title}</a>
              </h2>
              <p class="hint">
                status: {usageStatusOf(event)} · display: {displayImage.kind}
              </p>
            </div>
          </div>
          <form method="POST" action="/admin/events/">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <input type="hidden" name="intent" value="image_usage_update" />
            <input type="hidden" name="event_id" value={String(event.id)} />
            {event.image_source && (
              <input type="hidden" name="image_source" value={event.image_source} />
            )}
            <label>
              image_usage_status
              <select name="image_usage_status">
                {IMAGE_USAGE_STATUSES.map((s) => (
                  <option value={s} selected={usageStatusOf(event) === s}>
                    {s}
                  </option>
                ))}
              </select>
            </label>
            <label>
              image_credit
              <input type="text" name="image_credit" value={event.image_credit ?? ''} />
            </label>
            <button type="submit">更新</button>
          </form>
        </article>
      )
    })
  }
</AdminLayout>

<style>
  .approve-displayed__count {
    margin: 0 0 0.75rem;
    font-weight: 700;
  }

  #approve-displayed-form {
    margin-bottom: 1.25rem;
  }

  #approve-displayed-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .image-card-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .image-card img {
    object-fit: cover;
    border-radius: 4px;
    background: #eee;
  }

  .image-card label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .image-card select,
  .image-card input,
  .image-card textarea {
    display: block;
    margin-top: 0.25rem;
    min-width: min(100%, 24rem);
    padding: 0.35rem;
  }

  .image-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
  }
</style>
