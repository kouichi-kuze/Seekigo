---
import AdminLayout from '../../../../../layouts/AdminLayout.astro'
import { adminDevNotFoundResponse } from '../../../../../lib/admin/dev-guard'
import { getOrCreateAdminCsrfToken } from '../../../../../lib/admin-security'
import { formatFieldValueForDisplay } from '../../../../../lib/event-field-review'

if (!import.meta.env.DEV) {
  return adminDevNotFoundResponse()
}

const { createAdminClient } = await import('../../../../../lib/supabase-admin')
const csrfToken = getOrCreateAdminCsrfToken(Astro.cookies)

type FieldReviewRow = {
  id: number
  event_id: number
  source_name: string
  source_url: string | null
  field_name: string
  current_value: unknown
  proposed_value: unknown
  status: string
  reason: string | null
  created_at: string | null
  event_title?: string | null
  event_slug?: string | null
}

let fieldReviews: FieldReviewRow[] = []
let loadError: string | null = null
let message: string | null = null

const sp = Astro.url.searchParams
if (sp.get('field') === 'accepted') {
  message = `採用しました (review_id=${sp.get('review_id') ?? '?'}, field=${sp.get('fname') ?? '?'})`
} else if (sp.get('field') === 'rejected') {
  message = `却下しました (review_id=${sp.get('review_id') ?? '?'})`
}

try {
  const admin = createAdminClient()
  const { data: fieldData, error: fieldErr } = await admin
    .from('event_field_reviews')
    .select(
      'id, event_id, source_name, source_url, field_name, current_value, proposed_value, status, reason, created_at',
    )
    .eq('status', 'pending')
    .order('created_at', { ascending: false })

  if (fieldErr) throw fieldErr

  const pendingFields = (fieldData ?? []) as FieldReviewRow[]
  const fieldEventIds = [
    ...new Set(
      pendingFields
        .map((r) => Number(r.event_id))
        .filter((n) => Number.isFinite(n) && n > 0),
    ),
  ]
  const titlesById = new Map<number, { title: string | null; slug: string | null }>()
  if (fieldEventIds.length > 0) {
    const { data: evs, error: evErr } = await admin
      .from('events')
      .select('id, title, slug')
      .in('id', fieldEventIds)
    if (evErr) throw evErr
    for (const e of evs ?? []) {
      titlesById.set(Number(e.id), {
        title: e.title ?? null,
        slug: e.slug ?? null,
      })
    }
  }
  fieldReviews = pendingFields.map((r) => {
    const meta = titlesById.get(Number(r.event_id))
    return {
      ...r,
      event_title: meta?.title ?? null,
      event_slug: meta?.slug ?? null,
    }
  })
} catch (e) {
  loadError = e instanceof Error ? e.message : String(e)
}
---

<AdminLayout title="Field Reviews" csrfToken={csrfToken}>
  <h1>Field Reviews</h1>
  <p class="hint">
    published exact 時のフィールド差分。sync は本体を変更しません。
  </p>
  {message && <p class="ok">{message}</p>}
  {loadError && <p class="err">{loadError}</p>}

  {fieldReviews.length === 0 && !loadError && (
    <p>現在、pending の変更候補はありません。</p>
  )}

  <div class="field-review-list">
    {
      fieldReviews.map((fr) => (
        <article class="field-review-card admin-panel">
          <div class="field-review-meta">
            <span class="badge">{fr.field_name}</span>
            <span>source: {fr.source_name}</span>
            <span>
              <a href={`/admin/events/${fr.event_id}/`}>event #{fr.event_id}</a>
            </span>
            {fr.event_slug && (
              <a href={`/tokyo/event/${fr.event_slug}/`} target="_blank" rel="noopener">
                公開 ↗
              </a>
            )}
          </div>
          <h2>{fr.event_title ?? `(event ${fr.event_id})`}</h2>
          {fr.reason && <p>{fr.reason}</p>}
          <div class="field-diff">
            <div>
              <h3>現在値</h3>
              <pre>{formatFieldValueForDisplay(fr.current_value)}</pre>
            </div>
            <div>
              <h3>提案値</h3>
              <pre>{formatFieldValueForDisplay(fr.proposed_value)}</pre>
            </div>
          </div>
          <div class="actions">
            <form method="POST" action="/admin/events/">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="field_accept" />
              <input type="hidden" name="review_id" value={String(fr.id)} />
              <button type="submit">採用</button>
            </form>
            <form method="POST" action="/admin/events/">
              <input type="hidden" name="csrf_token" value={csrfToken} />
              <input type="hidden" name="intent" value="field_reject" />
              <input type="hidden" name="review_id" value={String(fr.id)} />
              <button type="submit">却下</button>
            </form>
          </div>
        </article>
      ))
    }
  </div>
</AdminLayout>

<style>
  .field-review-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-review-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #555;
  }

  .badge {
    background: #e8f1ff;
    color: #0b6bcb;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .field-diff {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0.75rem 0;
  }

  pre {
    white-space: pre-wrap;
    word-break: break-word;
    background: #f8fafc;
    padding: 0.5rem;
    border: 1px solid #e2e8f0;
    font-size: 0.85rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 700px) {
    .field-diff {
      grid-template-columns: 1fr;
    }
  }
</style>
