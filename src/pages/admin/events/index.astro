---
/**
 * 開発用 Draft 承認 + 重複候補レビュー画面（astro dev 専用）。
 * - static build / 本番では Service Role を import せず 404 のみ出力
 * - Service Role は DEV 時のみ動的 import（createAdminClient）
 * - POST は Vite middleware（astro.config.mjs）経由
 */
if (!import.meta.env.DEV) {
  return new Response('Not Found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'X-Robots-Tag': 'noindex, nofollow',
    },
  })
}

const { createAdminClient } = await import('../../../lib/supabase-admin')
const { getOrCreateAdminCsrfToken } = await import('../../../lib/admin-security')
const { IMAGE_USAGE_STATUSES } = await import('../../../lib/event-image-usage')
const { resolveEventDisplayImage } = await import('../../../lib/event-image-usage')
const { formatFieldValueForDisplay } = await import(
  '../../../lib/event-field-review'
)

type AdminEvent = {
  id: number | string
  title: string | null
  slug: string | null
  area: string | null
  start_date: string | null
  end_date: string | null
  venue: string | null
  address?: string | null
  category: string[] | null
  summary: string | null
  source_url: string | null
  official_url: string | null
  status: string | null
  image_url?: string | null
  image_usage_status?: string | null
  image_source?: string | null
  image_credit?: string | null
}

type IncomingPayload = {
  title?: string | null
  start_date?: string | null
  end_date?: string | null
  venue?: string | null
  area?: string | null
  address?: string | null
  official_url?: string | null
  source_url?: string | null
  price_text?: string | null
  summary?: string | null
  image_url?: string | null
}

type ReviewRow = {
  id: number
  status: string
  incoming_source_name: string
  incoming_source_url: string
  incoming_payload: IncomingPayload
  candidate_event_id: number | null
  duplicate_status: string
  reason: string | null
  scores: Record<string, unknown> | null
  created_at: string | null
  candidate?: AdminEvent | null
}

let message: string | null = null
let errorMessage: string | null = Astro.url.searchParams.get('error')

const csrfToken = getOrCreateAdminCsrfToken(Astro.cookies)

const publishedCount = Astro.url.searchParams.get('published')
const publishedTitle = Astro.url.searchParams.get('title')
const bulkCount = Astro.url.searchParams.get('bulk')
const reviewResult = Astro.url.searchParams.get('review')
const reviewEventId = Astro.url.searchParams.get('event_id')
const imageUpdated = Astro.url.searchParams.get('image')
const imageStatus = Astro.url.searchParams.get('status')

if (bulkCount && !message) {
  const n = Number(bulkCount)
  if (Number.isFinite(n) && n >= 0) {
    message = `${n}件をPublishしました`
  }
} else if (publishedCount && !message) {
  message = publishedTitle
    ? `Published: ${publishedTitle}`
    : '1件をPublishしました'
} else if (reviewResult === 'linked') {
  message = `同一イベントとして紐付けました (event_id=${reviewEventId ?? '?'})`
} else if (reviewResult === 'created') {
  message = `別イベントとして draft 登録しました (event_id=${reviewEventId ?? '?'})`
} else if (reviewResult === 'rejected') {
  message = 'この候補を登録しない（rejected）にしました'
} else if (imageUpdated === 'updated') {
  message = `画像利用ステータスを更新しました (event_id=${reviewEventId ?? '?'}, status=${imageStatus ?? '?'})`
} else if (imageUpdated === 'bulk') {
  const n = Astro.url.searchParams.get('count')
  message = `${n ?? '?'}件の画像利用ステータスを一括更新しました (status=${imageStatus ?? '?'})`
} else if (Astro.url.searchParams.get('field') === 'accepted') {
  message = `フィールド変更を採用しました (review_id=${Astro.url.searchParams.get('review_id') ?? '?'}, field=${Astro.url.searchParams.get('fname') ?? '?'})`
} else if (Astro.url.searchParams.get('field') === 'rejected') {
  message = `フィールド変更を却下しました (review_id=${Astro.url.searchParams.get('review_id') ?? '?'})`
}

type FieldReviewRow = {
  id: number
  event_id: number
  source_name: string
  source_url: string | null
  field_name: string
  current_value: unknown
  proposed_value: unknown
  status: string
  reason: string | null
  created_at: string | null
  event_title?: string | null
  event_slug?: string | null
}

let events: AdminEvent[] = []
let publishedImageEvents: AdminEvent[] = []
let reviews: ReviewRow[] = []
let fieldReviews: FieldReviewRow[] = []
let loadError: string | null = null

const EVENT_SELECT_BASE =
  'id, title, slug, area, start_date, end_date, venue, address, category, summary, source_url, official_url, status'
const EVENT_SELECT_WITH_IMAGE =
  `${EVENT_SELECT_BASE}, image_url, image_usage_status, image_source, image_credit`

try {
  const admin = createAdminClient()

  try {
    const { data, error } = await admin
      .from('events')
      .select(EVENT_SELECT_WITH_IMAGE)
      .eq('status', 'draft')
      .order('start_date', { ascending: true })
    if (error) throw error
    events = (data ?? []) as AdminEvent[]
  } catch (draftImgError) {
    // カラム未追加時は従来カラムのみで継続
    errorMessage =
      (errorMessage ? `${errorMessage} / ` : '') +
      `Draft image columns: ${
        draftImgError instanceof Error
          ? draftImgError.message
          : String(draftImgError)
      }`
    const { data, error } = await admin
      .from('events')
      .select(EVENT_SELECT_BASE)
      .eq('status', 'draft')
      .order('start_date', { ascending: true })
    if (error) throw error
    events = (data ?? []) as AdminEvent[]
  }

  try {
    const { data: pubImgs, error: pubErr } = await admin
      .from('events')
      .select(EVENT_SELECT_WITH_IMAGE)
      .eq('status', 'published')
      .not('image_url', 'is', null)
      .order('id', { ascending: true })
    if (pubErr) throw pubErr
    publishedImageEvents = (pubImgs ?? []) as AdminEvent[]
  } catch (pubLoadError) {
    // カラム未追加時でも Draft Publish は使えるようにする
    errorMessage =
      (errorMessage ? `${errorMessage} / ` : '') +
      `Published image load: ${
        pubLoadError instanceof Error
          ? pubLoadError.message
          : String(pubLoadError)
      }`
  }

  try {
    const { data: reviewData, error: reviewError } = await admin
      .from('event_dedupe_reviews')
      .select(
        'id, status, incoming_source_name, incoming_source_url, incoming_payload, candidate_event_id, duplicate_status, reason, scores, created_at',
      )
      .eq('status', 'pending')
      .order('created_at', { ascending: false })

    if (reviewError) throw reviewError

    const pending = (reviewData ?? []) as ReviewRow[]
    const candidateIds = [
      ...new Set(
        pending
          .map((r) => Number(r.candidate_event_id))
          .filter((n) => Number.isFinite(n) && n > 0),
      ),
    ]

    const candidatesById = new Map<number, AdminEvent>()
    if (candidateIds.length > 0) {
      const { data: candidates, error: candErr } = await admin
        .from('events')
        .select(
          'id, title, slug, area, start_date, end_date, venue, address, category, summary, source_url, official_url, status',
        )
        .in('id', candidateIds)

      if (candErr) throw candErr
      for (const c of candidates ?? []) {
        candidatesById.set(Number(c.id), c as AdminEvent)
      }
    }

    reviews = pending.map((r) => ({
      ...r,
      candidate:
        r.candidate_event_id != null
          ? (candidatesById.get(Number(r.candidate_event_id)) ?? null)
          : null,
    }))
  } catch (reviewLoadError) {
    // テーブル未作成時でも Draft Publish は使えるようにする
    errorMessage =
      (errorMessage ? `${errorMessage} / ` : '') +
      `Review load: ${
        reviewLoadError instanceof Error
          ? reviewLoadError.message
          : String(reviewLoadError)
      }`
  }

  try {
    const { data: fieldData, error: fieldErr } = await admin
      .from('event_field_reviews')
      .select(
        'id, event_id, source_name, source_url, field_name, current_value, proposed_value, status, reason, created_at',
      )
      .eq('status', 'pending')
      .order('created_at', { ascending: false })

    if (fieldErr) throw fieldErr

    const pendingFields = (fieldData ?? []) as FieldReviewRow[]
    const fieldEventIds = [
      ...new Set(
        pendingFields
          .map((r) => Number(r.event_id))
          .filter((n) => Number.isFinite(n) && n > 0),
      ),
    ]
    const titlesById = new Map<number, { title: string | null; slug: string | null }>()
    if (fieldEventIds.length > 0) {
      const { data: evs, error: evErr } = await admin
        .from('events')
        .select('id, title, slug')
        .in('id', fieldEventIds)
      if (evErr) throw evErr
      for (const e of evs ?? []) {
        titlesById.set(Number(e.id), {
          title: e.title ?? null,
          slug: e.slug ?? null,
        })
      }
    }
    fieldReviews = pendingFields.map((r) => {
      const meta = titlesById.get(Number(r.event_id))
      return {
        ...r,
        event_title: meta?.title ?? null,
        event_slug: meta?.slug ?? null,
      }
    })
  } catch (fieldLoadError) {
    errorMessage =
      (errorMessage ? `${errorMessage} / ` : '') +
      `Field review load: ${
        fieldLoadError instanceof Error
          ? fieldLoadError.message
          : String(fieldLoadError)
      }`
  }
} catch (error) {
  loadError = error instanceof Error ? error.message : String(error)
}

function scoreText(scores: Record<string, unknown> | null | undefined): string {
  if (!scores || typeof scores !== 'object') return '—'
  const title = scores.title_similarity
  const venue = scores.venue_similarity
  const date = scores.date_overlap_ratio
  const area = scores.area_match
  const parts = [
    title != null ? `title=${title}` : null,
    venue != null ? `venue=${venue}` : null,
    date != null ? `date=${date}` : null,
    area != null ? `area_match=${area}` : null,
  ].filter(Boolean)
  return parts.length > 0 ? parts.join(' · ') : JSON.stringify(scores)
}

function displayVal(value: unknown): string {
  if (value == null || value === '') return '—'
  return String(value)
}

function usageStatusOf(event: AdminEvent): string {
  return event.image_usage_status?.trim() || 'unknown'
}

function eventDisplayImage(event: AdminEvent) {
  return resolveEventDisplayImage({
    image_url: event.image_url,
    image_usage_status: usageStatusOf(event),
    image_credit: event.image_credit,
    category: event.category,
  })
}
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Draft Events Admin (DEV) | Seekigo</title>
  </head>

  <body>
    <main class="admin" data-csrf={csrfToken}>
      <p class="dev-banner">
        DEV ONLY — ローカル astro dev 専用です。本番 dist / Xserver には管理機能を含めません。
      </p>

      <header>
        <h1>Draft Events</h1>
        <p>
          自動取得イベント（status = draft）を確認し、Publish で公開します。
        </p>
        <p>
          <a href="/tokyo/">公開一覧 /tokyo/ を開く</a>
          · draft {events.length} 件
          · pending dedupe {reviews.length} 件
          · pending field {fieldReviews.length} 件
        </p>
      </header>

      {message && <p class="ok">{message}</p>}
      {errorMessage && <p class="err">{errorMessage}</p>}
      {loadError && <p class="err">Load error: {loadError}</p>}

      {(events.length > 0 || publishedImageEvents.length > 0) && (
        <div class="usage-filter-bar">
          <label class="filter-label">
            image_usage_status
            <select id="usage-filter">
              <option value="all">all</option>
              {IMAGE_USAGE_STATUSES.map((s) => (
                <option value={s}>{s}</option>
              ))}
            </select>
          </label>
          <button type="button" class="btn-filter-quick" id="filter-unknown-only">
            unknown のみ
          </button>
          <span id="filter-visible-count" class="filter-count" />
        </div>
      )}

      <section class="review-section" id="dedupe-reviews">
        <h2>重複候補レビュー</h2>
        <p class="section-note">
          likely / ambiguous のみ。exact は自動 attach、none は draft 作成済みです。
          published 本体は紐付け時も変更しません。
        </p>

        {!loadError && reviews.length === 0 && (
          <p>現在、pending の重複候補はありません。</p>
        )}

        <div class="review-list">
          {reviews.map((review) => {
            const incoming = review.incoming_payload ?? {}
            const candidate = review.candidate
            return (
              <article class="review-card">
                <div class="review-meta">
                  <span class={`badge badge-${review.duplicate_status}`}>
                    {review.duplicate_status}
                  </span>
                  <span class="meta-item">
                    source: {review.incoming_source_name}
                  </span>
                  <span class="meta-item">
                    title score:{' '}
                    {String(review.scores?.title_similarity ?? '—')}
                  </span>
                  <span class="meta-item">
                    venue score:{' '}
                    {String(review.scores?.venue_similarity ?? '—')}
                  </span>
                  <span class="meta-item">scores: {scoreText(review.scores)}</span>
                  <span class="meta-item">
                    candidate_id: {String(review.candidate_event_id ?? '—')}
                  </span>
                </div>
                <p class="reason">{review.reason ?? '—'}</p>

                <div class="compare">
                  <div class="compare-col">
                    <h3>Incoming（取得元）</h3>
                    <dl>
                      <div>
                        <dt>タイトル</dt>
                        <dd>{displayVal(incoming.title)}</dd>
                      </div>
                      <div>
                        <dt>開催日</dt>
                        <dd>{displayVal(incoming.start_date)}</dd>
                      </div>
                      <div>
                        <dt>終了日</dt>
                        <dd>{displayVal(incoming.end_date)}</dd>
                      </div>
                      <div>
                        <dt>会場</dt>
                        <dd>{displayVal(incoming.venue)}</dd>
                      </div>
                      <div>
                        <dt>area</dt>
                        <dd>{displayVal(incoming.area)}</dd>
                      </div>
                      <div>
                        <dt>住所</dt>
                        <dd>{displayVal(incoming.address)}</dd>
                      </div>
                      <div>
                        <dt>公式URL</dt>
                        <dd>
                          {incoming.official_url ? (
                            <a
                              href={incoming.official_url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {incoming.official_url}
                            </a>
                          ) : (
                            '—'
                          )}
                        </dd>
                      </div>
                      <div>
                        <dt>source URL</dt>
                        <dd>
                          <a
                            href={review.incoming_source_url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {review.incoming_source_url}
                          </a>
                        </dd>
                      </div>
                    </dl>
                  </div>

                  <div class="compare-col">
                    <h3>
                      Candidate（既存
                      {candidate?.status ? ` · ${candidate.status}` : ''}）
                    </h3>
                    {!candidate ? (
                      <p class="err">候補イベントが見つかりません</p>
                    ) : (
                      <dl>
                        <div>
                          <dt>タイトル</dt>
                          <dd>{displayVal(candidate.title)}</dd>
                        </div>
                        <div>
                          <dt>開催日</dt>
                          <dd>{displayVal(candidate.start_date)}</dd>
                        </div>
                        <div>
                          <dt>終了日</dt>
                          <dd>{displayVal(candidate.end_date)}</dd>
                        </div>
                        <div>
                          <dt>会場</dt>
                          <dd>{displayVal(candidate.venue)}</dd>
                        </div>
                        <div>
                          <dt>area</dt>
                          <dd>{displayVal(candidate.area)}</dd>
                        </div>
                        <div>
                          <dt>住所</dt>
                          <dd>{displayVal(candidate.address)}</dd>
                        </div>
                        <div>
                          <dt>公式URL</dt>
                          <dd>
                            {candidate.official_url ? (
                              <a
                                href={candidate.official_url}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                {candidate.official_url}
                              </a>
                            ) : (
                              '—'
                            )}
                          </dd>
                        </div>
                        <div>
                          <dt>source URL</dt>
                          <dd>
                            {candidate.source_url ? (
                              <a
                                href={candidate.source_url}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                {candidate.source_url}
                              </a>
                            ) : (
                              '—'
                            )}
                          </dd>
                        </div>
                        <div>
                          <dt>slug / id</dt>
                          <dd>
                            {displayVal(candidate.slug)} / {String(candidate.id)}
                          </dd>
                        </div>
                      </dl>
                    )}
                  </div>
                </div>

                <div class="review-actions">
                  <form method="POST" class="inline-form">
                    <input type="hidden" name="csrf_token" value={csrfToken} />
                    <input type="hidden" name="intent" value="dedupe_link" />
                    <input
                      type="hidden"
                      name="review_id"
                      value={String(review.id)}
                    />
                    <button type="submit" class="btn-link">
                      同一イベントとして紐付け
                    </button>
                  </form>
                  <form method="POST" class="inline-form">
                    <input type="hidden" name="csrf_token" value={csrfToken} />
                    <input type="hidden" name="intent" value="dedupe_create" />
                    <input
                      type="hidden"
                      name="review_id"
                      value={String(review.id)}
                    />
                    <button type="submit" class="btn-create">
                      別イベントとしてdraft登録
                    </button>
                  </form>
                  <form method="POST" class="inline-form">
                    <input type="hidden" name="csrf_token" value={csrfToken} />
                    <input type="hidden" name="intent" value="dedupe_reject" />
                    <input
                      type="hidden"
                      name="review_id"
                      value={String(review.id)}
                    />
                    <button type="submit" class="btn-reject">
                      今回は登録しない
                    </button>
                  </form>
                </div>
              </article>
            )
          })}
        </div>
      </section>

      <hr class="divider" />

      <section class="review-section" id="field-reviews">
        <h2>公開済みイベント 変更候補</h2>
        <p class="section-note">
          published exact 時のフィールド差分のみ。sync は本体を変更しません。1項目ずつ採用 / 却下してください。
          summary / title / image は対象外です。
        </p>

        {fieldReviews.length === 0 && (
          <p>現在、pending の変更候補はありません。</p>
        )}

        <div class="field-review-list">
          {fieldReviews.map((fr) => (
            <article class="field-review-card">
              <div class="field-review-meta">
                <span class="badge badge-field">{fr.field_name}</span>
                <span class="meta-item">source: {fr.source_name}</span>
                <span class="meta-item">event_id: {String(fr.event_id)}</span>
                {fr.event_slug && (
                  <span class="meta-item">
                    <a href={`/tokyo/event/${fr.event_slug}/`} target="_blank" rel="noopener noreferrer">
                      {fr.event_slug}
                    </a>
                  </span>
                )}
              </div>
              <h3 class="field-review-title">
                {fr.event_title ?? `(event ${fr.event_id})`}
              </h3>
              {fr.reason && <p class="reason">{fr.reason}</p>}
              {fr.source_url && (
                <p class="meta-item">
                  source_url:{' '}
                  <a
                    href={fr.source_url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {fr.source_url}
                  </a>
                </p>
              )}
              <div class="field-diff">
                <div class="field-diff__col field-diff__col--current">
                  <h4>現在値</h4>
                  <pre class="field-diff__value">{formatFieldValueForDisplay(fr.current_value)}</pre>
                </div>
                <div class="field-diff__arrow" aria-hidden="true">→</div>
                <div class="field-diff__col field-diff__col--proposed">
                  <h4>新しい値</h4>
                  <pre class="field-diff__value">{formatFieldValueForDisplay(fr.proposed_value)}</pre>
                </div>
              </div>
              <div class="review-actions">
                <form method="POST" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="field_accept" />
                  <input
                    type="hidden"
                    name="review_id"
                    value={String(fr.id)}
                  />
                  <button type="submit" class="btn-create">
                    この変更を採用
                  </button>
                </form>
                <form method="POST" class="inline-form">
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input type="hidden" name="intent" value="field_reject" />
                  <input
                    type="hidden"
                    name="review_id"
                    value={String(fr.id)}
                  />
                  <button type="submit" class="btn-reject">
                    この変更を却下
                  </button>
                </form>
              </div>
            </article>
          ))}
        </div>
      </section>

      <hr class="divider" />

      <section id="draft-list">
        <h2>Draft 一覧</h2>

      {!loadError && events.length === 0 && (
        <p>現在、draft のイベントはありません。</p>
      )}

      {/* 一括 Publish 用フォーム（チェックボックスは form 属性で紐付け） */}
      {events.length > 0 && (
        <form method="POST" id="bulk-form">
          <input type="hidden" name="csrf_token" value={csrfToken} />
          <input type="hidden" name="intent" value="publish_selected" />

          <div class="toolbar" id="bulk-toolbar">
            <label class="select-all">
              <input type="checkbox" id="select-all" />
              全選択
            </label>
            <span id="selected-count" class="selected-count">0件選択</span>
            <button type="submit" id="bulk-publish" disabled>
              選択したイベントをPublish
            </button>
          </div>
        </form>
      )}

      <div class="list" id="draft-event-list">
        {events.map((event) => {
          const displayImage = eventDisplayImage(event)
          return (
          <article
            class="card event-row"
            id={`event-${event.id}`}
            data-event-id={String(event.id)}
            data-usage-status={usageStatusOf(event)}
            data-event-status={event.status ?? 'draft'}
          >
            <label class="row-select">
              <input
                type="checkbox"
                name="event_ids"
                value={String(event.id)}
                class="event-select row-check"
                form="bulk-form"
              />
              <span class="sr-only">選択: {event.title}</span>
            </label>

            <div class="card-body">
              <div class="card-head">
                <div class="event-thumb" data-thumb-kind={displayImage.kind}>
                  <img
                    src={displayImage.src}
                    alt=""
                    loading="lazy"
                    width="120"
                    height="80"
                    class="event-thumb-img"
                  />
                  <span class="thumb-kind">{displayImage.kind}</span>
                </div>
                <div class="card-head-text">
                  <h2>{event.title}</h2>
                </div>
              </div>

              <dl>
                <div>
                  <dt>area</dt>
                  <dd>{event.area ?? 'null'}</dd>
                </div>
                <div>
                  <dt>start_date</dt>
                  <dd>{event.start_date ?? 'null'}</dd>
                </div>
                <div>
                  <dt>end_date</dt>
                  <dd>{event.end_date ?? 'null'}</dd>
                </div>
                <div>
                  <dt>venue</dt>
                  <dd>{event.venue ?? 'null'}</dd>
                </div>
                <div>
                  <dt>category</dt>
                  <dd>
                    {Array.isArray(event.category)
                      ? event.category.join(', ')
                      : 'null'}
                  </dd>
                </div>
                <div>
                  <dt>summary</dt>
                  <dd>{event.summary ?? 'null'}</dd>
                </div>
                <div>
                  <dt>source_url</dt>
                  <dd>
                    {event.source_url ? (
                      <a
                        href={event.source_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {event.source_url}
                      </a>
                    ) : (
                      'null'
                    )}
                  </dd>
                </div>
                <div>
                  <dt>official_url</dt>
                  <dd>
                    {event.official_url ? (
                      <a
                        href={event.official_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {event.official_url}
                      </a>
                    ) : (
                      'null'
                    )}
                  </dd>
                </div>
                <div>
                  <dt>slug</dt>
                  <dd>{event.slug ?? 'null'}</dd>
                </div>
                <div>
                  <dt>id</dt>
                  <dd>{String(event.id)}</dd>
                </div>
              </dl>

              <div class="image-meta">
                <h3>画像利用</h3>
                <dl class="image-dl">
                  <div>
                    <dt>image_url</dt>
                    <dd>
                      {event.image_url ? (
                        <a
                          href={event.image_url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {event.image_url}
                        </a>
                      ) : (
                        'null'
                      )}
                    </dd>
                  </div>
                  <div>
                    <dt>image_source</dt>
                    <dd>{displayVal(event.image_source)}</dd>
                  </div>
                  <div>
                    <dt>image_usage_status</dt>
                    <dd class="usage-status-display">
                      {displayVal(event.image_usage_status ?? 'unknown')}
                    </dd>
                  </div>
                  <div>
                    <dt>image_credit</dt>
                    <dd>{displayVal(event.image_credit)}</dd>
                  </div>
                </dl>
                <p class="image-note">
                  一覧画像は公開側と同じ resolveEventDisplayImage() を使用（許可外は category / generic フォールバック）。
                </p>
                <form method="POST" class="image-form" data-event-id={String(event.id)}>
                  <input type="hidden" name="csrf_token" value={csrfToken} />
                  <input
                    type="hidden"
                    name="intent"
                    value="image_usage_update"
                  />
                  <input
                    type="hidden"
                    name="event_id"
                    value={String(event.id)}
                  />
                  {event.image_source && (
                    <input
                      type="hidden"
                      name="image_source"
                      value={event.image_source}
                    />
                  )}
                  <label>
                    利用状態
                    <select name="image_usage_status" class="usage-select">
                      {IMAGE_USAGE_STATUSES.map((s) => (
                        <option value={s} selected={usageStatusOf(event) === s}>
                          {s}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="credit-field">
                    image_credit（licensed / organizer_granted 時のみ任意）
                    <input
                      type="text"
                      name="image_credit"
                      value={event.image_credit ?? ''}
                      placeholder="クレジット表記"
                    />
                  </label>
                  <button type="submit" class="btn-image-update">画像利用を更新</button>
                  <span class="row-flash" aria-live="polite" hidden />
                </form>
              </div>

              <form method="POST" class="publish-form">
                <input type="hidden" name="csrf_token" value={csrfToken} />
                <input type="hidden" name="intent" value="publish" />
                <input type="hidden" name="event_id" value={String(event.id)} />
                <button type="submit">Publish（この1件）</button>
              </form>
            </div>
          </article>
          )
        })}
      </div>
      </section>

      {publishedImageEvents.length > 0 && (
        <>
          <hr class="divider" />
          <section id="published-image-list">
            <h2>Published 画像ステータス（手動のみ）</h2>
            <p class="hint">
              sync は published の image_* を変更しません。利用許諾の確定はここでのみ行います。
            </p>
            <div class="list">
              {publishedImageEvents.map((event) => {
                const displayImage = eventDisplayImage(event)
                return (
                <article
                  class="card card--published-image event-row"
                  id={`event-${event.id}`}
                  data-event-id={String(event.id)}
                  data-usage-status={usageStatusOf(event)}
                  data-event-status="published"
                >
                  <label class="row-select">
                    <input
                      type="checkbox"
                      value={String(event.id)}
                      class="event-select"
                    />
                    <span class="sr-only">選択: {event.title}</span>
                  </label>
                  <div class="card-body">
                    <div class="card-head">
                      <div class="event-thumb" data-thumb-kind={displayImage.kind}>
                        <img
                          src={displayImage.src}
                          alt=""
                          loading="lazy"
                          width="120"
                          height="80"
                          class="event-thumb-img"
                        />
                        <span class="thumb-kind">{displayImage.kind}</span>
                      </div>
                      <div class="card-head-text">
                        <h2>
                          {event.title}
                          <span class="pub-badge">published</span>
                        </h2>
                      </div>
                    </div>
                    <dl class="image-dl">
                      <div>
                        <dt>id / slug</dt>
                        <dd>
                          {String(event.id)} / {displayVal(event.slug)}
                        </dd>
                      </div>
                      <div>
                        <dt>image_url</dt>
                        <dd>
                          {event.image_url ? (
                            <a
                              href={event.image_url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {event.image_url}
                            </a>
                          ) : (
                            'null'
                          )}
                        </dd>
                      </div>
                      <div>
                        <dt>image_source</dt>
                        <dd>{displayVal(event.image_source)}</dd>
                      </div>
                      <div>
                        <dt>image_usage_status</dt>
                        <dd class="usage-status-display">
                          {displayVal(event.image_usage_status ?? 'unknown')}
                        </dd>
                      </div>
                      <div>
                        <dt>image_credit</dt>
                        <dd>{displayVal(event.image_credit)}</dd>
                      </div>
                    </dl>
                    <form method="POST" class="image-form" data-event-id={String(event.id)}>
                      <input
                        type="hidden"
                        name="csrf_token"
                        value={csrfToken}
                      />
                      <input
                        type="hidden"
                        name="intent"
                        value="image_usage_update"
                      />
                      <input
                        type="hidden"
                        name="event_id"
                        value={String(event.id)}
                      />
                      {event.image_source && (
                        <input
                          type="hidden"
                          name="image_source"
                          value={event.image_source}
                        />
                      )}
                      <label>
                        利用状態
                        <select name="image_usage_status" class="usage-select">
                          {IMAGE_USAGE_STATUSES.map((s) => (
                            <option
                              value={s}
                              selected={usageStatusOf(event) === s}
                            >
                              {s}
                            </option>
                          ))}
                        </select>
                      </label>
                      <label class="credit-field">
                        image_credit（licensed / organizer_granted 時のみ任意）
                        <input
                          type="text"
                          name="image_credit"
                          value={event.image_credit ?? ''}
                          placeholder="クレジット表記"
                        />
                      </label>
                      <button type="submit" class="btn-image-update">画像利用を更新</button>
                      <span class="row-flash" aria-live="polite" hidden />
                    </form>
                  </div>
                </article>
                )
              })}
            </div>
          </section>
        </>
      )}

      {(events.length > 0 || publishedImageEvents.length > 0) && (
        <div class="image-action-bar" id="image-action-bar">
          <div class="image-action-bar__inner">
            <label class="select-all">
              <input type="checkbox" id="select-all-visible" />
              表示中をすべて選択
            </label>
            <span id="image-selected-count" class="selected-count">0件選択</span>
            <label class="bulk-usage-label">
              一括ステータス
              <select id="bulk-usage-status" class="usage-select">
                {IMAGE_USAGE_STATUSES.map((s) => (
                  <option value={s}>{s}</option>
                ))}
              </select>
            </label>
            <button type="button" id="bulk-usage-apply" disabled>
              選択した0件の画像利用を更新
            </button>
            <span id="bulk-action-feedback" class="bulk-action-feedback" aria-live="polite" />
          </div>
        </div>
      )}
    </main>

    <div id="admin-toast" class="admin-toast" hidden aria-live="polite" />

    <script define:vars={{ imageUsageStatuses: IMAGE_USAGE_STATUSES }}>
      const adminMain = document.querySelector('.admin')
      const csrfToken = adminMain?.getAttribute('data-csrf') ?? ''

      const selectAll = document.getElementById(
        'select-all',
      )
      const selectAllVisible = document.getElementById(
        'select-all-visible',
      )
      const eventSelects = Array.from(
        document.querySelectorAll('.event-select'),
      )
      const countEl = document.getElementById('selected-count')
      const bulkBtn = document.getElementById('bulk-publish')
      const bulkForm = document.getElementById('bulk-form')

      const usageFilter = document.getElementById('usage-filter')
      const filterUnknownBtn = document.getElementById('filter-unknown-only')
      const filterVisibleCount = document.getElementById('filter-visible-count')
      const imageSelectedCount = document.getElementById('image-selected-count')
      const bulkUsageStatus = document.getElementById('bulk-usage-status')
      const bulkUsageApply = document.getElementById('bulk-usage-apply')
      const bulkActionFeedback = document.getElementById('bulk-action-feedback')
      const adminToast = document.getElementById('admin-toast')
      let toastTimer = 0
      let feedbackTimer = 0

      function visibleEventRows() {
        return Array.from(
          document.querySelectorAll('.event-row'),
        ).filter((row) => !row.classList.contains('event-row--hidden'))
      }

      function visibleEventSelects() {
        return visibleEventRows()
          .map((row) =>
            row.querySelector('.event-select'),
          )
          .filter(Boolean)
      }

      function selectedEventSelects() {
        return eventSelects.filter((c) => c.checked)
      }

      function refreshPublishToolbar() {
        const draftChecks = eventSelects.filter(
          (c) => c.classList.contains('row-check'),
        )
        const selected = draftChecks.filter((c) => c.checked)
        if (countEl) countEl.textContent = `${selected.length}件選択`
        if (bulkBtn) bulkBtn.disabled = selected.length === 0
        if (selectAll) {
          selectAll.checked =
            draftChecks.length > 0 && selected.length === draftChecks.length
          selectAll.indeterminate =
            selected.length > 0 && selected.length < draftChecks.length
        }
      }

      function refreshImageToolbar() {
        const selected = selectedEventSelects()
        const n = selected.length
        if (imageSelectedCount) {
          imageSelectedCount.textContent = `${n}件選択`
        }
        if (bulkUsageApply) {
          bulkUsageApply.disabled = n === 0
          bulkUsageApply.textContent = `選択した${n}件の画像利用を更新`
        }
        const visible = visibleEventSelects()
        const visibleSelected = visible.filter((c) => c.checked)
        if (selectAllVisible) {
          selectAllVisible.checked =
            visible.length > 0 && visibleSelected.length === visible.length
          selectAllVisible.indeterminate =
            visibleSelected.length > 0 &&
            visibleSelected.length < visible.length
        }
      }

      function refreshToolbars() {
        refreshPublishToolbar()
        refreshImageToolbar()
      }

      function applyUsageFilter(value) {
        const rows = document.querySelectorAll('.event-row')
        let visible = 0
        for (const row of rows) {
          const status = row.getAttribute('data-usage-status') ?? 'unknown'
          const show = value === 'all' || status === value
          row.classList.toggle('event-row--hidden', !show)
          if (show) visible += 1
        }
        if (filterVisibleCount) {
          filterVisibleCount.textContent = `表示 ${visible} 件`
        }
        refreshToolbars()
      }

      selectAll?.addEventListener('change', () => {
        const on = selectAll.checked
        for (const c of eventSelects) {
          if (c.classList.contains('row-check')) c.checked = on
        }
        refreshToolbars()
      })

      selectAllVisible?.addEventListener('change', () => {
        const on = selectAllVisible.checked
        for (const c of visibleEventSelects()) {
          c.checked = on
        }
        refreshToolbars()
      })

      for (const c of eventSelects) {
        c.addEventListener('change', refreshToolbars)
      }

      usageFilter?.addEventListener('change', () => {
        applyUsageFilter(usageFilter.value)
      })

      filterUnknownBtn?.addEventListener('click', () => {
        if (usageFilter) usageFilter.value = 'unknown'
        applyUsageFilter('unknown')
      })

      bulkForm?.addEventListener('submit', (e) => {
        const selected = eventSelects.filter(
          (c) => c.classList.contains('row-check') && c.checked,
        )
        if (selected.length === 0) {
          e.preventDefault()
          return
        }
        if (
          !confirm(`${selected.length}件を Publish します。よろしいですか？`)
        ) {
          e.preventDefault()
        }
      })

      for (const form of document.querySelectorAll(
        '.review-actions form',
      )) {
        form.addEventListener('submit', (e) => {
          const intent = form.querySelector(
            'input[name="intent"]',
          )?.value
          let msg = '実行しますか？'
          if (intent === 'dedupe_link') {
            msg =
              '同一イベントとして紐付けます（既存本体は変更しません）。よろしいですか？'
          } else if (intent === 'dedupe_create') {
            msg = '別イベントとして draft を新規登録します。よろしいですか？'
          } else if (intent === 'dedupe_reject') {
            msg = 'この候補を登録しない（rejected）にします。よろしいですか？'
          } else if (intent === 'field_accept') {
            msg =
              'この変更を published イベントへ反映します。よろしいですか？'
          } else if (intent === 'field_reject') {
            msg =
              'この変更を却下します（本体は変更しません）。よろしいですか？'
          }
          if (!confirm(msg)) e.preventDefault()
        })
      }

      function syncCreditVisibility(form) {
        const select = form.querySelector('.usage-select')
        const credit = form.querySelector('.credit-field')
        if (!select || !credit) return
        const show =
          select.value === 'licensed' || select.value === 'organizer_granted'
        credit.hidden = !show
      }

      for (const form of document.querySelectorAll('.image-form')) {
        const select = form.querySelector('.usage-select')
        select?.addEventListener('change', () => syncCreditVisibility(form))
        syncCreditVisibility(form)
      }

      function updateRowFromResponse(row, update) {
        const statusEl = row.querySelector('.usage-status-display')
        if (statusEl) {
          statusEl.textContent = update.image_usage_status
        }
        row.setAttribute('data-usage-status', update.image_usage_status)

        const select = row.querySelector('.usage-select')
        if (select) select.value = update.image_usage_status

        const creditInput = row.querySelector('input[name="image_credit"]')
        if (creditInput) {
          creditInput.value = update.image_credit ?? ''
        }

        const thumb = row.querySelector('.event-thumb')
        const img = row.querySelector('.event-thumb-img')
        const kind = row.querySelector('.thumb-kind')
        const display = update.display_image
        if (thumb && img && display) {
          img.src = display.src
          thumb.setAttribute('data-thumb-kind', display.kind)
          if (kind) kind.textContent = display.kind
        }
      }

      function flashRow(row, text) {
        row.classList.add('event-row--updated')
        const flash = row.querySelector('.row-flash')
        if (flash) {
          flash.textContent = text
          flash.hidden = false
        }
        window.setTimeout(() => {
          row.classList.remove('event-row--updated')
          if (flash) {
            flash.hidden = true
            flash.textContent = ''
          }
        }, 2000)
      }

      function showToast(message, isError) {
        if (!adminToast) return
        window.clearTimeout(toastTimer)
        adminToast.textContent = message
        adminToast.classList.toggle('admin-toast--err', Boolean(isError))
        adminToast.classList.toggle('admin-toast--ok', !isError)
        adminToast.hidden = false
        toastTimer = window.setTimeout(() => {
          adminToast.hidden = true
        }, 4000)
      }

      function showBulkFeedback(message) {
        if (!bulkActionFeedback) return
        window.clearTimeout(feedbackTimer)
        bulkActionFeedback.textContent = message
        bulkActionFeedback.classList.add('bulk-action-feedback--visible')
        feedbackTimer = window.setTimeout(() => {
          bulkActionFeedback.textContent = ''
          bulkActionFeedback.classList.remove('bulk-action-feedback--visible')
        }, 3000)
      }

      function formDataToUrlEncoded(formData) {
        const body = new URLSearchParams()
        for (const [key, value] of formData.entries()) {
          body.append(key, typeof value === 'string' ? value : String(value))
        }
        return body
      }

      async function postImageForm(formData) {
        formData.set('ajax', '1')
        if (!formData.get('csrf_token') && csrfToken) {
          formData.set('csrf_token', csrfToken)
        }
        const res = await fetch('/admin/events/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
          body: formDataToUrlEncoded(formData).toString(),
          credentials: 'same-origin',
        })
        const text = await res.text()
        let data
        try {
          data = JSON.parse(text)
        } catch {
          throw new Error(
            `サーバー応答が不正です (HTTP ${res.status})。dev サーバーを再起動してください。`,
          )
        }
        if (!res.ok || !data.ok) {
          throw new Error(data.message ?? `HTTP ${res.status}`)
        }
        return data
      }

      for (const form of document.querySelectorAll('.image-form')) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault()
          const btn = form.querySelector('.btn-image-update')
          const prevBtnLabel = btn?.textContent ?? ''
          if (btn) {
            btn.disabled = true
            btn.textContent = '更新中…'
          }
          try {
            const data = await postImageForm(new FormData(form))
            for (const update of data.updates ?? []) {
              const row = document.getElementById(
                `event-${update.event_id}`,
              )
              if (!row) continue
              updateRowFromResponse(row, update)
              flashRow(row, '更新済み ✓')
            }
            const u = data.updates?.[0]
            if (u) {
              showToast(
                `更新完了 ✓（event_id=${u.event_id} → ${u.image_usage_status}）`,
                false,
              )
            } else {
              showToast('更新完了 ✓', false)
            }
          } catch (err) {
            showToast(
              err instanceof Error ? err.message : String(err),
              true,
            )
          } finally {
            if (btn) {
              btn.disabled = false
              btn.textContent = prevBtnLabel
            }
          }
        })
      }

      bulkUsageApply?.addEventListener('click', async () => {
        const selected = selectedEventSelects()
        if (selected.length === 0) return
        const status = bulkUsageStatus?.value ?? ''
        if (
          !confirm(
            `選択した${selected.length}件の image_usage_status を「${status}」に更新します。よろしいですか？`,
          )
        ) {
          return
        }

        bulkUsageApply.disabled = true
        const prevLabel = bulkUsageApply.textContent
        bulkUsageApply.textContent = '更新中…'
        try {
          const fd = new FormData()
          fd.set('csrf_token', csrfToken)
          fd.set('intent', 'image_usage_bulk')
          fd.set('image_usage_status', status)
          for (const c of selected) {
            fd.append('event_ids', c.value)
          }
          const data = await postImageForm(fd)
          const count = data.updates?.length ?? 0
          for (const update of data.updates ?? []) {
            const row = document.getElementById(`event-${update.event_id}`)
            if (!row) continue
            updateRowFromResponse(row, update)
            flashRow(row, '更新済み ✓')
          }
          const doneMsg = `${count}件の更新が完了しました ✓（→ ${status}）`
          showToast(doneMsg, false)
          showBulkFeedback('更新完了 ✓')
          refreshToolbars()
        } catch (err) {
          showToast(
            `更新に失敗しました: ${err instanceof Error ? err.message : String(err)}`,
            true,
          )
          showBulkFeedback('更新失敗')
        } finally {
          bulkUsageApply.textContent = prevLabel
          bulkUsageApply.disabled = selectedEventSelects().length === 0
        }
      })

      if (location.hash.startsWith('#event-')) {
        const target = document.querySelector(location.hash)
        target?.scrollIntoView({ block: 'center' })
      }

      applyUsageFilter(usageFilter?.value ?? 'all')
      refreshToolbars()
    </script>
  </body>
</html>

<style>
  .admin {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem;
    padding-bottom: 5.5rem;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .admin-toast {
    position: fixed;
    left: 50%;
    bottom: 5.25rem;
    z-index: 40;
    transform: translateX(-50%);
    max-width: min(92vw, 640px);
    margin: 0;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  .admin-toast--ok {
    background: #e8f5e9;
    border: 2px solid #66bb6a;
    color: #1b5e20;
  }

  .admin-toast--err {
    background: #fdecea;
    border: 2px solid #e57373;
    color: #b71c1c;
  }

  .bulk-action-feedback {
    font-weight: 700;
    color: #0a7a32;
    min-width: 5rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .bulk-action-feedback--visible {
    opacity: 1;
  }

  .usage-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 1rem;
    background: #f0f4f8;
    border: 1px solid #cfd8e3;
  }

  .filter-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .filter-count {
    color: #555;
    font-size: 0.95rem;
  }

  .btn-filter-quick {
    padding: 0.35rem 0.75rem;
    font-weight: 600;
    cursor: pointer;
    background: #fff;
    border: 1px solid #bbb;
  }

  .dev-banner {
    background: #fff3cd;
    border: 1px solid #e6c200;
    padding: 0.75rem 1rem;
    font-weight: 600;
  }

  .ok {
    color: #0a7a32;
    font-weight: 600;
  }

  .err {
    color: #a40000;
  }

  .section-note {
    color: #555;
    font-size: 0.95rem;
  }

  .divider {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid #ddd;
  }

