---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { adminDevNotFoundResponse } from '../../../lib/admin/dev-guard'
import { getOrCreateAdminCsrfToken } from '../../../lib/admin-security'
import { fetchAdminDashboardStats } from '../../../lib/admin/queries'

if (!import.meta.env.DEV) {
  return adminDevNotFoundResponse()
}

const { createAdminClient } = await import('../../../lib/supabase-admin')
const csrfToken = getOrCreateAdminCsrfToken(Astro.cookies)

let stats = {
  draft: 0,
  published: 0,
  hidden: 0,
  ended: 0,
  pendingDedupe: 0,
  pendingField: 0,
  pendingImageUnknown: 0,
}
let loadError: string | null = null

try {
  stats = await fetchAdminDashboardStats(createAdminClient())
} catch (e) {
  loadError = e instanceof Error ? e.message : String(e)
}
---

<AdminLayout title="Dashboard" csrfToken={csrfToken}>
  <h1>Dashboard</h1>
  <p class="hint">自動取得を基本とし、手動で最終調整する管理ハブです。</p>

  {loadError && <p class="err">Load error: {loadError}</p>}

  <div class="admin-panel">
    <h2>Events</h2>
    <div class="admin-stats">
      <a href="/admin/events/draft/" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.draft}</div>
        <div class="admin-stat__label">Draft</div>
      </a>
      <a href="/admin/events/published/" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.published}</div>
        <div class="admin-stat__label">Published</div>
      </a>
      <a href="/admin/events/hidden/" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.hidden}</div>
        <div class="admin-stat__label">Hidden</div>
      </a>
      <a href="/admin/events/ended/" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.ended}</div>
        <div class="admin-stat__label">Ended (published)</div>
      </a>
    </div>
  </div>

  <div class="admin-panel">
    <h2>Reviews &amp; Actions</h2>
    <div class="admin-stats">
      <a href="/admin/events/draft/#dedupe-reviews" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.pendingDedupe}</div>
        <div class="admin-stat__label">Dedupe (Draft WS)</div>
      </a>
      <a href="/admin/events/reviews/field/pending/" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.pendingField}</div>
        <div class="admin-stat__label">Field Reviews</div>
      </a>
      <a href="/admin/events/reviews/image/" class="admin-stat admin-stat--link">
        <div class="admin-stat__n">{stats.pendingImageUnknown}</div>
        <div class="admin-stat__label">Image unknown</div>
      </a>
      <a href="/admin/events/draft/" class="admin-stat admin-stat--link">
        <div class="admin-stat__label">Draft workspace →</div>
      </a>
    </div>
  </div>

  <div class="admin-panel">
    <h2>Quick links</h2>
    <ul>
      <li><a href="/admin/events/all/">All Events</a></li>
      <li><a href="/admin/events/sources/">Data Sources</a></li>
      <li><a href="/tokyo/" target="_blank" rel="noopener">公開サイト /tokyo/ ↗</a></li>
    </ul>
  </div>
</AdminLayout>

<style>
  .admin-stat--link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .admin-stat--link:hover {
    border-color: #38bdf8;
    background: #f0f9ff;
  }

  ul {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
