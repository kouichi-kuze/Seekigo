---
/**
 * English event detail foundation (Phase 4C-5 / 4C-6).
 * Structured attrs → fixed EN dictionary.
 * Free text → published event_translations only (else hide; title may fallback JA).
 */
import Layout from '../../../../layouts/Layout.astro'
import { supabase } from '../../../../lib/supabase'
import { isEventEnded } from '../../../../lib/display'
import { resolveEventDisplayImage } from '../../../../lib/event-image-usage'
import EventReactionSummary from '../../../../components/EventReactionSummary.astro'
import EventVisitChecklist from '../../../../components/EventVisitChecklist.astro'
import EventAccess from '../../../../components/EventAccess.astro'
import { fetchPublishedReactionSummary } from '../../../../lib/event-reaction-summary'
import {
  fetchPublishedEventTranslation,
  fetchPublishedReactionTranslation,
} from '../../../../lib/event-translations'
import {
  EVENT_UI_EN,
  formatDurationEn,
  formatEventDateRangeEn,
  formatEventTimeRangeEn,
  formatPriceEn,
  formatReservationStatusEn,
} from '../../../../lib/i18n/event-en'
import { getLocalizedEventPath } from '../../../../lib/i18n/locale'

export async function getStaticPaths() {
  const { data: events } = await supabase
    .from('events')
    .select('slug')
    .eq('status', 'published')
    .not('slug', 'is', null)

  return (events ?? []).map((event) => ({
    params: { slug: event.slug as string },
  }))
}

const { slug } = Astro.params

const { data: event } = await supabase
  .from('events')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .single()

const translation = event
  ? await fetchPublishedEventTranslation(supabase, Number(event.id), 'en')
  : null

const titleEn = translation?.title?.trim() || null
const displayTitle = titleEn || event?.title || ''
const titleLang = titleEn ? 'en' : 'ja'

const summaryEn = translation?.summary?.trim() || null
const ageNoteEn = translation?.age_note?.trim() || null
const priceTextEn = translation?.price_text?.trim() || null
const accessTextEn = translation?.access_text?.trim() || null
const parkingTextEn = translation?.parking_text?.trim() || null

const dateLabel = formatEventDateRangeEn(event?.start_date, event?.end_date)
const timeLabel = event
  ? formatEventTimeRangeEn(event.start_time, event.end_time)
  : null
const displayImage = event ? resolveEventDisplayImage(event) : null
const imageCredit =
  displayImage?.kind === 'external' && event?.image_credit
    ? String(event.image_credit).trim() || null
    : null
const isEnded = event ? isEventEnded(event.start_date, event.end_date) : false

const structuredAdmission = event ? formatPriceEn(event) : null
/** Structured price preferred; EN price_text only as supplement / fallback */
const admissionLabel = structuredAdmission
  ? structuredAdmission
  : priceTextEn
const admissionNote =
  structuredAdmission && priceTextEn ? priceTextEn : null
const reservationLabel = event
  ? formatReservationStatusEn(event.reservation_status)
  : null
const reservationUrl = event?.reservation_url?.trim() || null
const durationLabel = event
  ? formatDurationEn(
      event.duration_minutes_min,
      event.duration_minutes_max,
    )
  : null

const hasBasicInfo = Boolean(
  event &&
    (dateLabel ||
      timeLabel ||
      event.venue ||
      event.address ||
      admissionLabel ||
      admissionNote ||
      reservationLabel ||
      reservationUrl ||
      durationLabel ||
      ageNoteEn),
)

const showNightTag = Boolean(event?.is_night)

const reactionSummary = event
  ? await fetchPublishedReactionSummary(supabase, Number(event.id))
  : null
const reactionTranslation =
  reactionSummary
    ? await fetchPublishedReactionTranslation(
        supabase,
        reactionSummary.id,
        'en',
      )
    : null
const reactionBulletsEn = reactionTranslation?.summary_bullets ?? null

const jaPath = event?.slug
  ? getLocalizedEventPath(String(event.slug), 'ja')
  : null
const enPath = event?.slug
  ? getLocalizedEventPath(String(event.slug), 'en')
  : null
const hreflangAlternates =
  jaPath && enPath
    ? [
        { lang: 'ja', path: jaPath },
        { lang: 'en', path: enPath },
        { lang: 'x-default', path: jaPath },
      ]
    : []

const pageTitle = event ? `${displayTitle} | Seekigo` : 'Seekigo'
const metaDescription = event
  ? summaryEn
    ? summaryEn.slice(0, 160)
    : `Event information for ${displayTitle} in Tokyo, including dates, venue, admission, access and visitor tips.`
  : 'Tokyo event information on Seekigo.'

const L = EVENT_UI_EN
---

<Layout
  title={pageTitle}
  description={metaDescription}
  locale="en"
  hreflangAlternates={hreflangAlternates}
  eventLanguageSwitcher={
    event?.slug
      ? { slug: String(event.slug), enPageAvailable: true }
      : undefined
  }
>
  {event ? (
    <main class="event-page">
      <article class="event-article">
        <nav class="breadcrumb" aria-label={L.breadcrumbNav}>
          <a href="/tokyo/">{L.breadcrumbTokyo}</a>
          <span class="breadcrumb__sep" aria-hidden="true">›</span>
          <span
            class="breadcrumb__current"
            aria-current="page"
            lang={titleLang}
          >
            {displayTitle}
          </span>
        </nav>

        <header class="event-header">
          {showNightTag && (
            <div class="event-tags">
              <span class="tag">{L.night}</span>
            </div>
          )}
          <h1 class="event-title" lang={titleLang}>{displayTitle}</h1>
        </header>

        {displayImage && (
          <div class="event-image">
            <img
              src={displayImage.src}
              alt={displayTitle}
              loading="eager"
              decoding="async"
              class:list={[
                displayImage.kind !== 'external' && 'event-image__img--fallback',
                isEnded && 'event-image__img--ended',
              ]}
            />
            {isEnded && (
              <div class="event-image__ended" aria-hidden="true">
                <span class="event-image__ended-label">{L.ended}</span>
              </div>
            )}
            {imageCredit && <p class="event-image__credit">{imageCredit}</p>}
          </div>
        )}

        {summaryEn && (
          <section class="event-body" aria-labelledby="event-overview-heading">
            <h2 id="event-overview-heading" class="event-section-heading">
              {L.overview}
            </h2>
            <p class="event-body__text">{summaryEn}</p>
          </section>
        )}

        {hasBasicInfo && (
          <section class="event-basics" aria-labelledby="event-basics-heading">
            <h2 id="event-basics-heading" class="event-section-heading">
              {L.basics}
            </h2>
            <dl class="event-meta">
              {dateLabel && (
                <div class="event-meta__row">
                  <dt>{L.dates}</dt>
                  <dd>
                    <time datetime={event.start_date ?? undefined}>{dateLabel}</time>
                  </dd>
                </div>
              )}
              {timeLabel && (
                <div class="event-meta__row">
                  <dt>{L.hours}</dt>
                  <dd>
                    <span>{timeLabel}</span>
                    <span class="event-meta__note">{L.hoursNote}</span>
                  </dd>
                </div>
              )}
              {event.venue && (
                <div class="event-meta__row">
                  <dt>{L.venue}</dt>
                  <dd lang="ja">{event.venue}</dd>
                </div>
              )}
              {event.address && (
                <div class="event-meta__row">
                  <dt>{L.address}</dt>
                  <dd lang="ja">{event.address}</dd>
                </div>
              )}
              {(admissionLabel || admissionNote) && (
                <div class="event-meta__row">
                  <dt>{L.admission}</dt>
                  <dd>
                    {admissionLabel && <span>{admissionLabel}</span>}
                    {admissionNote && (
                      <span class="event-meta__note">{admissionNote}</span>
                    )}
                  </dd>
                </div>
              )}
              {(reservationLabel || reservationUrl) && (
                <div class="event-meta__row">
                  <dt>{L.reservation}</dt>
                  <dd class="event-meta__reservation">
                    {reservationLabel && <span>{reservationLabel}</span>}
                    {reservationUrl && (
                      <a
                        href={reservationUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {L.reservationLink}
                      </a>
                    )}
                  </dd>
                </div>
              )}
              {ageNoteEn && (
                <div class="event-meta__row">
                  <dt>{L.age}</dt>
                  <dd>{ageNoteEn}</dd>
                </div>
              )}
              {durationLabel && (
                <div class="event-meta__row">
                  <dt>{L.duration}</dt>
                  <dd>{durationLabel}</dd>
                </div>
              )}
            </dl>
          </section>
        )}

        <EventVisitChecklist event={event} locale="en" />

        <EventAccess
          event={event}
          locale="en"
          accessTextEn={accessTextEn}
          parkingTextEn={parkingTextEn}
        />

        {reactionSummary && (
          <EventReactionSummary
            summary={reactionSummary}
            locale="en"
            bulletsEn={reactionBulletsEn}
          />
        )}

        {event.official_url && (
          <div class="event-cta">
            <a
              href={event.official_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              {L.officialCta} →
            </a>
          </div>
        )}

        {event.source_url && (
          <p class="event-source">
            {L.source}:{' '}
            <a
              href={event.source_url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {event.source_url}
            </a>
          </p>
        )}

        <section class="organizer-note" aria-labelledby="organizer-note-heading">
          <h2 id="organizer-note-heading" class="organizer-note__heading">
            {L.organizerHeading}
          </h2>
          <p class="organizer-note__text">{L.organizerBody}</p>
          <p class="organizer-note__cta">
            <a
              class="organizer-note__link"
              href={`/contact/event-info/?event=${encodeURIComponent(`/en/tokyo/event/${event.slug}/`)}`}
            >
              {L.organizerCta}
            </a>
          </p>
        </section>

        <p class="back-link">
          <a href="/tokyo/">{L.backToList}</a>
        </p>
      </article>
    </main>
  ) : (
    <main class="event-page">
      <div class="event-article">
        <p class="not-found">{L.notFound}</p>
        <p class="back-link">
          <a href="/tokyo/">{L.backToList}</a>
        </p>
      </div>
    </main>
  )}
</Layout>

<style>
  .event-page {
    padding-bottom: 80px;
  }

  .event-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px var(--px) 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .breadcrumb {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .breadcrumb a {
    color: var(--c-muted);
  }
  .breadcrumb a:hover {
    color: var(--c-primary);
    text-decoration: underline;
  }
  .breadcrumb__sep {
    color: var(--c-border);
  }
  .breadcrumb__current {
    color: var(--c-muted);
    overflow-wrap: anywhere;
  }

  .event-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    background: var(--c-accent);
    color: var(--c-text);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    letter-spacing: 0.02em;
  }
  .event-title {
    font-size: clamp(22px, 5vw, 40px);
    font-weight: 800;
    letter-spacing: -0.4px;
    line-height: 1.3;
    color: var(--c-text);
    overflow-wrap: anywhere;
  }

  .event-body__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.75;
    color: var(--c-text);
  }

  .event-image {
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--c-border);
    position: relative;
  }
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .event-image__img--fallback {
    background: var(--c-border);
  }
  .event-image__img--ended {
    filter: grayscale(0.35) brightness(0.85);
  }
  .event-image__ended {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 24, 39, 0.42);
    pointer-events: none;
  }
  .event-image__ended-label {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #fff;
    padding: 10px 20px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: var(--r-sm);
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(2px);
  }
  .event-image__credit {
    margin: 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.8rem;
    color: var(--c-muted, #666);
    background: #f7f7f7;
  }

  .event-basics {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .event-section-heading {
    font-size: 16px;
    font-weight: 700;
    color: var(--c-text);
    padding-bottom: 8px;
    border-bottom: 2px solid var(--c-primary);
    align-self: flex-start;
  }

  .event-meta {
    margin: 0;
    border-top: 1px solid var(--c-border);
  }
  .event-meta__row {
    display: grid;
    grid-template-columns: minmax(6.5rem, 8.5rem) 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-border);
    align-items: start;
  }
  .event-meta__row dt {
    font-size: 13px;
    font-weight: 600;
    color: var(--c-muted);
  }
  .event-meta__row dd {
    margin: 0;
    font-size: 14px;
    color: var(--c-text);
    line-height: 1.55;
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .event-meta__note {
    font-size: 12px;
    color: var(--c-muted);
    font-weight: 500;
  }
  .event-meta__reservation {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .event-meta__reservation a {
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .event-meta__reservation a:hover {
    color: var(--c-primary-dk);
  }

  .event-cta {
    padding-top: 4px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: var(--c-primary);
    color: var(--c-white) !important;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: var(--r-lg);
    text-align: center;
    transition: background 0.15s;
  }
  .btn-primary:hover {
    background: var(--c-primary-dk);
  }

  .event-source {
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.5;
    overflow-wrap: anywhere;
    margin-top: -8px;
  }
  .event-source a {
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .event-source a:hover {
    color: var(--c-primary);
  }

  .organizer-note {
    margin-top: 8px;
    padding: 22px 20px;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-white);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .organizer-note__heading {
    font-size: 15px;
    font-weight: 700;
    color: var(--c-text);
  }
  .organizer-note__text {
    font-size: 13px;
    line-height: 1.8;
    color: var(--c-muted);
  }
  .organizer-note__cta {
    margin: 0;
  }
  .organizer-note__link {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .organizer-note__link:hover {
    color: var(--c-primary-dk);
  }

  .back-link {
    font-size: 14px;
    padding-top: 8px;
  }
  .back-link a {
    color: var(--c-muted);
  }
  .back-link a:hover {
    color: var(--c-text);
  }

  .not-found {
    color: var(--c-muted);
  }

  @media (min-width: 640px) {
    .btn-primary {
      width: auto;
      min-width: 280px;
    }
  }
</style>
