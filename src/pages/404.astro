---
import Layout from '../layouts/Layout.astro'
---

<Layout title="ページが見つかりません | Seekigo" noindex>
  <main class="nf">
    <div class="nf__inner">
      <p class="nf__code">404</p>
      <h1 class="nf__title">ページが見つかりませんでした</h1>
      <p class="nf__text">
        イベントが終了して掲載を終えたか、URL が変わった可能性があります。<br />
        ほかの行き先を探してみましょう。
      </p>
      <div class="nf__links">
        <a class="nf__primary" href="/tokyo/today/">今日のイベントを見る</a>
        <a class="nf__secondary" href="/">トップへ戻る</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf {
    padding: 80px var(--px) 24px;
  }
  .nf__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .nf__code {
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--c-cyan);
  }
  .nf__title {
    margin-top: 16px;
    font-size: clamp(22px, 4vw, 28px);
    font-weight: 800;
    color: var(--c-text);
  }
  .nf__text {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--c-muted);
  }
  .nf__links {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .nf__primary,
  .nf__secondary {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
  }
  .nf__primary {
    background: var(--c-primary);
    color: #fff !important;
  }
  .nf__primary:hover { background: var(--c-primary-dk); }
  .nf__secondary {
    border: 1.5px solid var(--c-navy);
    color: var(--c-navy) !important;
  }
  .nf__secondary:hover {
    background: var(--c-navy);
    color: #fff !important;
  }
</style>
