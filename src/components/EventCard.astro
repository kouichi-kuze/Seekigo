---
import { resolveImageCategorySlug, getCategoryImagePath } from '../lib/event-category-images'
import { isEventEnded } from '../lib/display'

interface Props {
  event: {
    id?: string | number
    slug?: string | null
    title: string
    image_url?: string | null
    start_date?: string | null
    end_date?: string | null
    venue?: string | null
    area?: string | null
    price_text?: string | null
    summary?: string | null
    category?: string | string[] | null
    is_free?: boolean
    is_kids?: boolean
    is_indoor?: boolean
    is_night?: boolean
    official_url?: string | null
  }
}

const { event } = Astro.props

const hasAnyTag = event.is_free || event.is_kids || event.is_indoor || event.is_night

const dateLabel = (() => {
  if (!event.start_date) return null
  if (event.end_date && event.end_date !== event.start_date) {
    return `${event.start_date} ～ ${event.end_date}`
  }
  return event.start_date
})()

const categorySlug = resolveImageCategorySlug(event.category, {
  is_kids:   event.is_kids,
  is_night:  event.is_night,
  is_free:   event.is_free,
  is_indoor: event.is_indoor,
})
const fallbackImagePath = getCategoryImagePath(categorySlug)

const detailUrl = event.slug ? `/tokyo/event/${event.slug}/` : null
const isEnded = isEventEnded(event.start_date, event.end_date)
---

<article
  class:list={['event-card', detailUrl && 'event-card--linked']}
  data-start={event.start_date ?? ''}
  data-end={event.end_date ?? ''}
  data-free={event.is_free ? 'true' : 'false'}
  data-kids={event.is_kids ? 'true' : 'false'}
  data-indoor={event.is_indoor ? 'true' : 'false'}
  data-night={event.is_night ? 'true' : 'false'}
>
  <!-- Image -->
  <div class="card-image">
    <img
      src={event.image_url ?? fallbackImagePath}
      alt={event.title}
      loading="lazy"
      decoding="async"
      class:list={[
        !event.image_url && 'card-image--fallback',
        isEnded && 'card-image--ended',
      ]}
    />

    {isEnded && (
      <div class="card-image__ended" aria-hidden="true">
        <span class="card-image__ended-label">開催終了</span>
      </div>
    )}

    {hasAnyTag && (
      <div class="card-tags">
        {event.is_free   && <span class="tag">無料</span>}
        {event.is_kids   && <span class="tag">子ども向け</span>}
        {event.is_indoor && <span class="tag">屋内</span>}
        {event.is_night  && <span class="tag">夜</span>}
      </div>
    )}
  </div>

  <!-- Body -->
  <div class="card-body">
    {event.area && <p class="card-area">{event.area}</p>}

    <h2 class="card-title">
      {detailUrl ? (
        <a href={detailUrl} class="card-title__link card-title__link--stretch">
          {event.title}
        </a>
      ) : (
        event.title
      )}
    </h2>

    <dl class="card-meta">
      {dateLabel && (
        <>
          <dt class="sr-only">開催日</dt>
          <dd class="card-meta__item">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
            </svg>
            {dateLabel}
          </dd>
        </>
      )}
      {event.venue && (
        <>
          <dt class="sr-only">会場</dt>
          <dd class="card-meta__item">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            {event.venue}
          </dd>
        </>
      )}
      {event.price_text && (
        <>
          <dt class="sr-only">料金</dt>
          <dd class="card-meta__item">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd" />
            </svg>
            {event.price_text}
          </dd>
        </>
      )}
    </dl>

    {event.summary && (
      <p class="card-summary">{event.summary}</p>
    )}

    <div class="card-footer">
      {detailUrl && (
        <span class="card-detail-hint">詳細を見る →</span>
      )}
      {event.official_url && (
        <a
          class="card-cta"
          href={event.official_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          公式サイト
          <svg viewBox="0 0 20 20" fill="currentColor">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* ─── Card ─── */
  .event-card {
    background: var(--c-white);
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .event-card--linked:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    cursor: pointer;
  }

  /* ─── Image ─── */
  .card-image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--c-border);
    overflow: hidden;
    flex-shrink: 0;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  /* フォールバック画像（SVG）はシャープに見せる */
  .card-image img.card-image--fallback {
    object-fit: cover;
  }
  .card-image img.card-image--ended {
    filter: grayscale(0.35) brightness(0.85);
  }
  .event-card--linked:hover .card-image img {
    transform: scale(1.03);
  }

  .card-image__ended {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 24, 39, 0.42);
    pointer-events: none;
  }
  .card-image__ended-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #fff;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: var(--r-sm);
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(2px);
  }

  /* ─── Tags overlay ─── */
  .card-tags {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tag {
    background: var(--c-accent);
    color: var(--c-text);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    padding: 4px 8px;
    border-radius: var(--r-sm);
    letter-spacing: 0.02em;
  }

  /* ─── Body ─── */
  .card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card-area {
    font-size: 11px;
    font-weight: 700;
    color: var(--c-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .card-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--c-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stretched link */
  .card-title__link {
    color: var(--c-text) !important;
    text-decoration: none;
  }
  .card-title__link--stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* ─── Meta ─── */
  .card-meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .card-meta__item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.4;
  }
  .meta-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--c-muted);
  }

  /* ─── Summary ─── */
  .card-summary {
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* ─── Footer row ─── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 4px;
    gap: 8px;
  }
  .card-detail-hint {
    font-size: 12px;
    font-weight: 600;
    color: var(--c-primary);
  }

  /* 公式リンクは stretched link より前面 */
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--c-muted) !important;
    border: 1px solid var(--c-border);
    padding: 5px 10px;
    border-radius: var(--r-sm);
    white-space: nowrap;
    position: relative;
    z-index: 1;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .card-cta:hover {
    border-color: var(--c-primary);
    color: var(--c-primary) !important;
  }
  .card-cta svg { width: 11px; height: 11px; }

  /* ─── Accessibility ─── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
