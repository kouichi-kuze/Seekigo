---
import { resolveEventDisplayImage } from '../lib/event-image-usage'
import { formatEventPlaceLine } from '../lib/display'
import {
  formatCardScheduleDates,
  resolveScheduleStatus,
  type DateSpan,
} from '../lib/event-schedule'
import { getLocalizedEventPath, type SiteLocale } from '../lib/i18n/locale'
import { EVENT_UI_EN, formatPriceEn } from '../lib/i18n/event-en'
import {
  formatCardPriceChip,
  formatCardPriceLine,
  isListedAsFreePrice,
} from '../lib/event-visit-display'

interface Props {
  locale?: SiteLocale
  event: {
    id?: string | number
    slug?: string | null
    title: string
    image_url?: string | null
    image_usage_status?: string | null
    image_credit?: string | null
    start_date?: string | null
    end_date?: string | null
    venue?: string | null
    area?: string | null
    municipality?: string | null
    price_text?: string | null
    price_min?: number | null
    price_max?: number | null
    price_type?: string | null
    summary?: string | null
    category?: string | string[] | null
    is_kids?: boolean
    is_indoor?: boolean
    is_night?: boolean
    official_url?: string | null
    schedule_spans?: DateSpan[]
  }
}

const { event, locale = 'ja' } = Astro.props

const priceChip = formatCardPriceChip(event.price_type, locale)
const cardPrice =
  locale === 'en' ? formatPriceEn(event) : formatCardPriceLine(event)

const hasAnyTag = Boolean(priceChip || event.is_kids || event.is_indoor || event.is_night)

const scheduleSpans = event.schedule_spans ?? []
const dateLabel = formatCardScheduleDates(
  scheduleSpans,
  {
    start_date: scheduleSpans.length ? null : event.start_date,
    end_date: scheduleSpans.length ? null : event.end_date,
  },
  locale,
)
const placeLabel = formatEventPlaceLine(event.municipality, event.area, {
  omitRawSlug: true,
})

const displayImage = resolveEventDisplayImage(event)
const isFallbackImage = displayImage.kind !== 'external'
const scheduleStatus = resolveScheduleStatus(scheduleSpans, {
  start_date: scheduleSpans.length ? null : event.start_date,
  end_date: scheduleSpans.length ? null : event.end_date,
})
const isEnded = scheduleStatus === 'ended'
const statusLabel =
  scheduleStatus === 'today'
    ? locale === 'en'
      ? EVENT_UI_EN.happeningToday
      : '本日開催'
    : scheduleStatus === 'upcoming'
      ? locale === 'en'
        ? EVENT_UI_EN.upcoming
        : '開催予定'
      : scheduleStatus === 'ended'
        ? locale === 'en'
          ? EVENT_UI_EN.ended
          : '開催終了'
        : null
const conceptLabel =
  displayImage.kind === 'generated'
    ? locale === 'en'
      ? EVENT_UI_EN.illustrativeImage
      : 'イメージ'
    : null

const detailUrl = event.slug
  ? getLocalizedEventPath(String(event.slug), locale)
  : null
---

<article
  class:list={['event-card', detailUrl && 'event-card--linked']}
  data-start={event.start_date ?? ''}
  data-end={event.end_date ?? ''}
  data-spans={scheduleSpans.map((span) => `${span.start}/${span.end}`).join(',')}
  data-free={isListedAsFreePrice(event.price_type) ? 'true' : 'false'}
  data-kids={event.is_kids ? 'true' : 'false'}
  data-indoor={event.is_indoor ? 'true' : 'false'}
  data-night={event.is_night ? 'true' : 'false'}
>
  <!-- Image -->
  <div class="card-image">
    <img
      src={displayImage.src}
      alt={event.title}
      loading="lazy"
      decoding="async"
      class:list={[
        isFallbackImage && 'card-image--fallback',
        isEnded && 'card-image--ended',
      ]}
    />

    {conceptLabel && (
      <span class="card-image__concept">{conceptLabel}</span>
    )}
  </div>

  <!-- Body -->
  <div class="card-body">
    <h2 class="card-title">
      {detailUrl ? (
        <a href={detailUrl} class="card-title__link card-title__link--stretch">
          {event.title}
        </a>
      ) : (
        event.title
      )}
    </h2>

    {(statusLabel || dateLabel) && (
      <p class="card-when">
        {statusLabel && (
          <span class:list={['card-status', scheduleStatus && `card-status--${scheduleStatus}`]}>
            {statusLabel}
          </span>
        )}
        {dateLabel && <span class="card-when__date">{dateLabel}</span>}
      </p>
    )}

    {placeLabel && <p class="card-area">{placeLabel}</p>}

    <dl class="card-meta">
      {event.venue && (
        <>
          <dt class="sr-only">会場</dt>
          <dd class="card-meta__item">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            {event.venue}
          </dd>
        </>
      )}
      {cardPrice && (
        <>
          <dt class="sr-only">料金</dt>
          <dd class="card-meta__item card-meta__price">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd" />
            </svg>
            <span class="card-price-text">{cardPrice}</span>
          </dd>
        </>
      )}
    </dl>

    {hasAnyTag && (
      <ul class="card-attrs">
        {priceChip && <li class="tag">{priceChip}</li>}
        {event.is_kids && <li class="tag">{locale === 'en' ? EVENT_UI_EN.forKids : '子ども向け'}</li>}
        {event.is_indoor && <li class="tag">{locale === 'en' ? EVENT_UI_EN.indoor : '屋内'}</li>}
        {event.is_night && <li class="tag">{locale === 'en' ? EVENT_UI_EN.night : '夜'}</li>}
      </ul>
    )}

    {event.summary && (
      <p class="card-summary">{event.summary}</p>
    )}

    <div class="card-footer">
      {detailUrl && (
        <span class="card-detail-hint">詳細を見る →</span>
      )}
      {event.official_url && (
        <a
          class="card-cta"
          href={event.official_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          公式サイト
          <svg viewBox="0 0 20 20" fill="currentColor">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* ─── Card ─── */
  .event-card {
    background: var(--c-white);
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .event-card--linked:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    cursor: pointer;
  }

  /* ─── Image ─── */
  .card-image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--c-border);
    overflow: hidden;
    flex-shrink: 0;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  /* フォールバック画像（SVG）はシャープに見せる */
  .card-image img.card-image--fallback {
    object-fit: cover;
  }
  .card-image img.card-image--ended {
    filter: grayscale(0.35) brightness(0.85);
  }
  .event-card--linked:hover .card-image img {
    transform: scale(1.03);
  }

  .card-image__concept {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 1;
    max-width: calc(100% - 16px);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: #fff;
    padding: 2px 6px;
    border-radius: var(--r-sm);
    background: rgba(17, 24, 39, 0.62);
  }

  /* ─── Body ─── */
  .card-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .card-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    margin: 0;
  }
  .card-status {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--c-muted);
    background: #f3f4f6;
    padding: 2px 6px;
    border-radius: var(--r-sm);
  }
  .card-status--today {
    color: var(--c-primary);
    background: color-mix(in srgb, var(--c-primary) 10%, #fff);
  }
  .card-when__date {
    min-width: 0;
    font-size: 12px;
    line-height: 1.4;
    color: var(--c-muted);
  }
  .card-attrs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tag {
    background: var(--c-accent);
    color: var(--c-text);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    padding: 4px 8px;
    border-radius: var(--r-sm);
  }
  .card-area {
    font-size: 11px;
    font-weight: 700;
    color: var(--c-primary);
    letter-spacing: 0.04em;
  }
  .card-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    min-height: calc(1.4em * 2);
    color: var(--c-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stretched link */
  .card-title__link {
    color: var(--c-text) !important;
    text-decoration: none;
  }
  .card-title__link--stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* ─── Meta ─── */
  .card-meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .card-meta__item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.4;
  }
  .card-price-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--c-muted);
  }

  /* ─── Summary ─── */
  .card-summary {
    font-size: 12px;
    color: var(--c-muted);
    line-height: 1.6;
    min-height: calc(1.6em * 2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── Footer row ─── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 4px;
    gap: 8px;
  }
  .card-detail-hint {
    font-size: 12px;
    font-weight: 600;
    color: var(--c-primary);
  }

  /* 公式リンクは stretched link より前面 */
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--c-muted) !important;
    border: 1px solid var(--c-border);
    padding: 5px 10px;
    border-radius: var(--r-sm);
    white-space: nowrap;
    position: relative;
    z-index: 1;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .card-cta:hover {
    border-color: var(--c-primary);
    color: var(--c-primary) !important;
  }
  .card-cta svg { width: 11px; height: 11px; }

  @media (max-width: 480px) {
    .card-body {
      gap: 6px;
      padding: 12px;
    }
    .card-title {
      font-size: 14px;
    }
  }

  /* ─── Accessibility ─── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
</style>
