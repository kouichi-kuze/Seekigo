---
import { formatAreaLabel, formatEventDateRange } from '../lib/display'
import { resolvePublicImageUrl } from '../lib/event-image-usage'

interface Props {
  event: {
    id?: string | number
    slug?: string | null
    title: string
    image_url?: string | null
    image_usage_status?: string | null
    start_date?: string | null
    end_date?: string | null
    venue?: string | null
    area?: string | null
    summary?: string | null
    is_free?: boolean
    is_kids?: boolean
    is_indoor?: boolean
    is_night?: boolean
  }
}

const { event } = Astro.props

const hasAnyTag = event.is_free || event.is_kids || event.is_indoor || event.is_night
const dateLabel = formatEventDateRange(event.start_date, event.end_date)
const areaLabel = formatAreaLabel(event.area)
const detailUrl = event.slug ? `/tokyo/event/${event.slug}/` : null
const publicImageUrl = resolvePublicImageUrl(event)

// プレースホルダー用: タグ優先でアクセントカラーと背景を決定
const placeholderConfig = (() => {
  if (event.is_night)  return { icon: '🌙', from: '#1e3a5f', to: '#0f2040', label: '夜のイベント' }
  if (event.is_kids)   return { icon: '🎈', from: '#f97316', to: '#f59e0b', label: '子どもイベント' }
  if (event.is_free)   return { icon: '🎁', from: '#059669', to: '#0ea5e9', label: '無料イベント' }
  if (event.is_indoor) return { icon: '🏛️', from: '#7c3aed', to: '#0ea5e9', label: '屋内イベント' }
  return { icon: '☀️', from: '#0ea5e9', to: '#a3e635', label: '日中のイベント' }
})()
---

<article
  class:list={['event-card', detailUrl && 'event-card--linked']}
  data-start={event.start_date ?? ''}
  data-end={event.end_date ?? ''}
  data-free={event.is_free ? 'true' : 'false'}
  data-kids={event.is_kids ? 'true' : 'false'}
  data-indoor={event.is_indoor ? 'true' : 'false'}
  data-night={event.is_night ? 'true' : 'false'}
>
  <div class="card-image">
    {publicImageUrl ? (
      <img src={publicImageUrl} alt={event.title} loading="lazy" decoding="async" />
    ) : (
      <div
        class="card-placeholder"
        style={`background: linear-gradient(135deg, ${placeholderConfig.from} 0%, ${placeholderConfig.to} 100%);`}
        aria-hidden="true"
      >
        <span class="card-placeholder__icon">{placeholderConfig.icon}</span>
        <span class="card-placeholder__label">{placeholderConfig.label}</span>
      </div>
    )}

    {hasAnyTag && (
      <div class="card-tags">
        {event.is_free && <span class="tag">無料</span>}
        {event.is_kids && <span class="tag">子ども向け</span>}
        {event.is_indoor && <span class="tag">屋内</span>}
        {event.is_night && <span class="tag">夜</span>}
      </div>
    )}
  </div>

  <div class="card-body">
    {areaLabel && <p class="card-area">{areaLabel}</p>}

    <h2 class="card-title">
      {detailUrl ? (
        <a href={detailUrl} class="card-title__link card-title__link--stretch">
          {event.title}
        </a>
      ) : (
        event.title
      )}
    </h2>

    <dl class="card-meta">
      {dateLabel && (
        <>
          <dt class="sr-only">開催日</dt>
          <dd class="card-meta__item">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
            </svg>
            {dateLabel}
          </dd>
        </>
      )}
      {event.venue && (
        <>
          <dt class="sr-only">会場</dt>
          <dd class="card-meta__item">
            <svg class="meta-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            {event.venue}
          </dd>
        </>
      )}
    </dl>

    {event.summary && (
      <p class="card-summary">{event.summary}</p>
    )}

    {detailUrl && (
      <div class="card-footer">
        <span class="card-detail-hint">詳細を見る →</span>
      </div>
    )}
  </div>
</article>

<style>
  .event-card {
    background: var(--c-white);
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .event-card--linked:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    cursor: pointer;
  }

  .card-image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--c-border);
    overflow: hidden;
    flex-shrink: 0;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .event-card--linked:hover .card-image img {
    transform: scale(1.03);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    position: relative;
    overflow: hidden;
  }
  .card-placeholder::before,
  .card-placeholder::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
  }
  .card-placeholder::before {
    width: 120px;
    height: 120px;
    bottom: -30px;
    right: -30px;
  }
  .card-placeholder::after {
    width: 80px;
    height: 80px;
    top: -20px;
    left: -20px;
  }
  .card-placeholder__icon {
    font-size: 22px;
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }
  .card-placeholder__label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-tags {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tag {
    background: var(--c-accent);
    color: var(--c-text);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    padding: 4px 8px;
    border-radius: var(--r-sm);
    letter-spacing: 0.02em;
  }

  .card-body {
    padding: 18px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card-area {
    font-size: 12px;
    font-weight: 700;
    color: var(--c-primary);
    letter-spacing: 0.02em;
  }
  .card-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--c-text);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: calc(1.45em * 2);
  }

  .card-title__link {
    color: var(--c-text) !important;
    text-decoration: none;
  }
  .card-title__link--stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .card-meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .card-meta__item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    font-size: 13px;
    color: #4b5563;
    line-height: 1.5;
  }
  .meta-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 2px;
    color: #6b7280;
  }

  .card-summary {
    font-size: 14px;
    color: #4b5563;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: 6px;
  }
  .card-detail-hint {
    font-size: 13px;
    font-weight: 700;
    color: var(--c-primary);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
