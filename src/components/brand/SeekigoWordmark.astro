---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class:list={['wm', className]} aria-label="Seekigo">
  <span class="wm__navy" aria-hidden="true">Seek</span><span class="wm__i" aria-hidden="true">ı</span><span class="wm__go" aria-hidden="true">go</span>
</span>

<style>
  .wm {
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .wm__navy,
  .wm__i {
    color: var(--c-navy);
  }
  .wm__go {
    color: var(--c-cyan);
  }
  /* ドットなし ı + シアンの tittle（二重点を防ぐ） */
  .wm__i {
    position: relative;
    display: inline-block;
  }
  .wm__i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.02em;
    width: 0.22em;
    height: 0.22em;
    transform: translateX(-50%);
    background: var(--c-cyan);
    border-radius: 50%;
  }
</style>
