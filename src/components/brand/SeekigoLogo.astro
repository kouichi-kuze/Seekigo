---
interface Props {
  size?: 'header' | 'hero' | 'footer'
  href?: string | null
}

const { size = 'header', href = '/' } = Astro.props
const Tag = href ? 'a' : 'span'
---

<Tag
  class:list={['seekigo-logo', `seekigo-logo--${size}`]}
  href={href ?? undefined}
  aria-label="Seekigo ホーム"
>
  <img src="/brand/logo_seekigo.png" alt="" width="1024" height="256" />
</Tag>

<style>
  .seekigo-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: inherit !important;
    text-decoration: none !important;
    flex-shrink: 0;
    min-width: 0;
  }
  .seekigo-logo img {
    display: block;
    width: auto;
    height: 36px;
    max-width: 100%;
    object-fit: contain;
  }
  .seekigo-logo--header img {
    height: 36px;
  }
  .seekigo-logo--hero img {
    height: clamp(48px, 8vw, 72px);
  }
  .seekigo-logo--footer img {
    height: 22px;
  }

  @media (max-width: 719px) {
    .seekigo-logo--header img {
      height: 30px;
    }
  }
</style>
