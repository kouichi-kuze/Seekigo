---
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SeekigoLogo from '../components/brand/SeekigoLogo.astro'
import { BRAND_ASSETS, OG_IMAGE_SIZE } from '../lib/brand'

interface Props {
  title: string
  description?: string
  /** true のとき robots noindex,nofollow */
  noindex?: boolean
  /** 指定時は noindex より優先（例: contact ページは "noindex" のみ） */
  robots?: string
  /** 省略時はサイト共通 OGP。絶対 URL またはサイト相対パス */
  ogImage?: string
}

const { title, description, noindex = false, robots, ogImage } = Astro.props

/** ビルド／描画時点の西暦（毎年手更新不要） */
const copyrightYear = new Date().getFullYear()

/** pathname のみ（query は canonical / og:url に含めない） */
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined

function toAbsoluteAsset(pathOrUrl: string): string {
  if (/^https?:\/\//i.test(pathOrUrl)) return pathOrUrl
  if (Astro.site) return new URL(pathOrUrl, Astro.site).href
  return pathOrUrl
}

const resolvedOgImage = toAbsoluteAsset(ogImage ?? BRAND_ASSETS.ogImage)
const robotsContent = robots ?? (noindex ? 'noindex, nofollow' : undefined)
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robotsContent && <meta name="robots" content={robotsContent} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Seekigo" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content="Seekigo — 探して、行く。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />
    <GoogleAnalytics />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <SeekigoLogo size="header" />
        <nav class="site-nav" aria-label="主要ナビ">
          <a href="/tokyo/">東京</a>
          <a href="/tokyo/today/" class="site-nav__today">今日</a>
          <a href="/tokyo/this-weekend/" class="site-nav__extra">今週末</a>
          <a href="/tokyo/free/" class="site-nav__extra">無料</a>
          <a href="/tokyo/with-kids/" class="site-nav__extra">子どもと</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="inner site-footer__inner">
        <SeekigoLogo size="footer" />
        <p class="site-footer__copy">© {copyrightYear} Seekigo</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ─── Design Tokens ─── */
  :root {
    --c-navy:         #0E2744;
    --c-cyan:         #00A3FF;
    --c-lime:         #A3E635;
    --c-primary:      #00A3FF;
    --c-primary-dk:   #0086CC;
    --c-accent:       #A3E635;
    --c-text:         #0E2744;
    --c-muted:        #6B7280;
    --c-bg:           #F8FAFC;
    --c-white:        #FFFFFF;
    --c-border:       #E5E7EB;

    --r-sm:  6px;
    --r-md:  12px;
    --r-lg:  24px;

    --shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
    --shadow-md: 0 4px 16px rgba(0,0,0,.08);

    --font: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN',
            'Noto Sans JP', 'Yu Gothic', sans-serif;

    --max-w: 1200px;
    --px:    clamp(16px, 4vw, 40px);
  }

  /* ─── Reset ─── */
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; width: 100%; }

  body {
    font-family: var(--font);
    background: var(--c-bg);
    color: var(--c-text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  img { max-width: 100%; display: block; }

  a { color: var(--c-primary); text-decoration: none; }
  a:hover { color: var(--c-primary-dk); }

  h1, h2, h3, h4 { margin: 0; line-height: 1.3; }
  p { margin: 0; }
</style>

<style>
  /* ─── Site Header ─── */
  .site-header {
    background: var(--c-white);
    border-bottom: 1px solid var(--c-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header .inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--px);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 1;
    min-width: 0;
  }
  .site-nav a {
    font-size: 14px;
    font-weight: 500;
    color: var(--c-muted) !important;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .site-nav a:hover { color: var(--c-text) !important; }
  .site-nav__today {
    background: var(--c-primary);
    color: var(--c-white) !important;
    padding: 6px 14px;
    border-radius: var(--r-lg);
    font-size: 13px !important;
    font-weight: 600 !important;
  }
  .site-nav__today:hover {
    background: var(--c-primary-dk);
    color: var(--c-white) !important;
  }

  /* SPでは主要2項目のみ（既存レイアウトを壊さない） */
  @media (max-width: 719px) {
    .site-nav {
      gap: 10px;
    }
    .site-nav__extra {
      display: none;
    }
    .site-nav__today {
      padding: 6px 12px;
    }
  }

  @media (min-width: 720px) {
    .site-nav {
      gap: 18px;
    }
  }

  /* ─── Inner wrapper (shared) ─── */
  :global(.inner) {
    max-width: var(--max-w);
    margin: 0 auto;
    padding-left: var(--px);
    padding-right: var(--px);
  }

  /* ─── Site Footer ─── */
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--c-border);
    padding: 32px 0;
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .site-footer__copy {
    font-size: 13px;
    color: var(--c-muted);
  }
</style>
