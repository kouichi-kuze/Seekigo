---
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SeekigoLogo from '../components/brand/SeekigoLogo.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { BRAND_ASSETS, OG_IMAGE_SIZE } from '../lib/brand'
import type { SiteLocale } from '../lib/i18n/locale'

interface Props {
  title: string
  description?: string
  /** true のとき robots noindex,nofollow */
  noindex?: boolean
  /** 指定時は noindex より優先（例: contact ページは "noindex" のみ） */
  robots?: string
  /** 省略時はサイト共通 OGP。絶対 URL またはサイト相対パス */
  ogImage?: string
  /** イベント画像など、共通 OGP 以外の alt */
  ogImageAlt?: string
  /** head に出す application/ld+json。未指定なら出さない */
  jsonLd?: string
  /** html lang / og:locale（default ja） */
  locale?: SiteLocale
  /** hreflang alternate パス（サイト相対、例: /tokyo/event/x/） */
  hreflangAlternates?: { lang: string; path: string }[]
  /**
   * Event detail only: show JP|EN header switcher.
   * Omit on list/TOP pages.
   */
  /** 気分チップがあるページでは SP のカテゴリ行を出さない（重複を避ける） */
  hideNavOnMobile?: boolean
  eventLanguageSwitcher?: {
    slug: string
    enPageAvailable?: boolean
    jaPageAvailable?: boolean
  }
}

const {
  title,
  description,
  noindex = false,
  robots,
  ogImage,
  ogImageAlt: ogImageAltProp,
  jsonLd,
  locale = 'ja',
  hreflangAlternates = [],
  eventLanguageSwitcher,
  hideNavOnMobile = false,
} = Astro.props

/** ビルド／描画時点の西暦（毎年手更新不要） */
const copyrightYear = new Date().getFullYear()

/** pathname のみ（query は canonical / og:url に含めない） */
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined

function toAbsoluteAsset(pathOrUrl: string): string {
  if (/^https?:\/\//i.test(pathOrUrl)) return pathOrUrl
  if (Astro.site) return new URL(pathOrUrl, Astro.site).href
  return pathOrUrl
}

function toAbsolutePath(path: string): string | undefined {
  if (!Astro.site) return undefined
  return new URL(path, Astro.site).href
}

const resolvedOgImage = toAbsoluteAsset(ogImage ?? BRAND_ASSETS.ogImage)
const usingDefaultOgImage = !ogImage
const robotsContent = robots ?? (noindex ? 'noindex, nofollow' : undefined)
const htmlLang = locale === 'en' ? 'en' : 'ja'
const ogLocale = locale === 'en' ? 'en_US' : 'ja_JP'
const ogImageAlt =
  ogImageAltProp?.trim() ||
  (locale === 'en' ? 'Seekigo — Find it. Go.' : 'Seekigo — 探して、行く。')
const navLabel = locale === 'en' ? 'Primary' : '主要ナビ'

const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const navItems =
  locale === 'en'
    ? [
        { href: '/tokyo/today/', label: 'Today' },
        { href: '/tokyo/this-weekend/', label: 'This weekend' },
        { href: '/tokyo/free/', label: 'Free' },
        { href: '/tokyo/with-kids/', label: 'With family' },
        { href: '/tokyo/rainy-day/', label: 'Rainy day' },
        { href: '/tokyo/night/', label: 'Night' },
      ]
    : [
        { href: '/tokyo/today/', label: '今日' },
        { href: '/tokyo/this-weekend/', label: '今週末' },
        { href: '/tokyo/free/', label: '無料' },
        { href: '/tokyo/with-kids/', label: '家族で' },
        { href: '/tokyo/rainy-day/', label: '雨の日' },
        { href: '/tokyo/night/', label: '夜' },
        { href: '/tokyo/shibuya/', label: '渋谷' },
        { href: '/tokyo/shinjuku/', label: '新宿' },
      ]
const footerGroups =
  locale === 'en'
    ? []
    : [
        {
          title: '探す',
          links: [
            { href: '/tokyo/', label: '東京のイベント' },
            { href: '/tokyo/today/', label: '今日のイベント' },
            { href: '/tokyo/this-weekend/', label: '今週末のイベント' },
          ],
        },
        {
          title: '気分で',
          links: [
            { href: '/tokyo/free/', label: '無料で楽しむ' },
            { href: '/tokyo/with-kids/', label: '家族で楽しむ' },
            { href: '/tokyo/rainy-day/', label: '雨の日でもOK' },
            { href: '/tokyo/night/', label: '夜から行ける' },
          ],
        },
        {
          title: 'エリア',
          links: [
            { href: '/tokyo/shibuya/', label: '渋谷' },
            { href: '/tokyo/shinjuku/', label: '新宿' },
          ],
        },
        {
          title: 'Seekigoについて',
          links: [
            { href: '/contact/event-info/', label: '掲載・情報提供のご連絡' },
          ],
        },
      ]
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/brand/icon_seekigo.svg" />
    <link rel="apple-touch-icon" href="/brand/icon_seekigo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robotsContent && <meta name="robots" content={robotsContent} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      hreflangAlternates.map((alt) => {
        const href = toAbsolutePath(alt.path)
        return href ? (
          <link rel="alternate" hreflang={alt.lang} href={href} />
        ) : null
      })
    }
    <meta property="og:site_name" content="Seekigo" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={resolvedOgImage} />
    {
      usingDefaultOgImage && (
        <>
          <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
          <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />
    {
      jsonLd && (
        <script type="application/ld+json" is:inline set:html={jsonLd} />
      )
    }
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'en' ? 'Skip to content' : '本文へスキップ'}</a>
    <header class="site-header">
      <div class="inner site-header__bar">
        <SeekigoLogo size="header" />
        <nav
          class:list={['site-nav', hideNavOnMobile && 'site-nav--hide-sp']}
          aria-label={navLabel}
        >
          <ul class="site-nav__list">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="site-nav__link"
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          eventLanguageSwitcher && (
            <div class="site-header__lang">
              <LanguageSwitcher
                slug={eventLanguageSwitcher.slug}
                currentLocale={locale}
                enPageAvailable={eventLanguageSwitcher.enPageAvailable}
                jaPageAvailable={eventLanguageSwitcher.jaPageAvailable}
              />
            </div>
          )
        }
      </div>
    </header>

    <script is:inline>
      ;(() => {
        const h = document.querySelector('.site-header')
        if (!h) return
        const set = () =>
          document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px')
        set()
        if ('ResizeObserver' in window) new ResizeObserver(set).observe(h)
      })()
    </script>
    <div id="main-content" class="site-main">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="inner">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <SeekigoLogo size="footer" />
            <p class="site-footer__tagline">
              {locale === 'en' ? 'Find it. Go.' : '探して、行く。東京の行き先発見サービス'}
            </p>
          </div>
          {
            footerGroups.length > 0 && (
              <nav class="site-footer__nav" aria-label="フッターナビ">
                {footerGroups.map((group) => (
                  <div class="site-footer__group">
                    <p class="site-footer__heading">{group.title}</p>
                    <ul>
                      {group.links.map((link) => (
                        <li>
                          <a href={link.href}>{link.label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </nav>
            )
          }
        </div>
        <p class="site-footer__copy">© {copyrightYear} Seekigo</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ─── Design Tokens ─── */
  :root {
    --c-navy:         #0E2744;
    --c-cyan:         #00A3FF;
    --c-lime:         #A3E635;
    --c-primary:      #0070BD;   /* 白文字・リンク用（白/#F8FAFC/#E6F5FF 上で AA 4.5:1 以上） */
    --c-primary-dk:   #005A99;
    --c-primary-soft: #E6F5FF;
    --c-accent:       #A3E635;
    --c-text:         #0E2744;
    --c-muted:        #5B6472;
    --c-bg:           #F8FAFC;
    --c-white:        #FFFFFF;
    --c-border:       #E5E7EB;

    --r-sm:  6px;
    --r-md:  12px;
    --r-lg:  24px;

    --shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
    --shadow-md: 0 4px 16px rgba(0,0,0,.08);

    --font: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN',
            'Noto Sans JP', 'Yu Gothic', sans-serif;

    --max-w: 1200px;
    --px:    clamp(16px, 4vw, 40px);
  }

  /* ─── Reset ─── */
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; width: 100%; }

  body {
    font-family: var(--font);
    background: var(--c-bg);
    color: var(--c-text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .site-main { flex: 1 0 auto; }

  img { max-width: 100%; display: block; }

  a { color: var(--c-primary); text-decoration: none; }
  a:hover { color: var(--c-primary-dk); }

  :focus-visible {
    outline: 3px solid color-mix(in srgb, var(--c-cyan) 70%, transparent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  h1, h2, h3, h4 { margin: 0; line-height: 1.3; }
  p { margin: 0; }
</style>

<style>
  /* ─── Skip link ─── */
  .skip-link {
    position: absolute;
    left: 8px;
    top: -48px;
    z-index: 200;
    padding: 8px 14px;
    background: var(--c-navy);
    color: #fff !important;
    border-radius: var(--r-sm);
    font-size: 14px;
  }
  .skip-link:focus { top: 8px; }

  /* ─── Site Header ─── */
  .site-header {
    background: var(--c-white);
    border-bottom: 1px solid var(--c-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header__bar {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }
  .site-nav {
    margin-left: auto;
    min-width: 0;
  }
  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-muted);
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .site-nav__link:hover {
    color: var(--c-text);
    background: #F1F5F9;
  }
  .site-nav__link[aria-current='page'] {
    color: var(--c-primary);
    background: var(--c-primary-soft);
  }
  .site-header__lang {
    flex-shrink: 0;
  }

  /* SP: ロゴ行 + 横スクロールのカテゴリ行 */
  @media (max-width: 899px) {
    .site-header__bar {
      height: auto;
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: 10px;
    }
    .site-header__lang { margin-left: auto; }
    .site-nav {
      order: 3;
      flex: 1 0 100%;
      margin: 0 calc(var(--px) * -1);
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .site-nav::-webkit-scrollbar { display: none; }
    .site-nav--hide-sp { display: none; }
    .site-header__bar:has(.site-nav--hide-sp) {
      height: 56px;
      padding-top: 0;
    }
    .site-nav__list {
      padding: 6px var(--px) 8px;
      gap: 4px;
    }
    .site-nav__link {
      height: 32px;
      font-size: 13px;
    }
  }

  /* ─── Inner wrapper (shared) ─── */
  :global(.inner) {
    max-width: var(--max-w);
    margin: 0 auto;
    padding-left: var(--px);
    padding-right: var(--px);
  }

  /* ─── Site Footer ─── */
  .site-footer {
    margin-top: 64px;
    background: var(--c-navy);
    color: rgba(255, 255, 255, 0.78);
    padding: 48px 0 28px;
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .site-footer__brand :global(.seekigo-logo) {
    background: #fff;
    padding: 6px 12px;
    border-radius: 10px;
  }
  .site-footer__tagline {
    margin-top: 12px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 24px 48px;
  }
  .site-footer__heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    margin-bottom: 10px;
  }
  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .site-footer__group a {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.78);
  }
  .site-footer__group a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .site-footer__copy {
    padding-top: 20px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }
  @media (max-width: 899px) {
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
  }
</style>
