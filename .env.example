# Cloudflare Turnstile（公開 Site Key — ビルド時に client へ埋め込み）
PUBLIC_TURNSTILE_SITE_KEY=

# Secret Key は Astro .env ではなく Xserver 側 config/turnstile.php で管理（docs/contact-form-deploy.md 参照）

# X API (Phase 4B-2) — server-only. Never use PUBLIC_ prefix. Never commit the value.
X_BEARER_TOKEN=

# OpenAI (enrichment / reaction summary) — server-only. Never PUBLIC_. Never commit.
OPENAI_API_KEY=
# Optional override for reaction summary (default: gpt-4.1-nano)
# OPENAI_REACTION_MODEL=gpt-4.1-nano
